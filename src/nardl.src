#ifndef QARDL_SDF_INCLUDED
#include qardl.sdf
#endif

/*
**> nardl
**
**  Purpose:    Nonlinear ARDL (NARDL) levels estimation using positive and
**              negative partial-sum decompositions of each regressor.
**
**  Format:     naOut = nardl(data, ppp, qqq);
**              naOut = nardl(data, ppp, qqq, formula, print_results);
**              naOut = nardl(data, ppp, qqq, formula, print_results,
**                            decomp_vars, control_vars, q_decomp, q_control);
**              naOut = nardl(data, ppp, qqq, ..., d, thresh1, thresh2);
**
**  Input:      data      matrix or dataframe. Matrix order is [y, x1, x2, ...].
**              ppp       scalar, AR lag order.
**              qqq       scalar, distributed-lag order for partial-sum changes.
**              formula   optional Wilkinson formula, e.g. "y ~ x1 + x2".
**              decomp_vars optional string array of RHS variables to decompose.
**              control_vars optional string array of RHS variables to keep
**                           linear. Empty means complement of decomp_vars.
**              q_decomp optional alias for the decomposed-variable lag order.
**                       If omitted, qqq is used.
**              q_control optional distributed-lag order for controls.
**              d         optional partial-sum reset threshold: "inf" (default),
**                        "mean", scalar, or one value per decomposed variable.
**              thresh1   optional R-compatible alias for the first decomposed
**                        variable threshold. Overrides d[1].
**              thresh2   optional R-compatible alias for the second decomposed
**                        variable threshold. Overrides d[2].
**
**  Output:     naOut     struct nardlOut.
*/
proc (struct nardlOut) = nardl(data, ppp, qqq, formula = "", print_results = 1,
                              decomp_vars = "", control_vars = "",
                              q_decomp = -1, q_control = 0, d = "inf",
                              thresh1 = error(0), thresh2 = error(0),
                              symmetry = "none");
    local q_eff;
    struct nardlOut naOut;

    q_eff = qqq;
    if q_decomp >= 0;
        q_eff = q_decomp;
    endif;

    naOut = _nardlEstimateLevels(data, ppp, q_eff, formula, print_results,
                                 decomp_vars, control_vars, q_control,
                                 "nardl", "none", d, thresh1, thresh2,
                                 symmetry);
    retp(naOut);
endp;

/*
** Internal NARDL levels estimator shared by nardl() and nardlFull().
*/
proc (struct nardlOut) = _nardlEstimateLevels(data, ppp, q_decomp, formula,
                                             print_results, decomp_vars,
                                             control_vars, q_control, caller,
                                             selection_criterion, d, thresh1,
                                             thresh2, symmetry);
    local Y, ONEX, x_pos, x_neg, bt, denom, k0, ndecomp, ncontrol;
    local decomp_idx, control_idx, decomp_names, control_names;
    local theta_pos, theta_neg, theta_control, phi, beta_pos, beta_neg, beta_control;
    local theta_neg_start, theta_control_start, phi_start;
    local fitted, resid, coef_cov, sigma2, bigbt_cov, phi_cov, gamma_cov;
    local asym_wald, asym_pv, sr_wald, sr_pv, bounds_fstat;
    local depvar, xvars, qvec, decomp_thresholds, R_sym;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyNARDLFormula(data, formula);
    k0 = cols(data) - 1;

    { decomp_idx, control_idx, decomp_names, control_names } =
        _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars, caller);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    if ncontrol == 0;
        q_control = 0;
    endif;

    call _nardlValidateSpecInputs(data, ppp, q_decomp, q_control,
                                  decomp_idx, control_idx, caller);
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, caller);
    symmetry = _nardlNormalizeSymmetry(symmetry, caller);

    { Y, ONEX, x_pos, x_neg } =
        _nardlBuildSpecDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                              q_control, decomp_thresholds);
    call _qardlCheckFullColumnRank(ONEX, caller, "levels design matrix");

    R_sym = _nardlSymRestrLvl(ppp, q_decomp, ndecomp, ncontrol,
                              q_control, symmetry);
    { bt, fitted, resid, coef_cov, sigma2 } =
        _nardlRestrictedOLS(Y, ONEX, R_sym, caller, "levels");

    theta_neg_start = 2 + ndecomp;
    theta_control_start = 2 + 2*ndecomp;
    phi_start = theta_control_start + ncontrol;

    theta_pos = bt[2:1+ndecomp];
    theta_neg = bt[theta_neg_start:theta_neg_start+ndecomp-1];
    if ncontrol > 0;
        theta_control = bt[theta_control_start:theta_control_start+ncontrol-1];
    else;
        theta_control = error(0);
    endif;
    phi = bt[phi_start:phi_start+ppp-1];
    denom = 1 - sumc(phi);

    beta_pos = theta_pos ./ denom;
    beta_neg = theta_neg ./ denom;
    if ncontrol > 0;
        beta_control = theta_control ./ denom;
    else;
        beta_control = error(0);
    endif;

    bigbt_cov = _nardlLongRunSpecCov(bt, coef_cov, ppp, ndecomp, ncontrol);
    phi_cov = coef_cov[phi_start:phi_start+ppp-1, phi_start:phi_start+ppp-1];
    gamma_cov = coef_cov[2:phi_start-1, 2:phi_start-1];
    { asym_wald, asym_pv } = _nardlLongRunAsymmetry(beta_pos, beta_neg, bigbt_cov);
    { sr_wald, sr_pv } = _nardlShortRunAsymmetrySpec(bt, coef_cov, ppp,
                                                     q_decomp, ndecomp, ncontrol);
    bounds_fstat = _nardlBoundsFstatForSelectors(data, ppp, q_decomp,
                                                 decomp_idx, control_idx,
                                                 q_control, decomp_thresholds,
                                                 caller);
    qvec = _nardlQVecForSelectors(k0, decomp_idx, control_idx, q_decomp,
                                  q_control);

    struct nardlOut naOut;
    naOut.model_family = "NARDL";
    naOut.formula = formula;
    naOut.depvar = depvar;
    naOut.xvars = xvars;
    naOut.decomp_vars = decomp_names;
    naOut.control_vars = control_names;
    naOut.deterministic = "constant";
    naOut.covariance_type = "ols";
    naOut.selection_criterion = selection_criterion;
    naOut.ecm_type = "none";
    naOut.symmetry_restriction = symmetry;
    naOut.sample_start = 1;
    naOut.sample_end = rows(data);
    naOut.estimation_start = rows(data) - rows(Y) + 1;
    naOut.estimation_end = rows(data);
    naOut.p = ppp;
    naOut.q = q_decomp;
    naOut.q_control = q_control;
    naOut.qvec = qvec;
    if ncontrol > 0;
        naOut.control_qvec = q_control*ones(ncontrol, 1);
    else;
        naOut.control_qvec = error(0);
    endif;
    naOut.nobs = rows(Y);
    naOut.k = k0;
    naOut.ndecomp = ndecomp;
    naOut.ncontrol = ncontrol;
    naOut.decomp_indices = decomp_idx;
    naOut.control_indices = control_idx;
    naOut.decomp_thresholds = decomp_thresholds;
    naOut.design_rank = rank(ONEX);
    naOut.design_cols = cols(ONEX);
    naOut.design_condition = sqrt(_qardlConditionNumber(ONEX'ONEX));
    if ncontrol > 0;
        naOut.bigbt = beta_pos | beta_neg | beta_control;
    else;
        naOut.bigbt = beta_pos | beta_neg;
    endif;
    naOut.bigbt_cov = bigbt_cov;
    naOut.phi = phi;
    naOut.phi_cov = phi_cov;
    naOut.gamma = theta_pos | theta_neg;
    if ncontrol > 0;
        naOut.gamma = naOut.gamma | theta_control;
    endif;
    naOut.gamma_cov = gamma_cov;
    naOut.alpha = bt[1];
    naOut.rho = -(1 - sumc(phi));
    naOut.bt = bt;
    naOut.beta_pos = beta_pos;
    naOut.beta_neg = beta_neg;
    naOut.beta_control = beta_control;
    naOut.theta_pos = theta_pos;
    naOut.theta_neg = theta_neg;
    naOut.theta_control = theta_control;
    naOut.asymmetry_wald = asym_wald;
    naOut.asymmetry_pv = asym_pv;
    naOut.short_run_wald = sr_wald;
    naOut.short_run_pv = sr_pv;
    naOut.bounds_fstat = bounds_fstat;
    naOut.fitted = fitted;
    naOut.resid = resid;
    naOut.sigma2 = sigma2;
    naOut.coef_cov = coef_cov;

    if print_results;
        call printNARDL(naOut);
    endif;

    retp(naOut);
endp;

/*
**> nardlECM
**
**  Purpose:    NARDL-ECM estimation.  The default two-step estimator uses
**              levels NARDL estimates to provide beta_pos and beta_neg, then
**              includes the lagged error-correction term, lagged Dy terms,
**              and positive and negative partial-sum change terms. Set
**              ecm_type = "uecm" to estimate the unrestricted ECM directly.
*/
proc (struct nardlECMOut) = nardlECM(data, ppp, qqq, formula = "",
                                    print_results = 1, decomp_vars = "",
                                    control_vars = "", q_decomp = -1,
                                    q_control = 0, ecm_type = "two-step",
                                    case_id = 3, d = "inf",
                                    thresh1 = error(0), thresh2 = error(0),
                                    symmetry = "none");
    local q_eff;
    struct nardlECMOut nECMOut;

    q_eff = qqq;
    if q_decomp >= 0;
        q_eff = q_decomp;
    endif;

    nECMOut = _nardlEstimateECM(data, ppp, q_eff, formula, print_results,
                                decomp_vars, control_vars, q_control,
                                "nardlECM", "none", ecm_type, case_id,
                                d, thresh1, thresh2, symmetry);
    retp(nECMOut);
endp;

/*
** Internal NARDL-ECM estimator shared by nardlECM() and nardlFull().
*/
proc (struct nardlECMOut) = _nardlEstimateECM(data, ppp, q_decomp, formula,
                                             print_results, decomp_vars,
                                             control_vars, q_control, caller,
                                             selection_criterion, ecm_type,
                                             case_id, d, thresh1, thresh2,
                                             symmetry);
    local Y_ecm, ONEX_ecm, bt_ecm, fitted, resid, coef_cov, sigma2;
    local depvar, xvars, decomp_idx, control_idx, decomp_names, control_names;
    local raw_data;
    local ndecomp, ncontrol, pos_start, neg_start, ctrl_start, lr_cov;
    local beta_pos_ecm, beta_neg_ecm, beta_control_ecm, asym_wald_ecm, asym_pv_ecm;
    local det_cols, rho_pos, decomp_thresholds, R_sym;

    raw_data = data;
    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyNARDLFormula(data, formula);
    { decomp_idx, control_idx, decomp_names, control_names } =
        _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars, caller);
    if _nardlIndexCount(control_idx) == 0;
        q_control = 0;
    endif;
    ecm_type = _ardlNormalizeECMType(ecm_type, caller, 0);
    symmetry = _nardlNormalizeSymmetry(symmetry, caller);
    call _ardlValidateCaseID(case_id, caller);
    call _ardlValidateECMCase(ecm_type, case_id, caller);
    call _nardlValidateSpecInputs(data, ppp, q_decomp, q_control,
                                  decomp_idx, control_idx, caller);
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, caller);

    struct nardlOut naOut;
    naOut = _nardlEstimateLevels(raw_data, ppp, q_decomp, formula, 0,
                                 decomp_vars, control_vars, q_control,
                                 caller, selection_criterion, d, thresh1,
                                 thresh2, symmetry);

    if ecm_type $== "uecm";
        { Y_ecm, ONEX_ecm } =
            _nardlBuildSpecUECMDesign(data, ppp, q_decomp, decomp_idx,
                                      control_idx, q_control, case_id,
                                      decomp_thresholds);
    else;
        { Y_ecm, ONEX_ecm } =
            _nardlBuildSpecECMDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                                     q_control, naOut.beta_pos, naOut.beta_neg,
                                     naOut.beta_control, decomp_thresholds,
                                     case_id);
    endif;
    call _qardlCheckFullColumnRank(ONEX_ecm, caller, "ECM design matrix");

    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    det_cols = _ardlDeterministicColumnCount(case_id);
    rho_pos = det_cols + 1;
    if ecm_type $== "uecm";
        R_sym = _nardlSymRestrUECM(ppp, q_decomp, ndecomp, ncontrol,
                                   q_control, case_id, symmetry);
    else;
        R_sym = _nardlSymRestrECM(ppp, q_decomp, ndecomp, ncontrol,
                                  q_control, case_id, symmetry);
    endif;
    { bt_ecm, fitted, resid, coef_cov, sigma2 } =
        _nardlRestrictedOLS(Y_ecm, ONEX_ecm, R_sym, caller, "ECM");

    if ecm_type $== "uecm";
        pos_start = rho_pos + 1;
        neg_start = pos_start + ndecomp;
        ctrl_start = neg_start + ndecomp;
        beta_pos_ecm = -bt_ecm[pos_start:pos_start+ndecomp-1] ./ bt_ecm[rho_pos];
        beta_neg_ecm = -bt_ecm[neg_start:neg_start+ndecomp-1] ./ bt_ecm[rho_pos];
        if ncontrol > 0;
            beta_control_ecm = -bt_ecm[ctrl_start:ctrl_start+ncontrol-1] ./ bt_ecm[rho_pos];
        else;
            beta_control_ecm = error(0);
        endif;
        lr_cov = _ardlUECMLongRunCov(bt_ecm, coef_cov, rho_pos, pos_start,
                                     2*ndecomp+ncontrol);
        { asym_wald_ecm, asym_pv_ecm } =
            _nardlLongRunAsymmetry(beta_pos_ecm, beta_neg_ecm, lr_cov);
    else;
        beta_pos_ecm = naOut.beta_pos;
        beta_neg_ecm = naOut.beta_neg;
        beta_control_ecm = naOut.beta_control;
        asym_wald_ecm = naOut.asymmetry_wald;
        asym_pv_ecm = naOut.asymmetry_pv;
    endif;

    struct nardlECMOut nECMOut;
    nECMOut.model_family = "NARDL-ECM";
    nECMOut.formula = formula;
    nECMOut.depvar = depvar;
    nECMOut.xvars = xvars;
    nECMOut.decomp_vars = decomp_names;
    nECMOut.control_vars = control_names;
    nECMOut.deterministic = _ardlDeterministicLabel(case_id);
    nECMOut.covariance_type = "ols";
    nECMOut.selection_criterion = selection_criterion;
    nECMOut.ecm_type = ecm_type;
    nECMOut.symmetry_restriction = symmetry;
    nECMOut.sample_start = 1;
    nECMOut.sample_end = rows(data);
    nECMOut.estimation_start = rows(data) - rows(Y_ecm) + 1;
    nECMOut.estimation_end = rows(data);
    nECMOut.p = ppp;
    nECMOut.q = q_decomp;
    nECMOut.q_control = q_control;
    nECMOut.qvec = naOut.qvec;
    nECMOut.control_qvec = naOut.control_qvec;
    nECMOut.nobs = rows(Y_ecm);
    nECMOut.k = naOut.k;
    nECMOut.ndecomp = naOut.ndecomp;
    nECMOut.ncontrol = naOut.ncontrol;
    nECMOut.decomp_indices = naOut.decomp_indices;
    nECMOut.control_indices = naOut.control_indices;
    nECMOut.decomp_thresholds = decomp_thresholds;
    nECMOut.design_rank = rank(ONEX_ecm);
    nECMOut.design_cols = cols(ONEX_ecm);
    nECMOut.design_condition = sqrt(_qardlConditionNumber(ONEX_ecm'ONEX_ecm));
    nECMOut.beta_pos = beta_pos_ecm;
    nECMOut.beta_neg = beta_neg_ecm;
    nECMOut.beta_control = beta_control_ecm;
    nECMOut.rho_ols = naOut.rho;
    if det_cols >= 1;
        nECMOut.alpha = bt_ecm[1];
        nECMOut.alpha_cov = coef_cov[1, 1];
    else;
        nECMOut.alpha = 0;
        nECMOut.alpha_cov = 0;
    endif;
    nECMOut.rho = bt_ecm[rho_pos];
    nECMOut.rho_cov = coef_cov[rho_pos, rho_pos];
    nECMOut.bt = bt_ecm;
    nECMOut.asymmetry_wald = asym_wald_ecm;
    nECMOut.asymmetry_pv = asym_pv_ecm;
    nECMOut.coef_cov = coef_cov;
    nECMOut.fitted = fitted;
    nECMOut.resid = resid;
    nECMOut.sigma2 = sigma2;

    if print_results;
        call printNARDLECM(nECMOut);
    endif;

    retp(nECMOut);
endp;

/*
**> nardlFull
**
**  Purpose:    Integrated NARDL workflow with lag selection followed by
**              levels and ECM estimation.
**
**  Format:     nfOut = nardlFull(data);
**              nfOut = nardlFull(data, pend, qend, formula, verbose, criterion,
**                                decomp_vars, control_vars, q_control,
**                                ecm_type, gets_pval, case_id, d,
**                                thresh1, thresh2, symmetry);
**
**  Note:       If omitted, pend and qend default to 8.
*/
proc (struct nardlFullOut) = nardlFull(data, pend = 8, qend = 8, formula = "",
                                      verbose = 1, criterion = "bic",
                                      decomp_vars = "", control_vars = "",
                                      q_control = 0, ecm_type = "two-step",
                                      gets_pval = 0.1, case_id = 3,
                                      d = "inf", thresh1 = error(0),
                                      thresh2 = error(0),
                                      symmetry = "none");
    local pst, qst, depvar, xvars, raw_data, grid, idx;
    local decomp_idx, control_idx, decomp_names, control_names;
    local decomp_thresholds;

    call _qardlValidateLagScalar(pend, "nardlFull: pend");
    call _qardlValidateLagScalarZero(qend, "nardlFull: qend");
    call _qardlValidateLagScalarZero(q_control, "nardlFull: q_control");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "nardlFull");
    call _qardlValidateGETSPValue(gets_pval, "nardlFull");
    ecm_type = _ardlNormalizeECMType(ecm_type, "nardlFull", 0);
    symmetry = _nardlNormalizeSymmetry(symmetry, "nardlFull");
    call _ardlValidateCaseID(case_id, "nardlFull");
    call _ardlValidateECMCase(ecm_type, case_id, "nardlFull");

    raw_data = data;
    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyNARDLFormula(data, formula);
    { decomp_idx, control_idx, decomp_names, control_names } =
        _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars, "nardlFull");
    if _nardlIndexCount(control_idx) == 0;
        q_control = 0;
    endif;
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlFull");
    if _qardlCriterionIsGETS(criterion);
        { pst, qst } = _nardlGETSOrderSpec(data, 1, pend, 0, qend,
                                           decomp_idx, control_idx,
                                           q_control, gets_pval,
                                           decomp_thresholds, "nardlFull");
    else;
        grid = _nardlOrderGridSpec(data, pend, qend, criterion, decomp_idx,
                                   control_idx, q_control, decomp_thresholds,
                                   "nardlFull");
        idx = minindc(grid[., 3]);
        pst = grid[idx, 1];
        qst = grid[idx, 2];
    endif;

    if verbose;
        sprintf("nardlFull: %s-selected p = %d, q = %d", upper(criterion), pst, qst);
    endif;

    struct nardlFullOut nfOut;
    nfOut.model_family = "NARDL";
    nfOut.formula = formula;
    nfOut.depvar = depvar;
    nfOut.xvars = xvars;
    nfOut.deterministic = _ardlDeterministicLabel(case_id);
    nfOut.covariance_type = "ols";
    nfOut.selection_criterion = criterion;
    nfOut.pmax = pend;
    nfOut.qmax = qend;
    nfOut.sample_start = 1;
    nfOut.sample_end = rows(data);
    nfOut.pst = pst;
    nfOut.qst = qst;
    nfOut.nobs = rows(data);
    nfOut.decomp_thresholds = decomp_thresholds;
    nfOut.na = _nardlEstimateLevels(raw_data, pst, qst, formula, 0,
                                    decomp_vars, control_vars, q_control,
                                    "nardlFull", criterion, d, thresh1,
                                    thresh2, symmetry);
    nfOut.ecm = _nardlEstimateECM(raw_data, pst, qst, formula, 0,
                                  decomp_vars, control_vars, q_control,
                                  "nardlFull", criterion, ecm_type, case_id,
                                  d, thresh1, thresh2, symmetry);

    if verbose;
        call printNARDL(nfOut.na);
        call printNARDLECM(nfOut.ecm);
    endif;

    retp(nfOut);
endp;

/*
**> nardlAutoCase
**
**  Purpose:    Select NARDL lag orders by hierarchical GETS, infer the
**              admissible Pesaran-Shin-Smith deterministic case set from a
**              Case V NARDL UECM, and report case-specific bounds rows.
*/
proc (struct nardlAutoCaseOut) = nardlAutoCase(data, pend = 8, qend = 8,
                                               formula = "", verbose = 1,
                                               decomp_vars = "",
                                               control_vars = "",
                                               q_control = 0,
                                               gets_pval = 0.1,
                                               d = "inf",
                                               thresh1 = error(0),
                                               thresh2 = error(0),
                                               gets_mode = "hierarchical");
    local pst, qst, depvar, xvars, raw_data, decomp_idx, control_idx;
    local decomp_names, control_names, decomp_thresholds, case_ids;
    local primary_case, det_coef, det_pv, bounds_table;
    local sparse_keep_cols, sparse_bt, sparse_coef_cov, sparse_fitted;
    local sparse_resid, sparse_sigma2, selection_criterion;

    if verbose /= 0 and verbose /= 1;
        errorlog "nardlAutoCase: verbose must be 0 or 1";
        end;
    endif;

    raw_data = data;
    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyNARDLFormula(data, formula);
    call _qardlValidateLagScalar(pend, "nardlAutoCase: pend");
    call _qardlValidateLagScalarZero(qend, "nardlAutoCase: qend");
    call _qardlValidateLagScalarZero(q_control, "nardlAutoCase: q_control");
    call _qardlValidateGETSPValue(gets_pval, "nardlAutoCase");
    gets_mode = _ardlNormalizeGETSMode(gets_mode, "nardlAutoCase");
    { decomp_idx, control_idx, decomp_names, control_names } =
        _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars,
                                   "nardlAutoCase");
    if _nardlIndexCount(control_idx) == 0;
        q_control = 0;
    endif;
    call _nardlValidateSpecInputs(data, pend, qend, q_control,
                                  decomp_idx, control_idx, "nardlAutoCase");
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlAutoCase");

    if gets_mode $== "sparse";
        pst = pend;
        qst = qend;
        { case_ids, det_coef, det_pv, sparse_keep_cols, sparse_bt,
          sparse_coef_cov, sparse_fitted, sparse_resid, sparse_sigma2 } =
            _nardlSparseAutoCases(data, pst, qst, decomp_idx, control_idx,
                                  q_control, decomp_thresholds, gets_pval,
                                  "nardlAutoCase");
    else;
        { pst, qst } = _nardlGETSOrderSpec(data, 1, pend, 0, qend,
                                           decomp_idx, control_idx, q_control,
                                           gets_pval, decomp_thresholds,
                                           "nardlAutoCase");
        { case_ids, det_coef, det_pv } =
            _nardlAutoCases(data, pst, qst, decomp_idx, control_idx, q_control,
                            decomp_thresholds, gets_pval, "nardlAutoCase");
        sparse_keep_cols = error(0);
        sparse_bt = error(0);
        sparse_coef_cov = error(0);
        sparse_fitted = error(0);
        sparse_resid = error(0);
        sparse_sigma2 = 0;
    endif;
    primary_case = case_ids[rows(case_ids)];
    bounds_table = _nardlAutoBoundsTable(data, pst, qst, decomp_idx,
                                         control_idx, q_control,
                                         decomp_thresholds, case_ids,
                                         "nardlAutoCase");
    selection_criterion = "gets";
    if gets_mode $== "sparse";
        selection_criterion = "gets-sparse";
    endif;

    if verbose;
        call _ardlPrintAutoCase("nardlAutoCase", pst, qst, case_ids,
                                det_pv, bounds_table);
    endif;

    struct nardlAutoCaseOut acOut;
    acOut.model_family = "NARDL-AutoCase";
    acOut.formula = formula;
    acOut.depvar = depvar;
    acOut.xvars = xvars;
    acOut.decomp_vars = decomp_names;
    acOut.control_vars = control_names;
    acOut.deterministic = _ardlDeterministicLabel(primary_case);
    acOut.covariance_type = "ols";
    acOut.selection_criterion = selection_criterion;
    acOut.gets_mode = gets_mode;
    acOut.pmax = pend;
    acOut.qmax = qend;
    acOut.pst = pst;
    acOut.qst = qst;
    acOut.q_control = q_control;
    acOut.gets_pval = gets_pval;
    acOut.sample_start = 1;
    acOut.sample_end = rows(data);
    acOut.nobs = rows(data);
    acOut.ndecomp = rows(decomp_idx);
    acOut.ncontrol = _nardlIndexCount(control_idx);
    acOut.decomp_indices = decomp_idx;
    acOut.control_indices = control_idx;
    acOut.decomp_thresholds = decomp_thresholds;
    acOut.primary_case = primary_case;
    acOut.case_count = rows(case_ids);
    acOut.case_ids = case_ids;
    acOut.deterministic_coef = det_coef;
    acOut.deterministic_pv = det_pv;
    acOut.sparse_keep_cols = sparse_keep_cols;
    acOut.sparse_bt = sparse_bt;
    acOut.sparse_coef_cov = sparse_coef_cov;
    acOut.sparse_fitted = sparse_fitted;
    acOut.sparse_resid = sparse_resid;
    acOut.sparse_sigma2 = sparse_sigma2;
    acOut.bounds_table = bounds_table;
    acOut.na = _nardlEstimateLevels(raw_data, pst, qst, formula, 0,
                                    decomp_vars, control_vars, q_control,
                                    "nardlAutoCase", selection_criterion, d,
                                    thresh1, thresh2, "none");
    acOut.ecm = _nardlEstimateECM(raw_data, pst, qst, formula, 0,
                                  decomp_vars, control_vars, q_control,
                                  "nardlAutoCase", selection_criterion, "uecm",
                                  primary_case, d, thresh1, thresh2, "none");

    retp(acOut);
endp;

/*
**> nardlSparseGETS
**
**  Purpose:    Run standalone sparse general-to-specific reduction on the
**              Case V NARDL unrestricted ECM. Lagged level terms are protected;
**              deterministic and short-run difference terms are eligible for
**              deletion by coefficient p-value.
*/
proc (struct ardlSparseGETSOut) = nardlSparseGETS(data, ppp, q_decomp,
                                                  formula = "",
                                                  decomp_vars = "",
                                                  control_vars = "",
                                                  q_control = 0,
                                                  gets_pval = 0.1,
                                                  d = "inf",
                                                  thresh1 = error(0),
                                                  thresh2 = error(0),
                                                  print_results = 1);
    local depvar, xvars, decomp_idx, control_idx, decomp_names, control_names;
    local decomp_thresholds, Y, XU, ndecomp, ncontrol, level_count;
    local protect_cols, keep, bt, coef_cov, fitted, resid, sigma2;
    local det_coef, det_pv, case_ids, labels, idx, Xk, max_lag;
    struct ardlSparseGETSOut spOut;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyNARDLFormula(data, formula);
    call _qardlValidateLagScalar(ppp, "nardlSparseGETS: ppp");
    call _qardlValidateLagScalarZero(q_decomp, "nardlSparseGETS: q_decomp");
    call _qardlValidateLagScalarZero(q_control, "nardlSparseGETS: q_control");
    call _qardlValidateGETSPValue(gets_pval, "nardlSparseGETS");
    { decomp_idx, control_idx, decomp_names, control_names } =
        _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars,
                                   "nardlSparseGETS");
    if _nardlIndexCount(control_idx) == 0;
        q_control = 0;
    endif;
    call _nardlValidateSpecInputs(data, ppp, q_decomp, q_control,
                                  decomp_idx, control_idx,
                                  "nardlSparseGETS");
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlSparseGETS");

    { Y, XU } = _nardlBuildSpecUECMDesign(data, ppp, q_decomp,
                                          decomp_idx, control_idx, q_control,
                                          5, decomp_thresholds);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    level_count = 1 + 2*ndecomp + ncontrol;
    protect_cols = seqa(3, 1, level_count);
    { keep, bt, coef_cov, fitted, resid, sigma2 } =
        _qardlSparseGETS(Y, XU, protect_cols, gets_pval, "nardlSparseGETS");

    det_coef = bt[1:2];
    det_pv = _ardlDetPValues(bt, coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);
    labels = _nardlSparseGETSLabels(decomp_names, control_names, ppp,
                                    q_decomp, q_control, ncontrol);
    idx = _qardlMaskIndices(keep);
    Xk = XU[., idx];
    max_lag = maxc(ppp|q_decomp|q_control);

    spOut.model_family = "NARDL-SparseGETS";
    spOut.formula = formula;
    spOut.depvar = depvar;
    spOut.xvars = xvars;
    spOut.decomp_vars = decomp_names;
    spOut.control_vars = control_names;
    spOut.deterministic = "case V: unrestricted intercept, unrestricted trend";
    spOut.covariance_type = "ols";
    spOut.selection_criterion = "gets-sparse";
    spOut.p = ppp;
    spOut.q = q_decomp;
    spOut.q_control = q_control;
    spOut.gets_pval = gets_pval;
    spOut.case_id = 5;
    spOut.primary_case = case_ids[rows(case_ids)];
    spOut.case_count = rows(case_ids);
    spOut.case_ids = case_ids;
    spOut.sample_start = 1;
    spOut.sample_end = rows(data);
    spOut.estimation_start = max_lag + 2;
    spOut.estimation_end = rows(data);
    spOut.nobs = rows(Y);
    spOut.k = cols(data) - 1;
    spOut.ndecomp = ndecomp;
    spOut.ncontrol = ncontrol;
    spOut.decomp_indices = decomp_idx;
    spOut.control_indices = control_idx;
    spOut.decomp_thresholds = decomp_thresholds;
    spOut.design_rank = rank(Xk);
    spOut.design_cols = cols(Xk);
    spOut.design_condition = sqrt(_qardlConditionNumber(Xk'Xk));
    spOut.term_labels = labels;
    spOut.keep_cols = keep;
    spOut.dropped_cols = _qardlDroppedCols(keep);
    spOut.n_kept = sumc(keep);
    spOut.n_dropped = sumc(keep .== 0);
    spOut.deterministic_coef = det_coef;
    spOut.deterministic_pv = det_pv;
    spOut.bt = bt;
    spOut.coef_cov = coef_cov;
    spOut.fitted = fitted;
    spOut.resid = resid;
    spOut.sigma2 = sigma2;

    if print_results;
        call printARDLSparseGETS(spOut);
    endif;

    retp(spOut);
endp;

/*
**> nardlOrder
**
**  Purpose:    Select scalar NARDL p and q orders by IC or GETS.
*/
proc (2) = nardlOrder(data, pend = 8, qend = 8, criterion = "bic",
                      gets_pval = 0.1, d = "inf",
                      thresh1 = error(0), thresh2 = error(0));
    local grid, idx, decomp_idx, control_idx, pst, qst, decomp_thresholds;

    call _qardlValidateLagScalar(pend, "nardlOrder: pend");
    call _qardlValidateLagScalarZero(qend, "nardlOrder: qend");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "nardlOrder");
    call _qardlValidateGETSPValue(gets_pval, "nardlOrder");
    decomp_idx = seqa(1, 1, cols(data) - 1);
    control_idx = error(0);
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlOrder");

    if _qardlCriterionIsGETS(criterion);
        { pst, qst } = _nardlGETSOrderSpec(data, 1, pend, 0, qend,
                                           decomp_idx, control_idx, 0,
                                           gets_pval, decomp_thresholds,
                                           "nardlOrder");
        retp(pst, qst);
    endif;

    grid = nardlOrderGrid(data, pend, qend, criterion, d, thresh1, thresh2);
    idx = minindc(grid[., 3]);

    retp(grid[idx, 1], grid[idx, 2]);
endp;

/*
**> nardlOrderGrid
**
**  Purpose:    Return the full NARDL p/q information-criterion table.
*/
proc (1) = nardlOrderGrid(data, pend = 8, qend = 8, criterion = "bic",
                          d = "inf", thresh1 = error(0),
                          thresh2 = error(0));
    local p, q, grid, row, ic, decomp_idx, decomp_thresholds;

    call _qardlValidateLagScalar(pend, "nardlOrderGrid: pend");
    call _qardlValidateLagScalarZero(qend, "nardlOrderGrid: qend");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "nardlOrderGrid");
    decomp_idx = seqa(1, 1, cols(data) - 1);
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlOrderGrid");

    grid = zeros(pend*(qend+1), 3);
    row = 1;
    p = 1;
    do until p > pend;
        q = 0;
        do until q > qend;
            ic = _nardlICMeanUnchecked(data, p, q, criterion,
                                       decomp_thresholds, "nardlOrderGrid");
            grid[row, .] = p~q~ic;
            row = row + 1;
            q = q + 1;
        endo;
        p = p + 1;
    endo;

    retp(grid);
endp;

proc (1) = _nardlOrderGridSpec(data, pend, qend, criterion, decomp_idx,
                               control_idx, q_control, decomp_thresholds,
                               caller);
    local p, q, grid, row, ic;

    call _qardlValidateLagScalar(pend, caller $+ ": pend");
    call _qardlValidateLagScalarZero(qend, caller $+ ": qend");
    call _qardlValidateLagScalarZero(q_control, caller $+ ": q_control");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, caller);

    grid = zeros(pend*(qend+1), 3);
    row = 1;
    p = 1;
    do until p > pend;
        q = 0;
        do until q > qend;
            ic = _nardlICMeanSpecUnchecked(data, p, q, q_control,
                                           decomp_idx, control_idx,
                                           criterion, decomp_thresholds,
                                           caller);
            grid[row, .] = p~q~ic;
            row = row + 1;
            q = q + 1;
        endo;
        p = p + 1;
    endo;

    retp(grid);
endp;

proc (2) = _nardlGETSOrderSpec(data, pstart, pend, qstart, qend, decomp_idx,
                               control_idx, q_control, gets_pval,
                               decomp_thresholds, caller);
    local pst, qst, p_pv, q_pv;

    call _nardlValidateSpecInputs(data, pend, qend, q_control, decomp_idx,
                                  control_idx, caller);

    pst = pend;
    qst = qend;

    do while 1;
        p_pv = -1;
        q_pv = -1;

        if pst > pstart;
            p_pv = _nardlGETSBoundaryPValue(data, pst, qst, decomp_idx,
                                            control_idx, q_control,
                                            decomp_thresholds, 1, caller);
        endif;
        if qst > qstart;
            q_pv = _nardlGETSBoundaryPValue(data, pst, qst, decomp_idx,
                                            control_idx, q_control,
                                            decomp_thresholds, 0, caller);
        endif;

        if p_pv <= gets_pval and q_pv <= gets_pval;
            break;
        endif;

        if p_pv >= q_pv and p_pv > gets_pval;
            pst = pst - 1;
        elseif q_pv > gets_pval;
            qst = qst - 1;
        else;
            break;
        endif;
    endo;

    retp(pst, qst);
endp;

proc (1) = _nardlGETSBoundaryPValue(data, ppp, q_decomp, decomp_idx,
                                    control_idx, q_control, decomp_thresholds,
                                    is_p_lag, caller);
    local Y, ONEX, x_pos, x_neg, ndecomp, ncontrol, y_start;
    local dx_pos_start, dx_neg_start, test_cols, ii;

    { Y, ONEX, x_pos, x_neg } =
        _nardlBuildSpecDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                              q_control, decomp_thresholds);

    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    y_start = 2 + 2*ndecomp + ncontrol;

    if is_p_lag;
        test_cols = y_start + ppp - 1;
    else;
        dx_pos_start = y_start + ppp;
        dx_neg_start = dx_pos_start + q_decomp*ndecomp;
        test_cols = zeros(2*ndecomp, 1);
        ii = 1;
        do until ii > ndecomp;
            test_cols[ii] = dx_pos_start + (ii - 1)*q_decomp + q_decomp - 1;
            test_cols[ndecomp + ii] =
                dx_neg_start + (ii - 1)*q_decomp + q_decomp - 1;
            ii = ii + 1;
        endo;
    endif;

    retp(_qardlGETSWaldPValue(Y, ONEX, test_cols, caller));
endp;

/*
**> nardlICMean
**
**  Purpose:    Compute AIC/BIC/HQ/HQC for a specified NARDL lag order.
*/
proc (1) = nardlICMean(data, ppp, qqq, criterion = "bic", d = "inf",
                       thresh1 = error(0), thresh2 = error(0));
    local decomp_idx, decomp_thresholds;
    call _nardlValidateEstimatorInputs(data, ppp, qqq, "nardlICMean");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "nardlICMean");
    decomp_idx = seqa(1, 1, cols(data) - 1);
    decomp_thresholds = _nardlResolveThresh(data, decomp_idx, d, thresh1,
                                            thresh2, "nardlICMean");

    retp(_nardlICMeanUnchecked(data, ppp, qqq, criterion,
                               decomp_thresholds, "nardlICMean"));
endp;

proc (1) = _nardlICMeanUnchecked(data, ppp, qqq, criterion,
                                 decomp_thresholds, caller);
    local Y, ONEX, x_pos, x_neg, bt, resid, N, K, s2, ic;

    { Y, ONEX, x_pos, x_neg } =
        _nardlBuildDesign(data, ppp, qqq, decomp_thresholds);
    call _qardlCheckFullColumnRank(ONEX, caller, "levels design matrix");

    bt = _qardlSafeInv(ONEX'*ONEX, caller, "levels moment matrix")*ONEX'*Y;
    resid = Y - ONEX*bt;
    N = rows(Y);
    K = cols(ONEX);
    s2 = (resid'*resid) / N;

    if criterion $== "aic";
        ic = ln(s2) + 2*K/N;
    elseif criterion $== "hq" or criterion $== "hqc";
        ic = ln(s2) + 2*K*ln(ln(N))/N;
    else;
        ic = ln(s2) + K*ln(N)/N;
    endif;

    retp(ic);
endp;

proc (1) = _nardlICMeanSpecUnchecked(data, ppp, q_decomp, q_control,
                                     decomp_idx, control_idx, criterion,
                                     decomp_thresholds, caller);
    local Y, ONEX, x_pos, x_neg, bt, resid, N, K, s2, ic;

    call _nardlValidateSpecInputs(data, ppp, q_decomp, q_control,
                                  decomp_idx, control_idx, caller);

    { Y, ONEX, x_pos, x_neg } =
        _nardlBuildSpecDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                              q_control, decomp_thresholds);
    call _qardlCheckFullColumnRank(ONEX, caller, "levels design matrix");

    bt = _qardlSafeInv(ONEX'*ONEX, caller, "levels moment matrix")*ONEX'*Y;
    resid = Y - ONEX*bt;
    N = rows(Y);
    K = cols(ONEX);
    s2 = (resid'*resid) / N;

    if criterion $== "aic";
        ic = ln(s2) + 2*K/N;
    elseif criterion $== "hq" or criterion $== "hqc";
        ic = ln(s2) + 2*K*ln(ln(N))/N;
    else;
        ic = ln(s2) + K*ln(N)/N;
    endif;

    retp(ic);
endp;

/*
**> printNARDL
**
**  Purpose:    Print formatted NARDL levels output.
*/
proc (0) = printNARDL(struct nardlOut naOut);
    local ii, se_beta, se_phi, z_beta, z_phi, pv_beta, pv_phi;
    local header, asym_header, note, table_width, eq_line, dash_line, name;
    local ndecomp, ncontrol;

    se_beta = sqrt(diag(naOut.bigbt_cov));
    se_phi = sqrt(diag(naOut.phi_cov));
    z_beta = naOut.bigbt ./ se_beta;
    z_phi = naOut.phi ./ se_phi;
    pv_beta = 2*cdfnc(abs(z_beta));
    pv_phi = 2*cdfnc(abs(z_phi));
    ndecomp = rows(naOut.beta_pos);
    ncontrol = naOut.ncontrol;

    header = "Name                          Coeff.     Std. Err.       z-value        P>|z|  Sig.";
    asym_header = "Name                       statistic       p-value  Sig.";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|strlen(asym_header)|84|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    print "NARDL Levels Estimator";
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", naOut.nobs,
            "No. regressors:", naOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "Decomposed vars:", ndecomp,
            "Controls:", ncontrol);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", naOut.p,
            "DL lags (q):", naOut.q);
    if ncontrol > 0;
        sprintf("%-26s%12.0f", "Control DL lags:", naOut.q_control);
    endif;
    if _nardlUsesThresh(naOut.decomp_thresholds);
        print "Partial-sum reset thresholds:";
        ii = 1;
        do until ii > ndecomp;
            sprintf("  %-24s%12.6f", naOut.decomp_vars[ii],
                    naOut.decomp_thresholds[ii]);
            ii = ii + 1;
        endo;
    endif;
    sprintf("%-26s%12.4f", "Bounds F-stat:", naOut.bounds_fstat);
    print "Covariance: " $+ naOut.covariance_type;
    print dash_line;
    print header;
    print dash_line;

    ii = 1;
    do until ii > ndecomp;
        name = "  beta_pos_" $+ naOut.decomp_vars[ii];
        sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
                name, naOut.beta_pos[ii], se_beta[ii], z_beta[ii], pv_beta[ii],
                _qardlSignifStars(pv_beta[ii]));
        ii = ii + 1;
    endo;

    ii = 1;
    do until ii > ndecomp;
        name = "  beta_neg_" $+ naOut.decomp_vars[ii];
        sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
                name, naOut.beta_neg[ii], se_beta[ndecomp+ii],
                z_beta[ndecomp+ii], pv_beta[ndecomp+ii],
                _qardlSignifStars(pv_beta[ndecomp+ii]));
        ii = ii + 1;
    endo;

    if ncontrol > 0;
        ii = 1;
        do until ii > ncontrol;
            name = "  beta_control_" $+ naOut.control_vars[ii];
            sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
                    name, naOut.beta_control[ii], se_beta[2*ndecomp+ii],
                    z_beta[2*ndecomp+ii], pv_beta[2*ndecomp+ii],
                    _qardlSignifStars(pv_beta[2*ndecomp+ii]));
            ii = ii + 1;
        endo;
    endif;

    ii = 1;
    do until ii > rows(naOut.phi);
        name = "  phi_l" $+ ntos(ii);
        sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
                name, naOut.phi[ii], se_phi[ii], z_phi[ii], pv_phi[ii],
                _qardlSignifStars(pv_phi[ii]));
        ii = ii + 1;
    endo;
    sprintf("%-22s%14.6f%14s%14s%13s%6s", "  alpha", naOut.alpha[1], "", "", "", "");
    sprintf("%-22s%14.6f%14s%14s%13s%6s", "  rho", naOut.rho[1], "", "", "", "");
    print dash_line;
    print "Long-run asymmetry tests";
    print asym_header;
    ii = 1;
    do until ii > rows(naOut.asymmetry_wald);
        name = "  " $+ naOut.decomp_vars[ii];
        sprintf("%-22s%14.6f%14.6f%6s",
                name, naOut.asymmetry_wald[ii], naOut.asymmetry_pv[ii],
                _qardlSignifStars(naOut.asymmetry_pv[ii]));
        ii = ii + 1;
    endo;
    print eq_line;
    print note;
    call _qardlPrintInterpHeader();
    call _qardlPrintRejectCountRow("Long-run asymmetry",
                                   naOut.asymmetry_pv,
                                   "positive and negative LR effects symmetric",
                                   "Long-run asymmetry is present for at least one variable.",
                                   "No variable shows significant long-run asymmetry.",
                                   0.05);
    if not scalmiss(naOut.short_run_pv[1]);
        call _qardlPrintRejectCountRow("Short-run asymmetry",
                                       naOut.short_run_pv,
                                       "positive and negative SR effects symmetric",
                                       "Short-run asymmetry is present for at least one variable.",
                                       "No variable shows significant short-run asymmetry.",
                                       0.05);
    endif;
    call _qardlPrintInterpEnd();
endp;

/*
**> printNARDLECM
**
**  Purpose:    Print formatted NARDL-ECM output.
*/
proc (0) = printNARDLECM(struct nardlECMOut nECMOut);
    local se_alpha, se_rho, z_alpha, z_rho, pv_alpha, pv_rho;
    local header, asym_header, note, table_width, eq_line, dash_line, ii, name;

    se_rho = sqrt(nECMOut.rho_cov[1, 1]);
    z_rho = nECMOut.rho[1] / se_rho;
    pv_rho = 2*cdfnc(abs(z_rho));
    if nECMOut.alpha_cov[1, 1] > 0;
        se_alpha = sqrt(nECMOut.alpha_cov[1, 1]);
        z_alpha = nECMOut.alpha[1] / se_alpha;
        pv_alpha = 2*cdfnc(abs(z_alpha));
    else;
        se_alpha = 0;
        z_alpha = 0;
        pv_alpha = 1;
    endif;

    header = "Name                          Coeff.     Std. Err.       z-value        P>|z|  Sig.";
    asym_header = "Name                       statistic       p-value  Sig.";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|strlen(asym_header)|84|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    if nECMOut.ecm_type $== "uecm";
        print "NARDL-ECM Estimator (Unrestricted)";
    else;
        print "NARDL-ECM Estimator (Two-Step)";
    endif;
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", nECMOut.nobs,
            "No. regressors:", nECMOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", nECMOut.p,
            "DL lags (q):", nECMOut.q);
    print "Covariance: " $+ nECMOut.covariance_type;
    print dash_line;
    print header;
    print dash_line;
    if nECMOut.alpha_cov[1, 1] > 0;
        sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
                "  alpha", nECMOut.alpha[1], se_alpha, z_alpha, pv_alpha,
                _qardlSignifStars(pv_alpha));
    else;
        sprintf("%-22s%14.6f%14s%14s%13s%6s",
                "  alpha", nECMOut.alpha[1], "", "", "", "");
    endif;
    sprintf("%-22s%14.6f%14.6f%14.6f%13.6f%6s",
            "  rho", nECMOut.rho[1], se_rho, z_rho, pv_rho,
            _qardlSignifStars(pv_rho));
    print dash_line;
    print "Long-run asymmetry tests";
    print asym_header;
    ii = 1;
    do until ii > rows(nECMOut.asymmetry_wald);
        name = "  " $+ nECMOut.decomp_vars[ii];
        sprintf("%-22s%14.6f%14.6f%6s",
                name, nECMOut.asymmetry_wald[ii], nECMOut.asymmetry_pv[ii],
                _qardlSignifStars(nECMOut.asymmetry_pv[ii]));
        ii = ii + 1;
    endo;
    print eq_line;
    print note;
    call _qardlPrintInterpHeader();
    call _qardlPrintECMInterpRow(nECMOut.rho[1], pv_rho, 0.05);
    call _qardlPrintRejectCountRow("Long-run asymmetry",
                                   nECMOut.asymmetry_pv,
                                   "positive and negative LR effects symmetric",
                                   "Long-run asymmetry is present for at least one variable.",
                                   "No variable shows significant long-run asymmetry.",
                                   0.05);
    call _qardlPrintInterpEnd();
endp;

/*
**> predictNARDL
**
**  Purpose:    Return in-sample fitted values from an estimated NARDL model.
*/
proc (1) = predictNARDL(struct nardlOut naOut, data, formula = "");
    retp(_predictNARDLLevels(naOut, data, formula));
endp;

proc (1) = _predictNARDLLevels(struct nardlOut naOut, data, formula = "");
    local Y, ONEX, x_pos, x_neg;

    if strlen(formula) == 0 and strlen(naOut.formula) > 0;
        formula = naOut.formula;
    endif;

    data = applyNARDLFormula(data, formula);
    if naOut.ncontrol > 0 or naOut.ndecomp /= naOut.k;
        { Y, ONEX, x_pos, x_neg } =
            _nardlBuildSpecDesign(data, naOut.p, naOut.q,
                                  naOut.decomp_indices, naOut.control_indices,
                                  naOut.q_control, naOut.decomp_thresholds);
    else;
        { Y, ONEX, x_pos, x_neg } =
            _nardlBuildDesign(data, naOut.p, naOut.q, naOut.decomp_thresholds);
    endif;
    retp(ONEX*naOut.bt);
endp;

/*
**> forecastNARDL
**
**  Purpose:    Recursive NARDL forecast holding future regressors fixed at
**              their last observed partial-sum values.
*/
proc (1) = forecastNARDL(struct nardlOut naOut, data, h = 1, formula = "", future_x = error(0));
    retp(_forecastNARDLLevels(naOut, data, h, formula, future_x));
endp;

proc (1) = _forecastNARDLLevels(struct nardlOut naOut, data, h = 1, formula = "", future_x = error(0));
    local yy, xx, xfuture, xall, yall, x_pos, x_neg, dx_pos, dx_neg;
    local out, ii, jj, kk, yhat, row_idx, xrow, y_lags;
    local dx_pos_lags, dx_neg_lags, dx_ctrl_lags, col_idx, y_placeholder;
    local x_ctrl, dx_ctrl, ndecomp, ncontrol;

    call _qardlValidateLagScalar(h, "forecastNARDL: h");
    if strlen(formula) == 0 and strlen(naOut.formula) > 0;
        formula = naOut.formula;
    endif;
    data = applyNARDLFormula(data, formula);
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    xfuture = _ardlFutureXOrHoldLast(xx, h, naOut.k, future_x, "forecastNARDL");
    xall = xx|xfuture;
    y_placeholder = zeros(rows(xall), 1);
    if naOut.ncontrol > 0 or naOut.ndecomp /= naOut.k;
        { x_pos, x_neg, dx_pos, dx_neg } =
            _nardlPartialSumsWithDiffs(y_placeholder~xall[., naOut.decomp_indices],
                                       naOut.decomp_thresholds);
        if naOut.ncontrol > 0;
            x_ctrl = xall[., naOut.control_indices];
            dx_ctrl = _nardlDiffMatrix(x_ctrl);
        endif;
    else;
        { x_pos, x_neg, dx_pos, dx_neg } =
            _nardlPartialSumsWithDiffs(y_placeholder~xall,
                                       naOut.decomp_thresholds);
    endif;
    yall = yy|zeros(h, 1);
    ndecomp = rows(naOut.beta_pos);
    ncontrol = naOut.ncontrol;

    out = zeros(h, 1);
    ii = 1;
    do until ii > h;
        row_idx = rows(yy) + ii;
        y_lags = zeros(1, naOut.p);
        jj = 1;
        do until jj > naOut.p;
            y_lags[1, jj] = yall[row_idx-jj];
            jj = jj + 1;
        endo;

        xrow = ones(1, 1)~x_pos[row_idx, .]~x_neg[row_idx, .];
        if ncontrol > 0;
            xrow = xrow~x_ctrl[row_idx, .];
        endif;
        xrow = xrow~y_lags;

        if naOut.q > 0;
            dx_pos_lags = zeros(1, naOut.q*ndecomp);
            dx_neg_lags = zeros(1, naOut.q*ndecomp);
            kk = 1;
            do until kk > ndecomp;
                jj = 0;
                do until jj > naOut.q-1;
                    col_idx = (kk-1)*naOut.q + jj + 1;
                    dx_pos_lags[1, col_idx] = dx_pos[row_idx-jj, kk];
                    dx_neg_lags[1, col_idx] = dx_neg[row_idx-jj, kk];
                    jj = jj + 1;
                endo;
                kk = kk + 1;
            endo;
            xrow = xrow~dx_pos_lags~dx_neg_lags;
        endif;

        if ncontrol > 0 and naOut.q_control > 0;
            dx_ctrl_lags = zeros(1, naOut.q_control*ncontrol);
            kk = 1;
            do until kk > ncontrol;
                jj = 0;
                do until jj > naOut.q_control-1;
                    col_idx = (kk-1)*naOut.q_control + jj + 1;
                    dx_ctrl_lags[1, col_idx] = dx_ctrl[row_idx-jj, kk];
                    jj = jj + 1;
                endo;
                kk = kk + 1;
            endo;
            xrow = xrow~dx_ctrl_lags;
        endif;

        yhat = xrow*naOut.bt;
        out[ii] = yhat;
        yall[row_idx] = yhat;
        ii = ii + 1;
    endo;

    retp(out);
endp;

/*
**> nardlDynamicMultipliers
**
**  Purpose:    Compute NARDL dynamic multipliers for positive and negative
**              partial-sum shocks from a levels-form nardlOut.
**
**  Format:     dmOut = nardlDynamicMultipliers(naOut);
**              dmOut = nardlDynamicMultipliers(naOut, horizon);
*/
proc (struct nardlDynMultOut) = nardlDynamicMultipliers(struct nardlOut naOut, horizon = 20);
    local pos, neg, asym, hvec, k0, qqq, ppp, pos_start, neg_start;
    local kk, hh, jj, response, row_idx, dx_idx;

    call _qardlValidateLagScalarZero(horizon, "nardlDynamicMultipliers: horizon");

    k0 = rows(naOut.beta_pos);
    ppp = naOut.p;
    qqq = naOut.q;
    pos = zeros(horizon+1, k0);
    neg = zeros(horizon+1, k0);
    hvec = seqa(0, 1, horizon+1);

    pos_start = 2 + 2*k0 + naOut.ncontrol + ppp;
    neg_start = pos_start + qqq*k0;

    kk = 1;
    do until kk > k0;
        hh = 0;
        do until hh > horizon;
            row_idx = hh + 1;
            response = naOut.theta_pos[kk];

            if qqq > 0 and hh < qqq;
                dx_idx = pos_start + (kk-1)*qqq + hh;
                response = response + naOut.bt[dx_idx];
            endif;

            jj = 1;
            do until jj > ppp;
                if hh - jj >= 0;
                    response = response + naOut.phi[jj]*pos[hh-jj+1, kk];
                endif;
                jj = jj + 1;
            endo;
            pos[row_idx, kk] = response;

            response = naOut.theta_neg[kk];
            if qqq > 0 and hh < qqq;
                dx_idx = neg_start + (kk-1)*qqq + hh;
                response = response + naOut.bt[dx_idx];
            endif;

            jj = 1;
            do until jj > ppp;
                if hh - jj >= 0;
                    response = response + naOut.phi[jj]*neg[hh-jj+1, kk];
                endif;
                jj = jj + 1;
            endo;
            neg[row_idx, kk] = response;

            hh = hh + 1;
        endo;
        kk = kk + 1;
    endo;

    asym = pos - neg;

    struct nardlDynMultOut dmOut;
    dmOut.model_family = "NARDL-Dynamic-Multipliers";
    dmOut.formula = naOut.formula;
    dmOut.depvar = naOut.depvar;
    dmOut.xvars = naOut.decomp_vars;
    dmOut.horizon = horizon;
    dmOut.k = k0;
    dmOut.h = hvec;
    dmOut.pos = pos;
    dmOut.neg = neg;
    dmOut.asymmetry = asym;

    retp(dmOut);
endp;

/*
**> applyNARDLFormula
**
**  Purpose:    Formula hook for NARDL workflows.  Uses the same Wilkinson
**              parser as applyQARDLFormula().
*/
proc (1) = applyNARDLFormula(data, formula);
    retp(_applyFormula(data, formula));
endp;

proc (1) = _nardlStringSelectorEmpty(vars);
    if rows(vars) == 1 and cols(vars) == 1;
        retp(strlen(vars) == 0);
    endif;
    retp(0);
endp;

proc (1) = _nardlIndexCount(idx);
    if rows(idx) == 1 and cols(idx) == 1 and scalmiss(idx);
        retp(0);
    endif;
    retp(rows(idx));
endp;

proc (1) = _nardlIndexIn(value, idx);
    local ii;

    if _nardlIndexCount(idx) == 0;
        retp(0);
    endif;

    ii = 1;
    do until ii > rows(idx);
        if idx[ii] == value;
            retp(1);
        endif;
        ii = ii + 1;
    endo;

    retp(0);
endp;

proc (0) = _nardlValidateUniqueIndices(idx, caller, label);
    local ii, jj;

    if _nardlIndexCount(idx) <= 1;
        retp;
    endif;

    ii = 1;
    do until ii > rows(idx)-1;
        jj = ii + 1;
        do until jj > rows(idx);
            if idx[ii] == idx[jj];
                errorlog caller $+ ": duplicate " $+ label $+ " selector";
                end;
            endif;
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;
endp;

proc (4) = _nardlResolveSpecSelectors(xvars, decomp_vars, control_vars, caller);
    local decomp_idx, control_idx, control_names;
    local lower_xvars, ii, cc, decomp_names;

    lower_xvars = lower(xvars);

    if _nardlStringSelectorEmpty(decomp_vars) and _nardlStringSelectorEmpty(control_vars);
        decomp_idx = seqa(1, 1, rows(xvars));
        decomp_names = xvars;
        control_idx = error(0);
        control_names = "";
    elseif _nardlStringSelectorEmpty(decomp_vars);
        control_idx = indsav(lower(control_vars), lower_xvars);
        if rows(control_idx) /= rows(control_vars);
            errorlog caller $+ ": one or more control_vars were not found in the RHS variable list";
            end;
        endif;
        call _nardlValidateUniqueIndices(control_idx, caller, "control_vars");
        control_names = control_vars;

        decomp_idx = zeros(rows(xvars), 1);
        decomp_names = "";
        cc = 0;
        ii = 1;
        do until ii > rows(xvars);
            if not _nardlIndexIn(ii, control_idx);
                cc = cc + 1;
                decomp_idx[cc] = ii;
                if cc == 1;
                    decomp_names = xvars[ii];
                else;
                    decomp_names = decomp_names $| xvars[ii];
                endif;
            endif;
            ii = ii + 1;
        endo;

        if cc > 0;
            decomp_idx = decomp_idx[1:cc];
        else;
            errorlog caller $+ ": at least one decomposed variable is required";
            end;
        endif;
    else;
        decomp_idx = indsav(lower(decomp_vars), lower_xvars);
        if rows(decomp_idx) /= rows(decomp_vars);
            errorlog caller $+ ": one or more decomp_vars were not found in the RHS variable list";
            end;
        endif;
        call _nardlValidateUniqueIndices(decomp_idx, caller, "decomp_vars");
        decomp_names = decomp_vars;

        if _nardlStringSelectorEmpty(control_vars);
            control_idx = zeros(rows(xvars), 1);
            control_names = "";
            cc = 0;
            ii = 1;
            do until ii > rows(xvars);
                if not _nardlIndexIn(ii, decomp_idx);
                    cc = cc + 1;
                    control_idx[cc] = ii;
                    if cc == 1;
                        control_names = xvars[ii];
                    else;
                        control_names = control_names $| xvars[ii];
                    endif;
                endif;
                ii = ii + 1;
            endo;

            if cc > 0;
                control_idx = control_idx[1:cc];
            else;
                control_idx = error(0);
            endif;
        else;
            control_idx = indsav(lower(control_vars), lower_xvars);
            if rows(control_idx) /= rows(control_vars);
                errorlog caller $+ ": one or more control_vars were not found in the RHS variable list";
                end;
            endif;
            call _nardlValidateUniqueIndices(control_idx, caller, "control_vars");
            control_names = control_vars;
        endif;
    endif;

    ii = 1;
    do until ii > rows(decomp_idx);
        if _nardlIndexIn(decomp_idx[ii], control_idx);
            errorlog caller $+ ": decomp_vars and control_vars must not overlap";
            end;
        endif;
        ii = ii + 1;
    endo;

    retp(decomp_idx, control_idx, decomp_names, control_names);
endp;

proc (1) = _nardlQVecForSelectors(k0, decomp_idx, control_idx, q_decomp,
                                  q_control);
    local qvec, ii;

    qvec = zeros(k0, 1);
    ii = 1;
    do until ii > rows(decomp_idx);
        qvec[decomp_idx[ii]] = q_decomp;
        ii = ii + 1;
    endo;

    if _nardlIndexCount(control_idx) > 0;
        ii = 1;
        do until ii > rows(control_idx);
            qvec[control_idx[ii]] = q_control;
            ii = ii + 1;
        endo;
    endif;

    retp(qvec);
endp;

proc (0) = _nardlValidateSpecInputs(data, ppp, q_decomp, q_control,
                                    decomp_idx, control_idx, caller);
    local max_lag, n_eff, n_param, k0, ndecomp, ncontrol;

    if rows(data) < 1 or cols(data) < 2;
        errorlog caller $+ ": data must have at least one dependent variable and one regressor column";
        end;
    endif;

    if ismiss(data);
        errorlog caller $+ ": data contains missing values; clean or align the sample before estimation";
        end;
    endif;

    call _qardlValidateLagScalar(ppp, caller $+ ": p");
    call _qardlValidateLagScalarZero(q_decomp, caller $+ ": q_decomp");
    call _qardlValidateLagScalarZero(q_control, caller $+ ": q_control");

    k0 = cols(data) - 1;
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);

    if ndecomp < 1;
        errorlog caller $+ ": at least one decomposed variable is required";
        end;
    endif;

    if maxc(decomp_idx) > k0 or minc(decomp_idx) < 1;
        errorlog caller $+ ": decomp_vars resolved outside the RHS variable range";
        end;
    endif;

    if ncontrol > 0;
        if maxc(control_idx) > k0 or minc(control_idx) < 1;
            errorlog caller $+ ": control_vars resolved outside the RHS variable range";
            end;
        endif;
    endif;

    max_lag = maxc(ppp|q_decomp|q_control);
    n_eff = rows(data) - max_lag;
    n_param = 1 + 2*ndecomp + ncontrol + ppp +
              2*q_decomp*ndecomp + q_control*ncontrol;

    if n_eff <= n_param;
        errorlog caller $+ ": not enough observations for the requested lag orders";
        end;
    endif;
endp;

proc (0) = _nardlValidateEstimatorInputs(data, ppp, qqq, caller);
    local max_lag, n_eff, n_param, k0;

    if rows(data) < 1 or cols(data) < 2;
        errorlog caller $+ ": data must have at least one dependent variable and one regressor column";
        end;
    endif;

    if ismiss(data);
        errorlog caller $+ ": data contains missing values; clean or align the sample before estimation";
        end;
    endif;

    call _qardlValidateLagScalar(ppp, caller $+ ": p");
    call _qardlValidateLagScalarZero(qqq, caller $+ ": q");

    k0 = cols(data) - 1;
    max_lag = maxc(ppp|qqq);
    n_eff = rows(data) - max_lag;
    n_param = 1 + 2*k0 + ppp + 2*qqq*k0;

    if n_eff <= n_param;
        errorlog caller $+ ": not enough observations for the requested lag orders";
        end;
    endif;
endp;

proc (4) = _nardlBuildDesign(data, ppp, qqq, decomp_thresholds);
    local nn, k0, max_lag, N, yy, Y, ONEX;
    local x_pos, x_neg, dx_pos, dx_neg;
    local pos_level, neg_level, y_lags, dx_pos_lags, dx_neg_lags;
    local ii, jj, src, col;

    nn = rows(data);
    k0 = cols(data) - 1;
    max_lag = maxc(ppp|qqq);
    N = nn - max_lag;
    yy = data[., 1];

    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data, decomp_thresholds);

    Y = yy[max_lag+1:nn];
    pos_level = zeros(N, k0);
    neg_level = zeros(N, k0);
    y_lags = zeros(N, ppp);

    ii = 1;
    do until ii > N;
        src = max_lag + ii;
        pos_level[ii, .] = x_pos[src, .];
        neg_level[ii, .] = x_neg[src, .];
        jj = 1;
        do until jj > ppp;
            y_lags[ii, jj] = yy[src-jj];
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    ONEX = ones(N, 1)~pos_level~neg_level~y_lags;

    if qqq > 0;
        dx_pos_lags = zeros(N, qqq*k0);
        dx_neg_lags = zeros(N, qqq*k0);
        ii = 1;
        do until ii > k0;
            jj = 0;
            do until jj > qqq-1;
                col = (ii-1)*qqq + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+1-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+1-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    retp(Y, ONEX, x_pos, x_neg);
endp;

proc (4) = _nardlBuildSpecDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                                 q_control, decomp_thresholds);
    local nn, ndecomp, ncontrol, max_lag, N, yy, Y, ONEX;
    local x_pos, x_neg, dx_pos, dx_neg, x_ctrl, dx_ctrl;
    local pos_level, neg_level, ctrl_level, y_lags;
    local dx_pos_lags, dx_neg_lags, dx_ctrl_lags;
    local ii, jj, src, col;

    nn = rows(data);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    max_lag = maxc(ppp|q_decomp|q_control);
    N = nn - max_lag;
    yy = data[., 1];

    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data[., 1]~data[., 1 + decomp_idx],
                                   decomp_thresholds);

    if ncontrol > 0;
        x_ctrl = data[., 1 + control_idx];
        dx_ctrl = _nardlDiffMatrix(x_ctrl);
    else;
        x_ctrl = error(0);
        dx_ctrl = error(0);
    endif;

    Y = yy[max_lag+1:nn];
    pos_level = zeros(N, ndecomp);
    neg_level = zeros(N, ndecomp);
    y_lags = zeros(N, ppp);

    if ncontrol > 0;
        ctrl_level = zeros(N, ncontrol);
    endif;

    ii = 1;
    do until ii > N;
        src = max_lag + ii;
        pos_level[ii, .] = x_pos[src, .];
        neg_level[ii, .] = x_neg[src, .];
        if ncontrol > 0;
            ctrl_level[ii, .] = x_ctrl[src, .];
        endif;
        jj = 1;
        do until jj > ppp;
            y_lags[ii, jj] = yy[src-jj];
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    ONEX = ones(N, 1)~pos_level~neg_level;
    if ncontrol > 0;
        ONEX = ONEX~ctrl_level;
    endif;
    ONEX = ONEX~y_lags;

    if q_decomp > 0;
        dx_pos_lags = zeros(N, q_decomp*ndecomp);
        dx_neg_lags = zeros(N, q_decomp*ndecomp);
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                col = (ii-1)*q_decomp + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+1-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+1-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    if ncontrol > 0 and q_control > 0;
        dx_ctrl_lags = zeros(N, q_control*ncontrol);
        ii = 1;
        do until ii > ncontrol;
            jj = 0;
            do until jj > q_control-1;
                col = (ii-1)*q_control + jj + 1;
                dx_ctrl_lags[., col] = dx_ctrl[max_lag+1-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_ctrl_lags;
    endif;

    retp(Y, ONEX, x_pos, x_neg);
endp;

proc (2) = _nardlBuildECMDesign(data, ppp, qqq, beta_pos, beta_neg,
                                decomp_thresholds);
    local nn, k0, max_lag, N, yy, x_pos, x_neg, dx_pos, dx_neg;
    local Y, ec_lag, ONEX, dy_lags, dx_pos_lags, dx_neg_lags;
    local ii, jj, src, col;

    nn = rows(data);
    k0 = cols(data) - 1;
    max_lag = maxc(ppp|qqq);
    N = nn - max_lag - 1;
    yy = data[., 1];
    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data, decomp_thresholds);

    Y = zeros(N, 1);
    ec_lag = zeros(N, 1);

    ii = 1;
    do until ii > N;
        src = max_lag + 1 + ii;
        Y[ii] = yy[src] - yy[src-1];
        ec_lag[ii] = yy[src-1] - x_pos[src-1, .]*beta_pos - x_neg[src-1, .]*beta_neg;
        ii = ii + 1;
    endo;

    ONEX = ones(N, 1)~ec_lag;

    if ppp > 1;
        dy_lags = zeros(N, ppp-1);
        ii = 1;
        do until ii > N;
            src = max_lag + 1 + ii;
            jj = 1;
            do until jj > ppp-1;
                dy_lags[ii, jj] = yy[src-jj] - yy[src-jj-1];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dy_lags;
    endif;

    if qqq > 0;
        dx_pos_lags = zeros(N, qqq*k0);
        dx_neg_lags = zeros(N, qqq*k0);
        ii = 1;
        do until ii > k0;
            jj = 0;
            do until jj > qqq-1;
                col = (ii-1)*qqq + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+2-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    retp(Y, ONEX);
endp;

proc (2) = _nardlBuildSpecECMDesign(data, ppp, q_decomp, decomp_idx, control_idx,
                                    q_control, beta_pos, beta_neg, beta_control,
                                    decomp_thresholds, case_id = 3);
    local nn, ndecomp, ncontrol, max_lag, N, yy, x_pos, x_neg, dx_pos, dx_neg;
    local x_ctrl, dx_ctrl, Y, ec_lag, ONEX, dy_lags, trend;
    local dx_pos_lags, dx_neg_lags, dx_ctrl_lags;
    local ii, jj, src, col;

    nn = rows(data);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    max_lag = maxc(ppp|q_decomp|q_control);
    N = nn - max_lag - 1;
    yy = data[., 1];
    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data[., 1]~data[., 1 + decomp_idx],
                                   decomp_thresholds);

    if ncontrol > 0;
        x_ctrl = data[., 1 + control_idx];
        dx_ctrl = _nardlDiffMatrix(x_ctrl);
    else;
        x_ctrl = error(0);
        dx_ctrl = error(0);
    endif;

    Y = zeros(N, 1);
    trend = seqa(max_lag + 2, 1, N);
    ec_lag = zeros(N, 1);

    ii = 1;
    do until ii > N;
        src = max_lag + 1 + ii;
        Y[ii] = yy[src] - yy[src-1];
        ec_lag[ii] = yy[src-1] - x_pos[src-1, .]*beta_pos - x_neg[src-1, .]*beta_neg;
        if ncontrol > 0;
            ec_lag[ii] = ec_lag[ii] - x_ctrl[src-1, .]*beta_control;
        endif;
        ii = ii + 1;
    endo;

    if case_id == 1;
        ONEX = ec_lag;
    elseif case_id == 2 or case_id == 3;
        ONEX = ones(N, 1)~ec_lag;
    else;
        ONEX = ones(N, 1)~trend~ec_lag;
    endif;

    if ppp > 1;
        dy_lags = zeros(N, ppp-1);
        ii = 1;
        do until ii > N;
            src = max_lag + 1 + ii;
            jj = 1;
            do until jj > ppp-1;
                dy_lags[ii, jj] = yy[src-jj] - yy[src-jj-1];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dy_lags;
    endif;

    if q_decomp > 0;
        dx_pos_lags = zeros(N, q_decomp*ndecomp);
        dx_neg_lags = zeros(N, q_decomp*ndecomp);
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                col = (ii-1)*q_decomp + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+2-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    if ncontrol > 0 and q_control > 0;
        dx_ctrl_lags = zeros(N, q_control*ncontrol);
        ii = 1;
        do until ii > ncontrol;
            jj = 0;
            do until jj > q_control-1;
                col = (ii-1)*q_control + jj + 1;
                dx_ctrl_lags[., col] = dx_ctrl[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_ctrl_lags;
    endif;

    retp(Y, ONEX);
endp;

proc (1) = _nardlBoundsFstat(data, ppp, qqq);
    local Y, XU, XR, bt_u, bt_r, resid_u, resid_r, rss_u, rss_r;
    local k0, q_restrict, N, K_total, rest_start;

    { Y, XU } =
        _nardlBuildUECMDesign(data, ppp, qqq, _nardlInfThresh(cols(data) - 1));
    call _qardlCheckFullColumnRank(XU, "nardl", "UECM bounds design matrix");

    k0 = cols(data) - 1;
    q_restrict = 1 + 2*k0;
    rest_start = 3 + 2*k0;
    if cols(XU) >= rest_start;
        XR = XU[., 1]~XU[., rest_start:cols(XU)];
    else;
        XR = XU[., 1];
    endif;
    call _qardlCheckFullColumnRank(XR, "nardl", "restricted UECM bounds design matrix");

    bt_u = _qardlSafeInv(XU'*XU, "nardl", "UECM bounds moment matrix")*XU'*Y;
    bt_r = _qardlSafeInv(XR'*XR, "nardl", "restricted UECM bounds moment matrix")*XR'*Y;
    resid_u = Y - XU*bt_u;
    resid_r = Y - XR*bt_r;
    rss_u = resid_u'*resid_u;
    rss_r = resid_r'*resid_r;
    N = rows(Y);
    K_total = cols(XU);

    retp(((rss_r - rss_u) / q_restrict) / (rss_u / (N - K_total)));
endp;

proc (2) = _nardlBuildUECMDesign(data, ppp, qqq, decomp_thresholds);
    local nn, k0, max_lag, N, yy, x_pos, x_neg, dx_pos, dx_neg;
    local Y, y_lag, pos_lag, neg_lag, ONEX, dy_lags, dx_pos_lags, dx_neg_lags;
    local ii, jj, src, col;

    nn = rows(data);
    k0 = cols(data) - 1;
    max_lag = maxc(ppp|qqq);
    N = nn - max_lag - 1;
    yy = data[., 1];
    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data, decomp_thresholds);

    Y = zeros(N, 1);
    y_lag = zeros(N, 1);
    pos_lag = zeros(N, k0);
    neg_lag = zeros(N, k0);

    ii = 1;
    do until ii > N;
        src = max_lag + 1 + ii;
        Y[ii] = yy[src] - yy[src-1];
        y_lag[ii] = yy[src-1];
        pos_lag[ii, .] = x_pos[src-1, .];
        neg_lag[ii, .] = x_neg[src-1, .];
        ii = ii + 1;
    endo;

    ONEX = ones(N, 1)~y_lag~pos_lag~neg_lag;

    if ppp > 1;
        dy_lags = zeros(N, ppp-1);
        ii = 1;
        do until ii > N;
            src = max_lag + 1 + ii;
            jj = 1;
            do until jj > ppp-1;
                dy_lags[ii, jj] = yy[src-jj] - yy[src-jj-1];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dy_lags;
    endif;

    if qqq > 0;
        dx_pos_lags = zeros(N, qqq*k0);
        dx_neg_lags = zeros(N, qqq*k0);
        ii = 1;
        do until ii > k0;
            jj = 0;
            do until jj > qqq-1;
                col = (ii-1)*qqq + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+2-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    retp(Y, ONEX);
endp;

proc (1) = _nardlBoundsFstatForSelectors(data, ppp, q_decomp, decomp_idx,
                                         control_idx, q_control,
                                         decomp_thresholds, caller);
    local Y, XU, XR, bt_u, bt_r, resid_u, resid_r, rss_u, rss_r;
    local ndecomp, ncontrol, q_restrict, N, K_total, rest_start;

    { Y, XU } = _nardlBuildSpecUECMDesign(data, ppp, q_decomp,
                                          decomp_idx, control_idx, q_control,
                                          3, decomp_thresholds);
    call _qardlCheckFullColumnRank(XU, caller, "UECM bounds design matrix");

    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    q_restrict = 1 + 2*ndecomp + ncontrol;
    rest_start = 3 + 2*ndecomp + ncontrol;
    if cols(XU) >= rest_start;
        XR = XU[., 1]~XU[., rest_start:cols(XU)];
    else;
        XR = XU[., 1];
    endif;
    call _qardlCheckFullColumnRank(XR, caller, "restricted UECM bounds design matrix");

    bt_u = _qardlSafeInv(XU'*XU, caller, "UECM bounds moment matrix")*XU'*Y;
    bt_r = _qardlSafeInv(XR'*XR, caller, "restricted UECM bounds moment matrix")*XR'*Y;
    resid_u = Y - XU*bt_u;
    resid_r = Y - XR*bt_r;
    rss_u = resid_u'*resid_u;
    rss_r = resid_r'*resid_r;
    N = rows(Y);
    K_total = cols(XU);

    retp(((rss_r - rss_u) / q_restrict) / (rss_u / (N - K_total)));
endp;

proc (3) = _nardlAutoCases(data, ppp, q_decomp, decomp_idx, control_idx,
                           q_control, decomp_thresholds, gets_pval, caller);
    local Y, XU, bt, resid, coef_cov, sigma2, det_coef, det_pv, case_ids;

    { Y, XU } = _nardlBuildSpecUECMDesign(data, ppp, q_decomp,
                                          decomp_idx, control_idx, q_control,
                                          5, decomp_thresholds);
    call _qardlCheckFullColumnRank(XU, caller, "Case V auto-case UECM design matrix");
    bt = _qardlSafeInv(XU'*XU, caller, "Case V auto-case UECM moment matrix")*XU'*Y;
    resid = Y - XU*bt;
    { coef_cov, sigma2 } = _nardlOLSCov(XU, resid, caller);
    det_coef = bt[1:2];
    det_pv = _ardlDetPValues(bt, coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);

    retp(case_ids, det_coef, det_pv);
endp;

proc (9) = _nardlSparseAutoCases(data, ppp, q_decomp, decomp_idx, control_idx,
                                 q_control, decomp_thresholds, gets_pval,
                                 caller);
    local Y, XU, ndecomp, ncontrol, level_count, protect_cols;
    local keep, bt, coef_cov, fitted, resid, sigma2;
    local det_coef, det_pv, case_ids;

    { Y, XU } = _nardlBuildSpecUECMDesign(data, ppp, q_decomp,
                                          decomp_idx, control_idx, q_control,
                                          5, decomp_thresholds);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    level_count = 1 + 2*ndecomp + ncontrol;
    protect_cols = seqa(3, 1, level_count);
    { keep, bt, coef_cov, fitted, resid, sigma2 } =
        _qardlSparseGETS(Y, XU, protect_cols, gets_pval, caller);

    det_coef = bt[1:2];
    det_pv = _ardlDetPValues(bt, coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);

    retp(case_ids, det_coef, det_pv, keep, bt, coef_cov, fitted, resid,
         sigma2);
endp;

proc (1) = _nardlSparseGETSLabels(decomp_names, control_names, ppp,
                                  q_decomp, q_control, ncontrol);
    local labels, ndecomp, ii, jj;

    ndecomp = rows(decomp_names);
    labels = "const" $| "trend" $| "y_lag";

    ii = 1;
    do until ii > ndecomp;
        labels = labels $| ("x_pos_lag_" $+ decomp_names[ii]);
        ii = ii + 1;
    endo;

    ii = 1;
    do until ii > ndecomp;
        labels = labels $| ("x_neg_lag_" $+ decomp_names[ii]);
        ii = ii + 1;
    endo;

    ii = 1;
    do until ii > ncontrol;
        labels = labels $| ("x_ctrl_lag_" $+ control_names[ii]);
        ii = ii + 1;
    endo;

    if ppp > 1;
        jj = 1;
        do until jj > ppp-1;
            labels = labels $| ("dy_lag" $+ ntos(jj));
            jj = jj + 1;
        endo;
    endif;

    if q_decomp > 0;
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                labels = labels $| ("dx_pos_" $+ decomp_names[ii] $+ "_lag" $+ ntos(jj));
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;

        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                labels = labels $| ("dx_neg_" $+ decomp_names[ii] $+ "_lag" $+ ntos(jj));
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    if ncontrol > 0 and q_control > 0;
        ii = 1;
        do until ii > ncontrol;
            jj = 0;
            do until jj > q_control-1;
                labels = labels $| ("dx_ctrl_" $+ control_names[ii] $+ "_lag" $+ ntos(jj));
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    retp(labels);
endp;

proc (1) = _nardlAutoBoundsTable(data, ppp, q_decomp, decomp_idx, control_idx,
                                 q_control, decomp_thresholds, case_ids,
                                 caller);
    local out, ii, Fstat, tstat, cv, used_case, q_restrict;

    out = zeros(rows(case_ids), 10);
    ii = 1;
    do until ii > rows(case_ids);
        { Fstat, tstat, cv, used_case, q_restrict } =
            _nardlBoundsCase(data, ppp, q_decomp, decomp_idx, control_idx,
                             q_control, decomp_thresholds, case_ids[ii],
                             caller);
        out[ii, .] = used_case~Fstat~tstat~q_restrict~
                     cv[1, 1]~cv[1, 2]~cv[2, 1]~cv[2, 2]~
                     cv[3, 1]~cv[3, 2];
        ii = ii + 1;
    endo;

    retp(out);
endp;

proc (5) = _nardlBoundsCase(data, ppp, q_decomp, decomp_idx, control_idx,
                            q_control, decomp_thresholds, case_id, caller);
    local Y, XU, XR, bt_u, bt_r, resid_u, resid_r, rss_u, rss_r;
    local coef_cov, sigma2, ndecomp, ncontrol, k_bounds, det_cols;
    local level_start, level_end, drop_start, drop_end, q_restrict;
    local keep_cols, N, K_total, Fstat, tstat, cv, has_restricted;

    call _ardlValidateCaseID(case_id, caller);
    { Y, XU } = _nardlBuildSpecUECMDesign(data, ppp, q_decomp,
                                          decomp_idx, control_idx, q_control,
                                          case_id, decomp_thresholds);
    call _qardlCheckFullColumnRank(XU, caller, "NARDL auto-case bounds design matrix");

    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    k_bounds = 2*ndecomp + ncontrol;
    det_cols = _ardlDeterministicColumnCount(case_id);
    level_start = det_cols + 1;
    level_end = det_cols + k_bounds + 1;

    if case_id == 2;
        drop_start = 1;
        drop_end = level_end;
    elseif case_id == 4;
        drop_start = 2;
        drop_end = level_end;
    else;
        drop_start = level_start;
        drop_end = level_end;
    endif;

    q_restrict = drop_end - drop_start + 1;
    K_total = cols(XU);

    has_restricted = not (drop_start == 1 and drop_end == K_total);

    if not has_restricted;
        rss_r = sumc(Y.^2);
    elseif drop_start == 1;
        XR = XU[., drop_end+1:K_total];
    elseif drop_end == K_total;
        XR = XU[., 1:drop_start-1];
    else;
        XR = XU[., 1:drop_start-1]~XU[., drop_end+1:K_total];
    endif;

    bt_u = _qardlSafeInv(XU'*XU, caller, "NARDL auto-case bounds moment matrix")*XU'*Y;
    resid_u = Y - XU*bt_u;
    rss_u = resid_u'*resid_u;
    N = rows(Y);
    sigma2 = rss_u / (N - K_total);
    coef_cov = sigma2*_qardlSafeInv(XU'*XU, caller,
                                    "NARDL auto-case bounds covariance moment matrix");

    if has_restricted;
        call _qardlCheckFullColumnRank(XR, caller, "NARDL auto-case restricted bounds design matrix");
        bt_r = _qardlSafeInv(XR'*XR, caller,
                             "NARDL auto-case restricted bounds moment matrix")*XR'*Y;
        resid_r = Y - XR*bt_r;
        rss_r = resid_r'*resid_r;
    endif;

    Fstat = ((rss_r - rss_u) / q_restrict) / (rss_u / (N - K_total));
    tstat = bt_u[level_start] / sqrt(coef_cov[level_start, level_start]);
    cv = ardlboundsCaseCV(k_bounds, case_id, 1000, 0, 0);

    retp(Fstat, tstat, cv, case_id, q_restrict);
endp;

proc (2) = _nardlBuildSpecUECMDesign(data, ppp, q_decomp, decomp_idx,
                                     control_idx, q_control, case_id,
                                     decomp_thresholds);
    local nn, ndecomp, ncontrol, max_lag, N, yy, x_pos, x_neg, dx_pos, dx_neg;
    local x_ctrl, dx_ctrl, Y, y_lag, pos_lag, neg_lag, ctrl_lag;
    local ONEX, dy_lags, dx_pos_lags, dx_neg_lags, dx_ctrl_lags;
    local ii, jj, src, col;
    local trend, level_terms;

    nn = rows(data);
    ndecomp = rows(decomp_idx);
    ncontrol = _nardlIndexCount(control_idx);
    max_lag = maxc(ppp|q_decomp|q_control);
    N = nn - max_lag - 1;
    yy = data[., 1];
    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data[., 1]~data[., 1 + decomp_idx],
                                   decomp_thresholds);

    if ncontrol > 0;
        x_ctrl = data[., 1 + control_idx];
        dx_ctrl = _nardlDiffMatrix(x_ctrl);
    else;
        x_ctrl = error(0);
        dx_ctrl = error(0);
    endif;

    Y = zeros(N, 1);
    trend = seqa(max_lag + 2, 1, N);
    y_lag = zeros(N, 1);
    pos_lag = zeros(N, ndecomp);
    neg_lag = zeros(N, ndecomp);
    if ncontrol > 0;
        ctrl_lag = zeros(N, ncontrol);
    endif;

    ii = 1;
    do until ii > N;
        src = max_lag + 1 + ii;
        Y[ii] = yy[src] - yy[src-1];
        y_lag[ii] = yy[src-1];
        pos_lag[ii, .] = x_pos[src-1, .];
        neg_lag[ii, .] = x_neg[src-1, .];
        if ncontrol > 0;
            ctrl_lag[ii, .] = x_ctrl[src-1, .];
        endif;
        ii = ii + 1;
    endo;

    level_terms = y_lag~pos_lag~neg_lag;
    if ncontrol > 0;
        level_terms = level_terms~ctrl_lag;
    endif;

    if case_id == 1;
        ONEX = level_terms;
    elseif case_id == 2 or case_id == 3;
        ONEX = ones(N, 1)~level_terms;
    else;
        ONEX = ones(N, 1)~trend~level_terms;
    endif;

    if ppp > 1;
        dy_lags = zeros(N, ppp-1);
        ii = 1;
        do until ii > N;
            src = max_lag + 1 + ii;
            jj = 1;
            do until jj > ppp-1;
                dy_lags[ii, jj] = yy[src-jj] - yy[src-jj-1];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dy_lags;
    endif;

    if q_decomp > 0;
        dx_pos_lags = zeros(N, q_decomp*ndecomp);
        dx_neg_lags = zeros(N, q_decomp*ndecomp);
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                col = (ii-1)*q_decomp + jj + 1;
                dx_pos_lags[., col] = dx_pos[max_lag+2-jj:nn-jj, ii];
                dx_neg_lags[., col] = dx_neg[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_pos_lags~dx_neg_lags;
    endif;

    if ncontrol > 0 and q_control > 0;
        dx_ctrl_lags = zeros(N, q_control*ncontrol);
        ii = 1;
        do until ii > ncontrol;
            jj = 0;
            do until jj > q_control-1;
                col = (ii-1)*q_control + jj + 1;
                dx_ctrl_lags[., col] = dx_ctrl[max_lag+2-jj:nn-jj, ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_ctrl_lags;
    endif;

    retp(Y, ONEX);
endp;

proc (2) = _nardlPartialSums(data);
    local x_pos, x_neg, dx_pos, dx_neg;
    { x_pos, x_neg, dx_pos, dx_neg } =
        _nardlPartialSumsWithDiffs(data, _nardlInfThresh(cols(data) - 1));
    retp(x_pos, x_neg);
endp;

proc (1) = _nardlDiffMatrix(xx);
    local dx, ii;

    dx = zeros(rows(xx), cols(xx));
    ii = 2;
    do until ii > rows(xx);
        dx[ii, .] = xx[ii, .] - xx[ii-1, .];
        ii = ii + 1;
    endo;

    retp(dx);
endp;

proc (4) = _nardlPartialSumsWithDiffs(data, decomp_thresholds);
    local nn, k0, xx, x_pos, x_neg, dx_pos, dx_neg, delta, ii, jj;

    nn = rows(data);
    k0 = cols(data) - 1;
    xx = data[., 2:cols(data)];
    call _nardlValidateThreshVec(decomp_thresholds, k0,
                                 "_nardlPartialSumsWithDiffs");
    x_pos = zeros(nn, k0);
    x_neg = zeros(nn, k0);
    dx_pos = zeros(nn, k0);
    dx_neg = zeros(nn, k0);

    ii = 2;
    do until ii > nn;
        jj = 1;
        do until jj > k0;
            delta = xx[ii, jj] - xx[ii-1, jj];
            x_pos[ii, jj] = x_pos[ii-1, jj];
            x_neg[ii, jj] = x_neg[ii-1, jj];
            if delta > 0;
                dx_pos[ii, jj] = delta;
                x_pos[ii, jj] = x_pos[ii, jj] + delta;
            elseif delta < 0;
                dx_neg[ii, jj] = delta;
                x_neg[ii, jj] = x_neg[ii, jj] + delta;
            endif;
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    jj = 1;
    do until jj > k0;
        x_pos[., jj] = _nardlResetCumsum(dx_pos[., jj], decomp_thresholds[jj]);
        x_neg[., jj] = _nardlResetCumsum(dx_neg[., jj], decomp_thresholds[jj]);
        jj = jj + 1;
    endo;

    retp(x_pos, x_neg, dx_pos, dx_neg);
endp;

proc (1) = _nardlResetCumsum(dx, threshold);
    local out, ii;

    out = zeros(rows(dx), 1);
    out[1] = dx[1];
    ii = 2;
    do until ii > rows(dx);
        if out[ii-1] >= threshold;
            out[ii] = dx[ii];
        else;
            out[ii] = out[ii-1] + dx[ii];
        endif;
        ii = ii + 1;
    endo;

    retp(out);
endp;

proc (1) = _nardlInfThresh(k);
    retp(1e256*ones(k, 1));
endp;

proc (1) = _nardlIsUnset(x);
    if type(x) == 6;
        if rows(x) == 1 and cols(x) == 1 and scalmiss(x);
            retp(1);
        endif;
    endif;
    retp(0);
endp;

proc (0) = _nardlValidateThreshVec(thresh, ndecomp, caller);
    if type(thresh) /= 6;
        errorlog caller $+ ": thresholds must resolve to a numeric matrix";
        end;
    endif;
    if rows(thresh) /= ndecomp or cols(thresh) /= 1;
        errorlog caller $+ ": threshold vector length must equal the number of decomposed variables";
        end;
    endif;
    if ismiss(thresh);
        errorlog caller $+ ": threshold values must not be missing";
        end;
    endif;
endp;

proc (1) = _nardlResolveThresh(data, decomp_idx, d, thresh1, thresh2, caller);
    local ndecomp, out, ii;

    ndecomp = rows(decomp_idx);
    if type(d) == 6 and not _nardlIsUnset(d);
        if rows(d) == 1 and cols(d) == 1;
            out = d*ones(ndecomp, 1);
        elseif rows(d) == ndecomp and cols(d) == 1;
            out = d;
        elseif rows(d) == 1 and cols(d) == ndecomp;
            out = d';
        else;
            errorlog caller $+ ": d must be scalar or one value per decomposed variable";
            end;
        endif;
    elseif type(d) == 13;
        out = zeros(ndecomp, 1);
        ii = 1;
        do until ii > ndecomp;
            out[ii] = _nardlOneThresh(data, decomp_idx[ii], d, caller);
            ii = ii + 1;
        endo;
    elseif type(d) == 15;
        if rows(d) == 1 and cols(d) == 1;
            out = zeros(ndecomp, 1);
            ii = 1;
            do until ii > ndecomp;
                out[ii] = _nardlOneThresh(data, decomp_idx[ii], d[1], caller);
                ii = ii + 1;
            endo;
        elseif rows(d) == ndecomp or cols(d) == ndecomp;
            out = zeros(ndecomp, 1);
            ii = 1;
            do until ii > ndecomp;
                out[ii] = _nardlOneThresh(data, decomp_idx[ii], d[ii], caller);
                ii = ii + 1;
            endo;
        else;
            errorlog caller $+ ": string-array d must be scalar or one entry per decomposed variable";
            end;
        endif;
    else;
        errorlog caller $+ ": d must be numeric, \"inf\", \"mean\", or a string array";
        end;
    endif;

    if not _nardlIsUnset(thresh1);
        out[1] = _nardlOneThresh(data, decomp_idx[1], thresh1, caller);
    endif;
    if not _nardlIsUnset(thresh2);
        if ndecomp < 2;
            errorlog caller $+ ": thresh2 was supplied but fewer than two variables are decomposed";
            end;
        endif;
        out[2] = _nardlOneThresh(data, decomp_idx[2], thresh2, caller);
    endif;

    call _nardlValidateThreshVec(out, ndecomp, caller);
    retp(out);
endp;

proc (1) = _nardlOneThresh(data, xidx, spec, caller);
    local th_key;

    if type(spec) == 6;
        if rows(spec) == 1 and cols(spec) == 1 and not scalmiss(spec);
            retp(spec);
        endif;
        errorlog caller $+ ": threshold overrides must be numeric scalars";
        end;
    elseif type(spec) == 13;
        th_key = lower(spec);
        if th_key $== "inf" or th_key $== "infinity";
            retp(1e256);
        elseif th_key $== "mean";
            retp(_nardlMeanDiff(data, xidx));
        else;
            errorlog caller $+ ": threshold strings must be \"inf\" or \"mean\"";
            end;
        endif;
    endif;

    errorlog caller $+ ": threshold overrides must be numeric, \"inf\", or \"mean\"";
    end;
endp;

proc (1) = _nardlMeanDiff(data, xidx);
    local xx, dx;

    xx = data[., 1 + xidx];
    dx = xx[2:rows(xx)] - xx[1:rows(xx)-1];
    retp(meanc(dx));
endp;

proc (1) = _nardlUsesThresh(thresh);
    if type(thresh) == 6;
        retp(maxc(thresh .< 1e200));
    endif;
    retp(0);
endp;

proc (2) = _nardlOLSCov(X, resid, caller);
    local N, K, sigma2, invXX, cov;

    N = rows(X);
    K = cols(X);
    sigma2 = (resid'*resid) / (N - K);
    invXX = _qardlSafeInv(X'*X, caller, "OLS covariance moment matrix");
    cov = sigma2*invXX;

    retp(cov, sigma2);
endp;

proc (1) = _nardlLongRunCov(bt, coef_cov, ppp, qqq, k0);
    local G, denom, row, ii, jj, phi_start;

    phi_start = 2 + 2*k0;
    denom = 1 - sumc(bt[phi_start:phi_start+ppp-1]);
    G = zeros(2*k0, rows(bt));

    ii = 1;
    do until ii > k0;
        row = ii;
        G[row, 1+ii] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[row, phi_start+jj-1] = bt[1+ii] / (denom^2);
            jj = jj + 1;
        endo;

        row = k0 + ii;
        G[row, 1+k0+ii] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[row, phi_start+jj-1] = bt[1+k0+ii] / (denom^2);
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    retp(G*coef_cov*G');
endp;

proc (1) = _nardlLongRunSpecCov(bt, coef_cov, ppp, ndecomp, ncontrol);
    local G, denom, row, ii, jj;
    local theta_pos_start, theta_neg_start, theta_control_start, phi_start;

    theta_pos_start = 2;
    theta_neg_start = 2 + ndecomp;
    theta_control_start = 2 + 2*ndecomp;
    phi_start = theta_control_start + ncontrol;
    denom = 1 - sumc(bt[phi_start:phi_start+ppp-1]);
    G = zeros(2*ndecomp+ncontrol, rows(bt));

    ii = 1;
    do until ii > ndecomp;
        row = ii;
        G[row, theta_pos_start+ii-1] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[row, phi_start+jj-1] = bt[theta_pos_start+ii-1] / (denom^2);
            jj = jj + 1;
        endo;

        row = ndecomp + ii;
        G[row, theta_neg_start+ii-1] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[row, phi_start+jj-1] = bt[theta_neg_start+ii-1] / (denom^2);
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    ii = 1;
    do until ii > ncontrol;
        row = 2*ndecomp + ii;
        G[row, theta_control_start+ii-1] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[row, phi_start+jj-1] = bt[theta_control_start+ii-1] / (denom^2);
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    retp(G*coef_cov*G');
endp;

proc (2) = _nardlLongRunAsymmetry(beta_pos, beta_neg, bigbt_cov);
    local k0, wald, pv, ii, R, diff, V, param;

    k0 = rows(beta_pos);
    wald = zeros(k0, 1);
    pv = zeros(k0, 1);
    param = beta_pos | beta_neg;
    if rows(bigbt_cov) > rows(param);
        param = param | zeros(rows(bigbt_cov)-rows(param), 1);
    endif;

    ii = 1;
    do until ii > k0;
        R = zeros(1, rows(bigbt_cov));
        R[1, ii] = 1;
        R[1, k0+ii] = -1;
        diff = R*param;
        V = R*bigbt_cov*R';
        if V <= 1e-14;
            wald[ii] = 0;
            pv[ii] = 1;
        else;
            wald[ii] = (diff^2) / V;
            pv[ii] = cdfchic(wald[ii], 1);
        endif;
        ii = ii + 1;
    endo;

    retp(wald, pv);
endp;

proc (1) = _nardlNormalizeSymmetry(symmetry, caller);
    symmetry = lower(symmetry);

    if symmetry $== "none" or symmetry $== "";
        retp("none");
    elseif symmetry $== "srsr" or symmetry $== "short-run" or
           symmetry $== "short_run" or symmetry $== "short run";
        retp("SRSR");
    elseif symmetry $== "lrsr" or symmetry $== "long-run" or
           symmetry $== "long_run" or symmetry $== "long run";
        retp("LRSR");
    elseif symmetry $== "both" or symmetry $== "all";
        retp("both");
    endif;

    errorlog caller $+ ": symmetry must be 'none', 'SRSR', 'LRSR', or 'both'";
    end;
endp;

proc (1) = _nardlHasSRSR(symmetry);
    retp(symmetry $== "SRSR" or symmetry $== "both");
endp;

proc (1) = _nardlHasLRSR(symmetry);
    retp(symmetry $== "LRSR" or symmetry $== "both");
endp;

proc (5) = _nardlRestrictedOLS(Y, X, R, caller, design_label);
    local M, bt, fitted, resid, sigma2, coef_cov, A, adj, rnk;
    local N, K, df_eff;

    call _qardlCheckFullColumnRank(X, caller, design_label $+ " design matrix");
    M = _qardlSafeInv(X'*X, caller, design_label $+ " moment matrix");
    bt = M*X'*Y;
    coef_cov = M;
    rnk = 0;

    if not (rows(R) == 1 and cols(R) == 1 and scalmiss(R));
        rnk = rank(R);
        if rnk > 0;
            A = _qardlSafeInv(R*M*R', caller,
                              design_label $+ " restriction moment matrix");
            adj = M*R'*A*(R*bt);
            bt = bt - adj;
            coef_cov = M - M*R'*A*R*M;
        endif;
    endif;

    fitted = X*bt;
    resid = Y - fitted;
    N = rows(Y);
    K = cols(X);
    df_eff = N - (K - rnk);
    if df_eff <= 0;
        errorlog caller $+ ": insufficient degrees of freedom after symmetry restrictions";
        end;
    endif;
    sigma2 = (resid'*resid) / df_eff;
    coef_cov = sigma2*coef_cov;

    retp(bt, fitted, resid, coef_cov, sigma2);
endp;

proc (1) = _nardlAppendRestriction(R, row);
    if rows(R) == 1 and cols(R) == 1 and scalmiss(R);
        retp(row);
    endif;
    retp(R|row);
endp;

proc (1) = _nardlSymRestrLvl(ppp, q_decomp, ndecomp, ncontrol,
                             q_control, symmetry);
    local K, R, row, ii, jj, pos_start, neg_start;

    K = 1 + 2*ndecomp + ncontrol + ppp +
        2*q_decomp*ndecomp + q_control*ncontrol;
    R = error(0);

    if _nardlHasLRSR(symmetry);
        ii = 1;
        do until ii > ndecomp;
            row = zeros(1, K);
            row[1, 1+ii] = 1;
            row[1, 1+ndecomp+ii] = -1;
            R = _nardlAppendRestriction(R, row);
            ii = ii + 1;
        endo;
    endif;

    if _nardlHasSRSR(symmetry) and q_decomp > 0;
        pos_start = 2 + 2*ndecomp + ncontrol + ppp;
        neg_start = pos_start + q_decomp*ndecomp;
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                row = zeros(1, K);
                row[1, pos_start + (ii-1)*q_decomp + jj] = 1;
                row[1, neg_start + (ii-1)*q_decomp + jj] = -1;
                R = _nardlAppendRestriction(R, row);
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    retp(R);
endp;

proc (1) = _nardlSymRestrUECM(ppp, q_decomp, ndecomp, ncontrol,
                              q_control, case_id, symmetry);
    local det_cols, level_count, K, R, row, ii, jj, pos_start, neg_start;

    det_cols = _ardlDeterministicColumnCount(case_id);
    level_count = 1 + 2*ndecomp + ncontrol;
    K = det_cols + level_count + (ppp-1) +
        2*q_decomp*ndecomp + q_control*ncontrol;
    R = error(0);

    if _nardlHasLRSR(symmetry);
        pos_start = det_cols + 2;
        neg_start = pos_start + ndecomp;
        ii = 1;
        do until ii > ndecomp;
            row = zeros(1, K);
            row[1, pos_start + ii - 1] = 1;
            row[1, neg_start + ii - 1] = -1;
            R = _nardlAppendRestriction(R, row);
            ii = ii + 1;
        endo;
    endif;

    if _nardlHasSRSR(symmetry) and q_decomp > 0;
        pos_start = det_cols + level_count + (ppp-1) + 1;
        neg_start = pos_start + q_decomp*ndecomp;
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                row = zeros(1, K);
                row[1, pos_start + (ii-1)*q_decomp + jj] = 1;
                row[1, neg_start + (ii-1)*q_decomp + jj] = -1;
                R = _nardlAppendRestriction(R, row);
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    retp(R);
endp;

proc (1) = _nardlSymRestrECM(ppp, q_decomp, ndecomp, ncontrol,
                             q_control, case_id, symmetry);
    local det_cols, K, R, row, ii, jj, pos_start, neg_start;

    det_cols = _ardlDeterministicColumnCount(case_id);
    K = det_cols + 1 + (ppp-1) + 2*q_decomp*ndecomp + q_control*ncontrol;
    R = error(0);
    if _nardlHasSRSR(symmetry) and q_decomp > 0;
        pos_start = det_cols + 1 + (ppp-1) + 1;
        neg_start = pos_start + q_decomp*ndecomp;
        ii = 1;
        do until ii > ndecomp;
            jj = 0;
            do until jj > q_decomp-1;
                row = zeros(1, K);
                row[1, pos_start + (ii-1)*q_decomp + jj] = 1;
                row[1, neg_start + (ii-1)*q_decomp + jj] = -1;
                R = _nardlAppendRestriction(R, row);
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    retp(R);
endp;

proc (2) = _nardlShortRunAsymmetry(bt, coef_cov, ppp, qqq, k0);
    retp(_nardlShortRunAsymmetrySpec(bt, coef_cov, ppp, qqq, k0, 0));
endp;

proc (2) = _nardlShortRunAsymmetrySpec(bt, coef_cov, ppp, qqq, ndecomp, ncontrol);
    local wald, pv, ii, jj, R, diff, V, pos_start, neg_start;

    if qqq == 0;
        retp(error(0), error(0));
    endif;

    wald = zeros(ndecomp, 1);
    pv = zeros(ndecomp, 1);
    pos_start = 2 + 2*ndecomp + ncontrol + ppp;
    neg_start = pos_start + qqq*ndecomp;

    ii = 1;
    do until ii > ndecomp;
        R = zeros(1, rows(bt));
        jj = 1;
        do until jj > qqq;
            R[1, pos_start + (ii-1)*qqq + jj - 1] = 1;
            R[1, neg_start + (ii-1)*qqq + jj - 1] = -1;
            jj = jj + 1;
        endo;
        diff = R*bt;
        V = R*coef_cov*R';
        if V <= 1e-14;
            wald[ii] = 0;
            pv[ii] = 1;
        else;
            wald[ii] = (diff^2) / V;
            pv[ii] = cdfchic(wald[ii], 1);
        endif;
        ii = ii + 1;
    endo;

    retp(wald, pv);
endp;
