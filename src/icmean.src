#ifndef QARDL_SDF_INCLUDED
#include qardl.sdf
#endif

proc icmean(data, ppp, qqq, criterion = "bic");
    call _qardlValidateEstimatorInputs(data, ppp, qqq, { 0.5 }, "icmean");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "icmean");

    retp(_icmeanUnchecked(data, ppp, qqq, criterion, "icmean"));
endp;

proc _icmeanUnchecked(data, ppp, qqq, criterion, caller);
    local Y, ONEX, theta_start, phi_start, bt, uu, rh, ic;
    local qvec;

    qvec = qqq*ones(cols(data) - 1, 1);
    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);
    call _qardlCheckFullColumnRank(ONEX, caller, "information-criterion design matrix");

    bt = _qardlSafeInv(ONEX'*ONEX, caller, "information-criterion moment matrix")*ONEX'*Y;
    uu = Y - ONEX*bt;
    rh = uu^2;

    ic = _qardlInformationCriterion(meanc(rh), rows(Y), cols(ONEX), criterion);

    retp(ic);
endp;

proc (1) = pqSelect(data, pend = 8, qend = 8, pstart = 1, qstart = 0,
                    criterion = "bic", q_mode = "scalar", return_type = "best",
                    gets_pval = 0.1);

    local mode, out, pst, qst, icgrid, lst, k0;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqSelect");
    call _qardlValidateLagRange(pstart, pend, "pqSelect: pstart/pend");
    call _qardlValidateLagRangeZero(qstart, qend, "pqSelect: qstart/qend");
    call _qardlValidateGETSPValue(gets_pval, "pqSelect");

    criterion = lower(criterion);
    mode = _pqSelectNormalizeQMode(q_mode, "pqSelect");
    out = _pqSelectNormalizeOutput(return_type, "pqSelect");

    if mode $== "scalar" and out $== "best";
        call _qardlValidateSelectionCriterion(criterion, "pqSelect");

        if _qardlCriterionIsGETS(criterion);
            { pst, qst } = _qardlGETSLagOrderSearch(data, pstart, pend,
                                                    qstart, qend,
                                                    gets_pval, "pqSelect");
        else;
            { pst, qst } = _qardlLagOrderSearch(data, pstart, pend, qstart,
                                                qend, criterion);
        endif;

        retp(pst~qst);
    endif;

    call _qardlValidateICCriterion(criterion, "pqSelect");

    if mode $== "scalar";
        icgrid = _qardlLagOrderGrid(data, pstart, pend, qstart, qend,
                                    criterion);
        if out $== "grid";
            retp(icgrid);
        endif;

        lst = minindc(icgrid[., 3]);
        retp(icgrid[lst, 1:2]);
    endif;

    k0 = cols(data) - 1;
    icgrid = _qardlLagOrderGridX(data, pstart, pend, qend, criterion);
    icgrid = _pqSelectFilterXGrid(icgrid, qstart, k0);

    if out $== "grid";
        retp(icgrid);
    endif;

    lst = minindc(icgrid[., cols(icgrid)]);
    retp(icgrid[lst, 1:1+k0]);
endp;

proc (2) = pqorder(data, pend = 8, qend = 8, criterion = "bic",
                   gets_pval = 0.1);

    local pst, qst;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorder");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "pqorder");
    call _qardlValidateGETSPValue(gets_pval, "pqorder");

    if _qardlCriterionIsGETS(criterion);
        { pst, qst } = _qardlGETSLagOrderSearch(data, 1, pend, 0, qend,
                                                gets_pval, "pqorder");
    else;
        { pst, qst } = _qardlLagOrderSearch(data, 1, pend, 0, qend, criterion);
    endif;

    retp(pst, qst);
endp;

proc icmeanX(data, ppp, qvec, criterion = "bic");
    local k0;

    call _qardlValidateEstimatorInputs(data, ppp, 0, { 0.5 }, "icmeanX");
    k0 = cols(data) - 1;
    qvec = _qardlNormalizeQVector(qvec, k0, "icmeanX: qvec");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "icmeanX");

    retp(_icmeanXUnchecked(data, ppp, qvec, criterion, "icmeanX"));
endp;

proc _icmeanXUnchecked(data, ppp, qvec, criterion, caller);
    local Y, ONEX, theta_start, phi_start, bt, uu, rh, ic;

    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);
    call _qardlCheckFullColumnRank(ONEX, caller, "information-criterion design matrix");

    bt = _qardlSafeInv(ONEX'*ONEX, caller, "information-criterion moment matrix")*ONEX'*Y;
    uu = Y - ONEX*bt;
    rh = uu^2;

    ic = _qardlInformationCriterion(meanc(rh), rows(Y), cols(ONEX), criterion);

    retp(ic);
endp;

proc (2) = pqorderX(data, pend = 8, qend = 8, criterion = "bic");
    local icgrid, lst, pst, qst, k0;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorderX");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "pqorderX");

    k0 = cols(data) - 1;
    icgrid = _qardlLagOrderGridX(data, 1, pend, qend, criterion);
    lst = minindc(icgrid[., cols(icgrid)]);
    pst = icgrid[lst, 1];
    qst = icgrid[lst, 2:1+k0]';

    retp(pst, qst);
endp;

proc (1) = pqorderXGrid(data, pend = 8, qend = 8, criterion = "bic");
    local icgrid;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorderXGrid");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "pqorderXGrid");

    icgrid = _qardlLagOrderGridX(data, 1, pend, qend, criterion);
    retp(icgrid);
endp;

proc (1) = pqorderGrid(data, pend = 8, qend = 8, criterion = "bic");

    local icgrid;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorderGrid");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "pqorderGrid");

    icgrid = _qardlLagOrderGrid(data, 1, pend, 0, qend, criterion);

    retp(icgrid);
endp;

proc (2) = pqorderRange(data, pstart, pend, qstart, qend, criterion,
                        gets_pval = 0.1);

    local pst, qst;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorderRange");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "pqorderRange");
    call _qardlValidateGETSPValue(gets_pval, "pqorderRange");
    call _qardlValidateLagRange(pstart, pend, "pqorder: pstart/pend");
    call _qardlValidateLagRangeZero(qstart, qend, "pqorder: qstart/qend");

    if _qardlCriterionIsGETS(criterion);
        { pst, qst } = _qardlGETSLagOrderSearch(data, pstart, pend, qstart,
                                                qend, gets_pval, "pqorderRange");
    else;
        { pst, qst } = _qardlLagOrderSearch(data, pstart, pend, qstart, qend, criterion);
    endif;

    retp(pst, qst);
endp;

proc (1) = pqorderRangeGrid(data, pstart, pend, qstart, qend, criterion);

    local icgrid;

    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "pqorderRangeGrid");
    criterion = lower(criterion);
    call _qardlValidateICCriterion(criterion, "pqorderRangeGrid");
    call _qardlValidateLagRange(pstart, pend, "pqorderRangeGrid: pstart/pend");
    call _qardlValidateLagRangeZero(qstart, qend, "pqorderRangeGrid: qstart/qend");

    icgrid = _qardlLagOrderGrid(data, pstart, pend, qstart, qend, criterion);

    retp(icgrid);
endp;

proc (2) = _qardlLagOrderSearch(data, pstart, pend, qstart, qend, criterion);

    local icgrid, lst, pst, qst;

    icgrid = _qardlLagOrderGrid(data, pstart, pend, qstart, qend, criterion);

    lst = minindc(icgrid[., 3]);
    pst = icgrid[lst, 1];
    qst = icgrid[lst, 2];

    retp(pst, qst);
endp;

proc (2) = _qardlGETSLagOrderSearch(data, pstart, pend, qstart, qend,
                                    gets_pval, caller);
    local pst, qst, p_pv, q_pv;

    pst = pend;
    qst = qend;

    do while 1;
        p_pv = -1;
        q_pv = -1;

        if pst > pstart;
            p_pv = _qardlGETSBoundaryPValue(data, pst, qst, 1, caller);
        endif;
        if qst > qstart;
            q_pv = _qardlGETSBoundaryPValue(data, pst, qst, 0, caller);
        endif;

        if p_pv <= gets_pval and q_pv <= gets_pval;
            break;
        endif;

        if p_pv >= q_pv and p_pv > gets_pval;
            pst = pst - 1;
        elseif q_pv > gets_pval;
            qst = qst - 1;
        else;
            break;
        endif;
    endo;

    retp(pst, qst);
endp;

proc (1) = _qardlGETSBoundaryPValue(data, ppp, qqq, is_p_lag, caller);
    local k0, qvec, Y, ONEX, theta_start, phi_start, test_cols, ii;

    k0 = cols(data) - 1;
    qvec = qqq*ones(k0, 1);
    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);

    if is_p_lag;
        test_cols = phi_start + ppp - 1;
    else;
        test_cols = zeros(k0, 1);
        ii = 1;
        do until ii > k0;
            test_cols[ii] = 2 + (ii - 1)*qqq + qqq - 1;
            ii = ii + 1;
        endo;
    endif;

    retp(_qardlGETSWaldPValue(Y, ONEX, test_cols, caller));
endp;

proc (1) = _qardlGETSWaldPValue(Y, ONEX, test_cols, caller);
    local bt, resid, coef_cov, sigma2, b, sub_cov, wald, df;

    call _qardlCheckFullColumnRank(ONEX, caller, "GETS design matrix");
    bt = _qardlSafeInv(ONEX'*ONEX, caller, "GETS moment matrix")*ONEX'*Y;
    resid = Y - ONEX*bt;
    { coef_cov, sigma2 } = _ardlOLSCov(ONEX, resid, caller);

    b = bt[test_cols];
    sub_cov = coef_cov[test_cols, test_cols];
    df = rows(test_cols);
    wald = b' * _qardlSafeInv(sub_cov, caller, "GETS Wald covariance") * b;

    retp(cdfchic(wald, df));
endp;

proc (1) = _qardlLagOrderGrid(data, pstart, pend, qstart, qend, criterion);

    local icgrid, jj1, jj2, idx, pgrid, qgrid, num_p, num_q;

    pgrid = seqa(pstart, 1, pend - pstart + 1);
    qgrid = seqa(qstart, 1, qend - qstart + 1);
    num_p = rows(pgrid);
    num_q = rows(qgrid);

    /* Information criterion computation */
    icgrid = zeros(num_p*num_q, 3);
    jj1 = 1;
    do until jj1 > num_p;
        jj2 = 1;
        do until jj2 > num_q;
            idx = num_q*(jj1-1)+jj2;
            icgrid[idx, 1] = pgrid[jj1];
            icgrid[idx, 2] = qgrid[jj2];
            icgrid[idx, 3] = _icmeanUnchecked(data, pgrid[jj1], qgrid[jj2], criterion, "pqorderGrid");
            jj2 = jj2 + 1;
        endo;
        jj1 = jj1 + 1;
    endo;

    retp(icgrid);
endp;

proc (1) = _qardlLagOrderGridX(data, pstart, pend, qend, criterion);
    local k0, num_p, num_qvec, num_rows, icgrid, idx, pp, qqidx, qvec;

    k0 = cols(data) - 1;
    num_p = pend - pstart + 1;
    num_qvec = (qend + 1)^k0;
    num_rows = num_p*num_qvec;
    icgrid = zeros(num_rows, k0 + 2);

    idx = 1;
    pp = pstart;
    do until pp > pend;
        qqidx = 0;
        do until qqidx > num_qvec - 1;
            qvec = _qardlQVectorFromIndex(qqidx, k0, qend);
            icgrid[idx, 1] = pp;
            icgrid[idx, 2:1+k0] = qvec';
            icgrid[idx, k0+2] = _icmeanXUnchecked(data, pp, qvec, criterion, "pqorderXGrid");
            idx = idx + 1;
            qqidx = qqidx + 1;
        endo;
        pp = pp + 1;
    endo;

    retp(icgrid);
endp;

proc (1) = _qardlQVectorFromIndex(idx, k0, qend);
    local qvec, base, rem, ii, basepow;

    qvec = zeros(k0, 1);
    base = qend + 1;
    rem = idx;
    ii = 1;
    do until ii > k0;
        basepow = base^(ii-1);
        qvec[ii] = floor(rem/basepow) - base*floor(rem/(basepow*base));
        ii = ii + 1;
    endo;

    retp(qvec);
endp;

proc (1) = _pqSelectNormalizeQMode(q_mode, caller);
    q_mode = lower(q_mode);

    if q_mode $== "scalar" or q_mode $== "uniform";
        retp("scalar");
    endif;

    if q_mode $== "vector" or q_mode $== "x" or
       q_mode $== "per-regressor" or q_mode $== "per_regressor";
        retp("vector");
    endif;

    errorlog caller $+ ": q_mode must be \"scalar\" or \"vector\"";
    end;
endp;

proc (1) = _pqSelectNormalizeOutput(output_type, caller);
    output_type = lower(output_type);

    if output_type $== "best" or output_type $== "selected";
        retp("best");
    endif;

    if output_type $== "grid" or output_type $== "table";
        retp("grid");
    endif;

    errorlog caller $+ ": return_type must be \"best\" or \"grid\"";
    end;
endp;

proc (1) = _pqSelectFilterXGrid(icgrid, qstart, k0);
    local out, ii, keep;

    if qstart <= 0;
        retp(icgrid);
    endif;

    out = zeros(rows(icgrid), cols(icgrid));
    keep = 0;
    ii = 1;
    do until ii > rows(icgrid);
        if minc(icgrid[ii, 2:1+k0]') >= qstart;
            keep = keep + 1;
            out[keep, .] = icgrid[ii, .];
        endif;
        ii = ii + 1;
    endo;

    if keep == 0;
        errorlog "pqSelect: qstart/qend leaves no vector-lag grid rows";
        end;
    endif;

    retp(out[1:keep, .]);
endp;

proc (1) = _qardlInformationCriterion(sigma2, nobs, nparam, criterion);
    local ic;

    if criterion $== "aic";
        ic = nobs*ln(sigma2) + 2*nparam;
    elseif criterion $== "hq" or criterion $== "hqc";
        ic = nobs*ln(sigma2) + 2*nparam*ln(ln(nobs));
    else;
        ic = nobs*ln(sigma2) + nparam*ln(nobs);
    endif;

    retp(ic);
endp;

proc (0) = _qardlValidateICCriterion(criterion, caller);
    if not (criterion $== "aic" or criterion $== "bic" or criterion $== "hq" or criterion $== "hqc");
        errorlog caller $+ ": criterion must be \"aic\", \"bic\", \"hq\", or \"hqc\"";
        end;
    endif;
endp;

proc (0) = _qardlValidateSelectionCriterion(criterion, caller);
    if not (criterion $== "aic" or criterion $== "bic" or criterion $== "hq" or
            criterion $== "hqc" or criterion $== "gets");
        errorlog caller $+ ": criterion must be \"aic\", \"bic\", \"hq\", \"hqc\", or \"gets\"";
        end;
    endif;
endp;

proc (1) = _qardlCriterionIsGETS(criterion);
    retp(criterion $== "gets");
endp;

proc (0) = _qardlValidateGETSPValue(gets_pval, caller);
    if rows(gets_pval)*cols(gets_pval) /= 1 or gets_pval <= 0 or gets_pval >= 1;
        errorlog caller $+ ": gets_pval must be a scalar between 0 and 1";
        end;
    endif;
endp;

proc (0) = _qardlValidateLagRange(lag_start, lag_end, label);
    call _qardlValidateLagScalar(lag_start, label $+ " start");
    call _qardlValidateLagScalar(lag_end, label $+ " end");

    if lag_start > lag_end;
        errorlog label $+ " start must be less than or equal to end";
        end;
    endif;
endp;

proc (0) = _qardlValidateLagRangeZero(lag_start, lag_end, label);
    call _qardlValidateLagScalarZero(lag_start, label $+ " start");
    call _qardlValidateLagScalarZero(lag_end, label $+ " end");

    if lag_start > lag_end;
        errorlog label $+ " start must be less than or equal to end";
        end;
    endif;
endp;
