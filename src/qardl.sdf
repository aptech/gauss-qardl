#ifndef QARDL_SDF_INCLUDED
#define QARDL_SDF_INCLUDED

struct ardlOut {
    // Standardized model metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;

    // Row-index sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;

    // Lag orders used in estimation
    scalar p;
    scalar q;

    // Per-regressor distributed-lag orders
    matrix qvec;

    // Effective estimation sample size after lag alignment
    scalar nobs;

    // Number of regressors
    scalar k;

    // Numerical diagnostics for the estimation design matrix
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // Long-run parameter
    matrix bigbt;

    // Delta-method covariance of long-run parameter
    matrix bigbt_cov;

    // Short-run autoregressive parameters
    matrix phi;

    // Covariance of short-run phi
    matrix phi_cov;

    // Current x-level coefficients before long-run normalization
    matrix gamma;

    // Covariance of gamma/theta parameters
    matrix gamma_cov;

    // Differenced-x lag coefficients, if q > 0
    matrix dx_coef;

    // Intercept and speed of adjustment rho = -(1 - sum_j phi_j)
    matrix alpha;
    matrix rho;

    // Full OLS coefficient vector from the levels estimator
    matrix bt;

    // In-sample diagnostics
    matrix fitted;
    matrix resid;
    scalar sigma2;
    matrix coef_cov;
};

struct ardlECMOut {
    // Standardized model metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;
    string ecm_type;

    // Row-index sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;

    // Lag orders used in estimation
    scalar p;
    scalar q;

    // Per-regressor distributed-lag orders
    matrix qvec;

    // Effective ECM estimation sample size
    scalar nobs;

    // Number of regressors
    scalar k;

    // Numerical diagnostics for the ECM design matrix
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // Long-run coefficients used by or derived from the ECM
    matrix beta_lr;

    // Implied levels-form OLS speed of adjustment
    matrix rho_ols;

    // ECM intercept and speed-of-adjustment coefficient
    matrix alpha;
    matrix rho;

    // Scalar covariance entries for alpha and rho
    matrix alpha_cov;
    matrix rho_cov;

    // Full OLS coefficient vector from the ECM equation
    matrix bt;

    // In-sample diagnostics
    matrix fitted;
    matrix resid;
    scalar sigma2;
    matrix coef_cov;
};

struct ardlSelectOut {
    // Standardized selector metadata
    string model_family;
    string selection_criterion;
    string q_mode;
    string return_type;

    // Search bounds
    scalar pmax;
    scalar qmax;
    scalar pstart;
    scalar qstart;
    scalar cs_lags;
    scalar gets_pval;

    // Selected lag orders
    scalar pst;
    scalar qst;

    // Per-regressor q-vector. For scalar selection, all entries equal qst.
    matrix qvec;

    // Information-criterion grid when available/requested.
    // Scalar grids use [p, q, IC]; vector grids use [p, q1, ..., qk, IC].
    matrix grid;
};

struct qardlOut {
    // Standardized model metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;
    string ecm_type;

    // Row-index sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;

    // Quantile vector used in estimation
    matrix tau;

    // Lag orders used in estimation
    scalar p;
    scalar q;

    // Per-regressor distributed-lag orders. For qardl(), all entries equal q.
    // For qardlX(), this stores the heterogeneous q vector needed downstream.
    matrix qvec;

    // Effective estimation sample size after lag alignment
    scalar nobs;

    // Number of regressors
    scalar k;

    // Numerical diagnostics for the estimation design matrix
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // Long-run parameter
    matrix bigbt;

    // Covariance of long-run parameter
    matrix bigbt_cov;

    // Short-run phi
    matrix phi;

    // Covariance of short-run phi
    matrix phi_cov;

    // Short-run gamma
    matrix gamma;

    // Short-run gamma covariance
    matrix gamma_cov;

    // Intercept alpha(tau) at each quantile (ss x 1)
    matrix alpha;

    // ECM speed of adjustment rho(tau) = -(1 - sum_j phi_j(tau)) at each quantile (ss x 1)
    matrix rho;

    // Full coefficient matrix from quantileFit: ((1+q*k+k+p) x ss)
    // Row 1: intercept; rows 2:1+q*k: delta-x (gamma) coefficients;
    // rows 2+q*k:1+(q+1)*k: x-level (theta) coefficients;
    // rows 2+(q+1)*k:1+(q+1)*k+p: phi (lagged-y) coefficients
    matrix bt;

    // In-sample diagnostics
    matrix fitted;
    matrix resid;
};

struct qardlECMOut {
    // Standardized model metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;
    string ecm_type;

    // Row-index sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;

    // Quantile vector used in estimation
    matrix tau;

    // Lag orders used in estimation
    scalar p;
    scalar q;

    // Per-regressor distributed-lag orders
    matrix qvec;

    // Effective ECM sample size after lag alignment
    scalar nobs;

    // Number of regressors
    scalar k;

    // Numerical diagnostics for the ECM design matrix
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // OLS long-run coefficients used to construct the error correction term (k x 1)
    matrix beta_lr;

    // OLS speed of adjustment -(1 - sum_j phi_j^OLS), scalar stored as 1x1 matrix
    matrix rho_ols;

    // Intercept alpha(tau) from ECM quantile regression (ss x 1)
    matrix alpha;

    // Speed of adjustment rho(tau) from ECM quantile regression (ss x 1)
    matrix rho;

    // Asymptotic covariance of rho estimates across quantiles (ss x ss)
    matrix rho_cov;

    // Asymptotic covariance of alpha estimates across quantiles (ss x ss)
    matrix alpha_cov;

    // Full ECM coefficient matrix and in-sample diagnostics
    matrix bt;
    matrix fitted;
    matrix resid;
};


/*
** ardlFullOut -- returned by ardlFull().
** Bundles lag-order selection, bounds test, and levels-form ARDL.
*/
struct ardlFullOut {
    // Standardized workflow metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;

    // Search bounds and row-index sample metadata
    scalar pmax;
    scalar qmax;
    scalar sample_start;
    scalar sample_end;

    // Lag orders selected by the requested information criterion
    scalar pst;
    scalar qst;

    // Number of observations in the input sample
    scalar nobs;

    // ARDL bounds test (Pesaran, Shin & Smith 2001)
    scalar ardl_fstat;
    matrix ardl_cv;

    // ARDL levels estimates
    struct ardlOut ar;
};

struct ardlAutoCaseOut {
    // Standardized workflow metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string deterministic;
    string covariance_type;
    string selection_criterion;
    string gets_mode;

    // Search settings and selected lag orders
    scalar pmax;
    scalar qmax;
    scalar pst;
    scalar qst;
    scalar gets_pval;

    // Sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar nobs;

    // Auto-case selection metadata
    scalar primary_case;
    scalar case_count;
    matrix case_ids;
    matrix deterministic_coef;
    matrix deterministic_pv;
    matrix sparse_keep_cols;
    matrix sparse_bt;
    matrix sparse_coef_cov;
    matrix sparse_fitted;
    matrix sparse_resid;
    scalar sparse_sigma2;

    // Rows: [case_id, Fstat, tstat, q_restrict, cv10_I0, cv10_I1,
    //        cv5_I0, cv5_I1, cv1_I0, cv1_I1]
    matrix bounds_table;

    // Nested estimates
    struct ardlOut ar;
    struct ardlECMOut ecm;
};

struct ardlSparseGETSOut {
    // Standardized workflow metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string array decomp_vars;
    string array control_vars;
    string deterministic;
    string covariance_type;
    string selection_criterion;

    // Search/settings metadata
    scalar p;
    scalar q;
    scalar q_control;
    scalar gets_pval;
    scalar case_id;
    scalar primary_case;
    scalar case_count;
    matrix case_ids;

    // Sample/design metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;
    scalar nobs;
    scalar k;
    scalar ndecomp;
    scalar ncontrol;
    matrix decomp_indices;
    matrix control_indices;
    matrix decomp_thresholds;
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // Sparse GETS selection metadata
    string array term_labels;
    matrix keep_cols;
    matrix dropped_cols;
    scalar n_kept;
    scalar n_dropped;
    matrix deterministic_coef;
    matrix deterministic_pv;

    // Sparse Case V UECM fit
    matrix bt;
    matrix coef_cov;
    matrix fitted;
    matrix resid;
    scalar sigma2;
};

struct nardlOut {
    // Standardized model metadata
    string model_family;
    string formula;
    string depvar;
    string array xvars;
    string array decomp_vars;
    string array control_vars;
    string deterministic;
    string covariance_type;
    string selection_criterion;
    string ecm_type;
    string symmetry_restriction;

    // Row-index sample metadata
    scalar sample_start;
    scalar sample_end;
    scalar estimation_start;
    scalar estimation_end;

    // Lag orders used in estimation
    scalar p;
    scalar q;
    scalar q_control;

    // Per-regressor distributed-lag orders, in xvars order
    matrix qvec;
    matrix control_qvec;

    // Effective estimation sample size after lag alignment
    scalar nobs;

    // Number of original regressors, decomposed variables, and controls
    scalar k;
    scalar ndecomp;
    scalar ncontrol;
    matrix decomp_indices;
    matrix control_indices;
    matrix decomp_thresholds;

    // Numerical diagnostics for the estimation design matrix
    scalar design_rank;
    scalar design_cols;
    scalar design_condition;

    // Long-run parameters stacked [beta_pos; beta_neg; beta_control]
    matrix bigbt;

    // Delta-method covariance of the long-run parameter
    matrix bigbt_cov;

    // Short-run autoregressive parameters
    matrix phi;

    // Covariance of short-run phi
    matrix phi_cov;

    // Positive and negative level coefficients stacked [theta_pos; theta_neg]
    matrix gamma;

    // Covariance of gamma/theta parameters
    matrix gamma_cov;

    // Intercept
    matrix alpha;

    // Speed of adjustment rho = -(1 - sum_j phi_j)
    matrix rho;

    // Full coefficient vector from the levels estimator
    matrix bt;

    // Model-specific long-run positive partial-sum coefficients
    matrix beta_pos;

    // Model-specific long-run negative partial-sum coefficients
    matrix beta_neg;

    // Model-specific long-run coefficients for linear controls
    matrix beta_control;

    // Model-specific level coefficients before long-run normalization
    matrix theta_pos;
    matrix theta_neg;
    matrix theta_control;

    // Long-run nonlinear asymmetry tests, one row per original regressor
    matrix asymmetry_wald;
    matrix asymmetry_pv;

    // Short-run nonlinear asymmetry tests, one row per original regressor
    matrix short_run_wald;
    matrix short_run_pv;

    // UECM bounds F-statistic for y(-1), x_pos(-1), x_neg(-1)
    scalar bounds_fstat;

    // In-sample diagnostics
    matrix fitted;
    matrix resid;
    scalar sigma2;
    matrix coef_cov;
};

