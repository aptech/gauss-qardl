#ifndef QARDL_SDF_INCLUDED
#include qardl.sdf
#endif

/*
**> qardl
**
**  Purpose:    Perform QARDL estimation
**
**  Format:     qOut = qardl(data, ppp, qqq);
**              qOut = qardl(data, ppp, qqq, tau);
**              qOut = qardl(data, ppp, qqq, tau, cov_type, hac_lags, print_results);
**
**  Input:
**              data:   (n *(1+k)) matrix, where the 1st column is the dependent variable,
**                      and the last k columns are explanatory variables.
**
**              ppp     p value of QARDL(p, q) model;
**
**
**              qqq     q value of QARDL(p, q) model;
**
**              tau     (s * 1) vector of quantiles, which is sorted
**                      from the smallest to the largest.
**
**              cov_type string, covariance estimator: "iid" (default),
**                      "robust", or "hac".
**
**              hac_lags scalar, non-negative HAC lag truncation. If cov_type
**                      is "hac" and hac_lags = 0, a Newey-West automatic
**                      bandwidth floor(4*(T/100)^(2/9)) is used.

**  Output:     qOut            An instance of the qardlOut structure. The structure qOut contains
**                              the following members:
**
**                  qOut.bigbt           Matrix, long-run parameter.
**
**                  qOut.bigbt_cov       Matrix, covariance of the long-run parameter.
**
**                  qOut.phi             Matrix, short-run parameter.
**
**                  qOut.phi_cov         Matrix, covariance of the short-run parameter.
**
**                  qOut.gamma           Matrix, short-run parameter.
**
**                  qOut.gamma_cov       Matrix, covariance of the short-run parameter.
**
**    Developed:    October 10, 2013
**                  Jin Seo Cho
*/

/*
**> ardl
**
**  Purpose:    Perform levels-form ARDL estimation by OLS.
**
**  Format:     arOut = ardl(data, ppp, qqq);
**              arOut = ardl(data, ppp, qqq, formula, print_results);
**
**  Input:      data    (n x (1+k)) matrix or dataframe. Matrix order is
**                      [y, x1, x2, ...].
**              ppp     scalar AR lag order.
**              qqq     scalar distributed-lag order.
**              formula optional formula string "y ~ x1 + x2".
**
**  Output:     arOut   struct ardlOut.
*/
proc (struct ardlOut) = ardl(data, ppp, qqq, formula = "", print_results = 1);
    local Y, ONEX, theta_start, phi_start, qvec, k0, bt, fitted, resid;
    local coef_cov, sigma2, theta, phi, denom, bigbt, bigbt_cov;
    local dx_count, dx_coef, gamma_cov, phi_cov, depvar, xvars;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyQARDLFormula(data, formula);
    call _qardlValidateEstimatorInputs(data, ppp, qqq, { 0.5 }, "ardl");

    k0 = cols(data) - 1;
    qvec = qqq*ones(k0, 1);
    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);
    call _qardlCheckFullColumnRank(ONEX, "ardl", "levels design matrix");

    bt = _qardlSafeInv(ONEX'*ONEX, "ardl", "levels moment matrix")*ONEX'*Y;
    fitted = ONEX*bt;
    resid = Y - fitted;
    { coef_cov, sigma2 } = _ardlOLSCov(ONEX, resid, "ardl");

    theta = bt[theta_start:theta_start+k0-1];
    phi = bt[phi_start:phi_start+ppp-1];
    denom = 1 - sumc(phi);
    bigbt = theta ./ denom;
    bigbt_cov = _ardlLongRunCov(bt, coef_cov, theta_start, phi_start, k0, ppp);
    phi_cov = coef_cov[phi_start:phi_start+ppp-1, phi_start:phi_start+ppp-1];
    gamma_cov = coef_cov[theta_start:theta_start+k0-1, theta_start:theta_start+k0-1];

    dx_count = theta_start - 2;
    if dx_count > 0;
        dx_coef = bt[2:theta_start-1];
    else;
        dx_coef = error(0);
    endif;

    struct ardlOut arOut;
    arOut.model_family = "ARDL";
    arOut.formula = formula;
    arOut.depvar = depvar;
    arOut.xvars = xvars;
    arOut.deterministic = "constant";
    arOut.covariance_type = "ols";
    arOut.selection_criterion = "none";
    arOut.sample_start = 1;
    arOut.sample_end = rows(data);
    arOut.estimation_start = rows(data) - rows(Y) + 1;
    arOut.estimation_end = rows(data);
    arOut.p = ppp;
    arOut.q = qqq;
    arOut.qvec = qvec;
    arOut.nobs = rows(Y);
    arOut.k = k0;
    arOut.design_rank = rank(ONEX);
    arOut.design_cols = cols(ONEX);
    arOut.design_condition = sqrt(_qardlConditionNumber(ONEX'ONEX));
    arOut.bigbt = bigbt;
    arOut.bigbt_cov = bigbt_cov;
    arOut.phi = phi;
    arOut.phi_cov = phi_cov;
    arOut.gamma = theta;
    arOut.gamma_cov = gamma_cov;
    arOut.dx_coef = dx_coef;
    arOut.alpha = bt[1];
    arOut.rho = -denom;
    arOut.bt = bt;
    arOut.fitted = fitted;
    arOut.resid = resid;
    arOut.sigma2 = sigma2;
    arOut.coef_cov = coef_cov;

    if print_results;
        call printARDL(arOut);
    endif;

    retp(arOut);
endp;

/*
**> ardlECM
**
**  Purpose:    Estimate ARDL error-correction models by OLS. The default
**              two-step estimator uses levels-form ARDL long-run coefficients
**              to construct the lagged error-correction term. Set
**              ecm_type = "uecm" to estimate the unrestricted ECM directly.
**
**  Format:     arECMOut = ardlECM(data, ppp, qqq);
**              arECMOut = ardlECM(data, ppp, qqq, formula, print_results);
**              arECMOut = ardlECM(data, ppp, qqq, formula, print_results,
**                                 ecm_type, case_id);
*/
proc (struct ardlECMOut) = ardlECM(data, ppp, qqq, formula = "",
                                   print_results = 1, ecm_type = "two-step",
                                   case_id = 3);
    local depvar, xvars, qvec, k0, det_cols, rho_pos, x_lag_start;
    local Y_ecm, ONEX_ecm, bt_ecm, fitted, resid, coef_cov, sigma2;
    local beta_lr_ecm;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyQARDLFormula(data, formula);
    call _qardlValidateEstimatorInputs(data, ppp, qqq, { 0.5 }, "ardlECM");
    ecm_type = _ardlNormalizeECMType(ecm_type, "ardlECM", 0);
    call _ardlValidateCaseID(case_id, "ardlECM");
    call _ardlValidateECMCase(ecm_type, case_id, "ardlECM");

    k0 = cols(data) - 1;
    qvec = qqq*ones(k0, 1);
    det_cols = _ardlDeterministicColumnCount(case_id);
    rho_pos = det_cols + 1;
    x_lag_start = rho_pos + 1;

    struct ardlOut arOut;
    arOut = ardl(data, ppp, qqq, "", 0);

    { Y_ecm, ONEX_ecm } =
        _ardlBuildECMDesignX(data, ppp, qvec, arOut.bigbt, ecm_type, case_id);
    call _qardlCheckFullColumnRank(ONEX_ecm, "ardlECM", "ECM design matrix");

    bt_ecm = _qardlSafeInv(ONEX_ecm'*ONEX_ecm, "ardlECM", "ECM moment matrix")*ONEX_ecm'*Y_ecm;
    fitted = ONEX_ecm*bt_ecm;
    resid = Y_ecm - fitted;
    { coef_cov, sigma2 } = _ardlOLSCov(ONEX_ecm, resid, "ardlECM");

    if ecm_type $== "uecm";
        beta_lr_ecm = _ardlLongRunFromUECM(bt_ecm, rho_pos, x_lag_start, k0);
    else;
        beta_lr_ecm = arOut.bigbt;
    endif;

    struct ardlECMOut arECMOut;
    arECMOut.model_family = "ARDL-ECM";
    arECMOut.formula = formula;
    arECMOut.depvar = depvar;
    arECMOut.xvars = xvars;
    arECMOut.deterministic = _ardlDeterministicLabel(case_id);
    arECMOut.covariance_type = "ols";
    arECMOut.selection_criterion = "none";
    arECMOut.ecm_type = ecm_type;
    arECMOut.sample_start = 1;
    arECMOut.sample_end = rows(data);
    arECMOut.estimation_start = rows(data) - rows(Y_ecm) + 1;
    arECMOut.estimation_end = rows(data);
    arECMOut.p = ppp;
    arECMOut.q = qqq;
    arECMOut.qvec = qvec;
    arECMOut.nobs = rows(Y_ecm);
    arECMOut.k = k0;
    arECMOut.design_rank = rank(ONEX_ecm);
    arECMOut.design_cols = cols(ONEX_ecm);
    arECMOut.design_condition = sqrt(_qardlConditionNumber(ONEX_ecm'ONEX_ecm));
    arECMOut.beta_lr = beta_lr_ecm;
    arECMOut.rho_ols = arOut.rho;
    if det_cols >= 1;
        arECMOut.alpha = bt_ecm[1];
        arECMOut.alpha_cov = coef_cov[1, 1];
    else;
        arECMOut.alpha = 0;
        arECMOut.alpha_cov = 0;
    endif;
    arECMOut.rho = bt_ecm[rho_pos];
    arECMOut.rho_cov = coef_cov[rho_pos, rho_pos];
    arECMOut.bt = bt_ecm;
    arECMOut.fitted = fitted;
    arECMOut.resid = resid;
    arECMOut.sigma2 = sigma2;
    arECMOut.coef_cov = coef_cov;

    if print_results;
        call printARDLECM(arECMOut);
    endif;

    retp(arECMOut);
endp;

/*
**> ardlFull
**
**  Purpose:    Integrated ARDL workflow: lag selection, ARDL bounds test, and
**              levels-form ARDL estimation.
**
**  Format:     afOut = ardlFull(data);
**              afOut = ardlFull(data, pend, qend);
**              afOut = ardlFull(data, pend, qend, formula, verbose, criterion,
**                               gets_pval, case_id, print_diagnostics);
**
**  Note:       If omitted, pend and qend default to 8.
*/
proc (struct ardlFullOut) = ardlFull(data, pend = 8, qend = 8, formula = "",
                                     verbose = 1, criterion = "bic",
                                     gets_pval = 0.1, case_id = 3,
                                     print_diagnostics = -1);
    local pst, qst, fstat, cv, depvar, xvars, tstat, used_case, q_restrict;
    local print_diag;

    if verbose /= 0 and verbose /= 1;
        errorlog "ardlFull: verbose must be 0 or 1";
        end;
    endif;
    if print_diagnostics == -1;
        print_diag = verbose;
    elseif print_diagnostics == 0 or print_diagnostics == 1;
        print_diag = print_diagnostics;
    else;
        errorlog "ardlFull: print_diagnostics must be -1, 0, or 1";
        end;
    endif;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyQARDLFormula(data, formula);
    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "ardlFull");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "ardlFull");
    call _qardlValidateGETSPValue(gets_pval, "ardlFull");
    call _ardlValidateCaseID(case_id, "ardlFull");

    { pst, qst } = pqorder(data, pend, qend, criterion, gets_pval);
    if verbose;
        sprintf("ardlFull: %s-selected p = %d, q = %d", upper(criterion), pst, qst);
        print "ardlFull: running ARDL bounds test ...";
    endif;

    { fstat, tstat, cv, used_case, q_restrict } =
        ardlboundsCase(data, pst, qst, case_id);
    if verbose;
        call ardlboundsCase_print(fstat, tstat, cv, cols(data) - 1, used_case);
    endif;

    struct ardlFullOut afOut;
    struct ardlOut ar;
    ar = ardl(data, pst, qst, "", verbose);
    ar.formula = formula;
    ar.depvar = depvar;
    ar.xvars = xvars;
    ar.selection_criterion = criterion;

    afOut.model_family = "ARDL";
    afOut.formula = formula;
    afOut.depvar = depvar;
    afOut.xvars = xvars;
    afOut.deterministic = _ardlDeterministicLabel(case_id);
    afOut.covariance_type = "ols";
    afOut.selection_criterion = criterion;
    afOut.pmax = pend;
    afOut.qmax = qend;
    afOut.sample_start = 1;
    afOut.sample_end = rows(data);
    afOut.pst = pst;
    afOut.qst = qst;
    afOut.nobs = rows(data);
    afOut.ardl_fstat = fstat;
    afOut.ardl_cv = cv;
    afOut.ar = ar;
    afOut.levels_diag = ardlResidualDiagnostics(ar, 0);
    if print_diag;
        call printARDLResidualDiagnostics(afOut.levels_diag);
    endif;

    retp(afOut);
endp;

/*
**> ardlAutoCase
**
**  Purpose:    Select ARDL lag orders by hierarchical GETS, infer the
**              admissible Pesaran-Shin-Smith deterministic case set from a
**              Case V UECM, and report case-specific bounds rows.
**
**  Format:     acOut = ardlAutoCase(data);
**              acOut = ardlAutoCase(data, pend, qend, formula, verbose,
**                                   gets_pval, gets_mode);
*/
proc (struct ardlAutoCaseOut) = ardlAutoCase(data, pend = 8, qend = 8,
                                             formula = "", verbose = 1,
                                             gets_pval = 0.05,
                                             gets_mode = "hierarchical");
    local pst, qst, depvar, xvars, case_ids, primary_case;
    local det_coef, det_pv, bounds_table;
    local sparse_keep_cols, sparse_bt, sparse_coef_cov, sparse_fitted;
    local sparse_resid, sparse_sigma2, selection_criterion;

    if verbose /= 0 and verbose /= 1;
        errorlog "ardlAutoCase: verbose must be 0 or 1";
        end;
    endif;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyQARDLFormula(data, formula);
    call _qardlValidateSearchInputs(data, pend, qend, { 0.5 }, "ardlAutoCase");
    call _qardlValidateGETSPValue(gets_pval, "ardlAutoCase");
    gets_mode = _ardlNormalizeGETSMode(gets_mode, "ardlAutoCase");

    if gets_mode $== "sparse";
        pst = pend;
        qst = qend;
        { case_ids, det_coef, det_pv, sparse_keep_cols, sparse_bt,
          sparse_coef_cov, sparse_fitted, sparse_resid, sparse_sigma2 } =
            _ardlSparseAutoCases(data, pst, qst, gets_pval, "ardlAutoCase");
    else;
        { pst, qst } = pqorder(data, pend, qend, "gets", gets_pval);
        { case_ids, det_coef, det_pv } =
            _ardlAutoCases(data, pst, qst, gets_pval, "ardlAutoCase");
        sparse_keep_cols = error(0);
        sparse_bt = error(0);
        sparse_coef_cov = error(0);
        sparse_fitted = error(0);
        sparse_resid = error(0);
        sparse_sigma2 = 0;
    endif;
    primary_case = case_ids[rows(case_ids)];
    bounds_table = _ardlAutoBoundsTable(data, pst, qst, case_ids);
    selection_criterion = "gets";
    if gets_mode $== "sparse";
        selection_criterion = "gets-sparse";
    endif;

    if verbose;
        call _ardlPrintAutoCase("ardlAutoCase", pst, qst, case_ids,
                                det_pv, bounds_table);
    endif;

    struct ardlAutoCaseOut acOut;
    struct ardlOut ar;
    struct ardlECMOut ecm;
    ar = ardl(data, pst, qst, "", 0);
    ar.formula = formula;
    ar.depvar = depvar;
    ar.xvars = xvars;
    ar.selection_criterion = selection_criterion;
    ecm = ardlECM(data, pst, qst, "", 0, "uecm", primary_case);
    ecm.formula = formula;
    ecm.depvar = depvar;
    ecm.xvars = xvars;
    ecm.selection_criterion = selection_criterion;

    acOut.model_family = "ARDL-AutoCase";
    acOut.formula = formula;
    acOut.depvar = depvar;
    acOut.xvars = xvars;
    acOut.deterministic = _ardlDeterministicLabel(primary_case);
    acOut.covariance_type = "ols";
    acOut.selection_criterion = selection_criterion;
    acOut.gets_mode = gets_mode;
    acOut.pmax = pend;
    acOut.qmax = qend;
    acOut.pst = pst;
    acOut.qst = qst;
    acOut.gets_pval = gets_pval;
    acOut.sample_start = 1;
    acOut.sample_end = rows(data);
    acOut.nobs = rows(data);
    acOut.primary_case = primary_case;
    acOut.case_count = rows(case_ids);
    acOut.case_ids = case_ids;
    acOut.deterministic_coef = det_coef;
    acOut.deterministic_pv = det_pv;
    acOut.sparse_keep_cols = sparse_keep_cols;
    acOut.sparse_bt = sparse_bt;
    acOut.sparse_coef_cov = sparse_coef_cov;
    acOut.sparse_fitted = sparse_fitted;
    acOut.sparse_resid = sparse_resid;
    acOut.sparse_sigma2 = sparse_sigma2;
    acOut.bounds_table = bounds_table;
    acOut.ar = ar;
    acOut.ecm = ecm;

    retp(acOut);
endp;

/*
**> ardlSparseGETS
**
**  Purpose:    Run standalone sparse general-to-specific reduction on the
**              Case V ARDL unrestricted ECM. Lagged level terms are protected;
**              deterministic and short-run difference terms are eligible for
**              deletion by coefficient p-value.
*/
proc (struct ardlSparseGETSOut) = ardlSparseGETS(data, ppp, qqq,
                                                formula = "",
                                                gets_pval = 0.05,
                                                print_results = 1);
    local depvar, xvars, k0, Y, XU, protect_cols, keep, bt, coef_cov;
    local fitted, resid, sigma2, det_coef, det_pv, case_ids, labels;
    local idx, Xk, T0;
    struct ardlSparseGETSOut spOut;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = applyQARDLFormula(data, formula);
    call _qardlValidateEstimatorInputs(data, ppp, qqq, { 0.5 }, "ardlSparseGETS");
    call _qardlValidateGETSPValue(gets_pval, "ardlSparseGETS");

    k0 = cols(data) - 1;
    { Y, XU } = _ardlBuildECMDesignX(data, ppp, qqq*ones(k0, 1),
                                     zeros(k0, 1), "uecm", 5);
    protect_cols = seqa(3, 1, k0 + 1);
    { keep, bt, coef_cov, fitted, resid, sigma2 } =
        _qardlSparseGETS(Y, XU, protect_cols, gets_pval, "ardlSparseGETS");

    det_coef = bt[1:2];
    det_pv = _ardlDetPValues(bt, coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);
    labels = _ardlSparseGETSLabels(xvars, ppp, qqq);
    idx = _qardlMaskIndices(keep);
    Xk = XU[., idx];
    T0 = maxc(ppp|qqq);

    spOut.model_family = "ARDL-SparseGETS";
    spOut.formula = formula;
    spOut.depvar = depvar;
    spOut.xvars = xvars;
    spOut.decomp_vars = "";
    spOut.control_vars = "";
    spOut.deterministic = "case V: unrestricted intercept, unrestricted trend";
    spOut.covariance_type = "ols";
    spOut.selection_criterion = "gets-sparse";
    spOut.p = ppp;
    spOut.q = qqq;
    spOut.q_control = 0;
    spOut.gets_pval = gets_pval;
    spOut.case_id = 5;
    spOut.primary_case = case_ids[rows(case_ids)];
    spOut.case_count = rows(case_ids);
    spOut.case_ids = case_ids;
    spOut.sample_start = 1;
    spOut.sample_end = rows(data);
    spOut.estimation_start = T0 + 2;
    spOut.estimation_end = rows(data);
    spOut.nobs = rows(Y);
    spOut.k = k0;
    spOut.ndecomp = 0;
    spOut.ncontrol = 0;
    spOut.decomp_indices = error(0);
    spOut.control_indices = error(0);
    spOut.decomp_thresholds = error(0);
    spOut.design_rank = rank(Xk);
    spOut.design_cols = cols(Xk);
    spOut.design_condition = sqrt(_qardlConditionNumber(Xk'Xk));
    spOut.term_labels = labels;
    spOut.keep_cols = keep;
    spOut.dropped_cols = _qardlDroppedCols(keep);
    spOut.n_kept = sumc(keep);
    spOut.n_dropped = sumc(keep .== 0);
    spOut.deterministic_coef = det_coef;
    spOut.deterministic_pv = det_pv;
    spOut.bt = bt;
    spOut.coef_cov = coef_cov;
    spOut.fitted = fitted;
    spOut.resid = resid;
    spOut.sigma2 = sigma2;

    if print_results;
        call printARDLSparseGETS(spOut);
    endif;

    retp(spOut);
endp;

proc (0) = printARDLSparseGETS(struct ardlSparseGETSOut spOut);
    local ii, se, zval, pval, status, header, note, table_width, eq_line, dash_line;

    header = "Col  Status   Term                         Coeff.       Std. Err.      z-value       P>|z|    Sig.";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|101|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    print spOut.model_family;
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", spOut.nobs,
            "Candidate terms:", rows(spOut.keep_cols));
    sprintf("%-26s%12.0f        %-26s%12.0f", "Retained terms:", spOut.n_kept,
            "Dropped terms:", spOut.n_dropped);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", spOut.p,
            "DL lags (q):", spOut.q);
    print "GETS p-value threshold: " $+ ftos(spOut.gets_pval, "%*.*lf", 1, 4);
    print "Deterministic screen: " $+ _ardlDeterministicLabel(spOut.primary_case);
    print dash_line;
    print header;
    print dash_line;

    ii = 1;
    do until ii > rows(spOut.keep_cols);
        if spOut.keep_cols[ii] == 1;
            status = "kept";
            se = sqrt(spOut.coef_cov[ii, ii]);
            if se > 0;
                zval = spOut.bt[ii] / se;
                pval = 2*cdfnc(abs(zval));
            else;
                zval = 0;
                pval = 1;
            endif;
            sprintf("%-4.0f %-8s %-24s%16.6f%15.6f%13.6f%12.6f%7s",
                    ii, status, spOut.term_labels[ii], spOut.bt[ii],
                    se, zval, pval, _qardlSignifStars(pval));
        else;
            status = "dropped";
            sprintf("%-4.0f %-8s %-24s%16s%15s%13s%12s%7s",
                    ii, status, spOut.term_labels[ii], "", "", "", "", "");
        endif;
        ii = ii + 1;
    endo;
    print eq_line;
    print note;
endp;

proc (struct qardlOut) = qardl(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, cov_type = "iid", hac_lags = 0, print_results = 1);

    local za, nn, yy, xx, mm, ee, Y, X, ONEX, bigbt, psu, midbt,
        tw, bb, qq, eei, xxi, yyi, ii, yyj, xxj, wwj, kk, kkk, tilw, lll,
        bbt, cc, bigpi, bigphi, midphi, jj, bigam, bilam, k0, ss, hb, hs,
        bt, fh, uu, midgam, bigff, bigbtmm, barw, mtau, mbb, mfh,
        Y_qr, ONEX_qr,
        cov_lags, full_cov, D_qr, D_inv_qr, depvar, xvars, fitted_mat, resid_mat;
    
    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "qardl");
    cov_type = lower(cov_type);
    call _qardlValidateECMCovType(cov_type, "qardl");
    call _qardlValidateHACLags(hac_lags, "qardl");

    // Number of observations
    nn = rows(data);
    
    // Number of variables
    k0 = cols(data)-1;
    { depvar, xvars } = _qardlFormulaNames("", k0);
    
    // Number of quantiles
    ss = rows(tau);
    
    // Sort tau values
    tau = sortc(tau,1);
    
    za = cdfni(0.975);
    hb = zeros(ss,1);
    hs = zeros(ss,1);
    
    jj = 1;
    do until jj > ss;
        hb[jj, 1] = (4.5*pdfn(cdfni(tau[jj,1]))^4/(nn*(2*cdfni(tau[jj,1])^2+1)^2))^0.2;
        hs[jj, 1] = za^(2/3)*(1.5*pdfn(cdfni(tau[jj,1]))^2/(nn*(2*cdfni(tau[jj,1])^2+1)))^(1/3);
        jj = jj + 1;
    endo;
    
    // Separate independent and dependent data
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    
    // First difference of xx
    ee = xx[2:nn, .] - xx[1:(nn-1), .];
    ee = zeros(1, k0)|ee;
    
    if qqq > 0;
        eei = zeros(nn-qqq, qqq*k0);
        xxi = xx[qqq+1:nn, .];
    else;
        xxi = xx;
    endif;
    yyi = zeros(nn-ppp, ppp);
    
    // Create lagged differences of
    // independent variables
    // Variable counter
    if qqq > 0;
        jj = 1;
        do until jj > k0;
            
            // Forward lags of first differences
            // of independent variables
            eei[., 1+(jj-1)*qqq:(jj-1)*qqq+qqq] = packr(lagn(ee[.,jj], seqa(-qqq, 1, qqq)));
            
            jj = jj+1;
        endo;
    endif;
    
    yyi = packr(lagn(yy, seqa(-ppp+1, 1, ppp)));
    yyi = yyi[1:rows(yyi)-1, .];
    
    // Build independent variables
    // First differences of x~foward lagged xx~ forward lagged yy
    //  adjusted for appropriate lag length
    if qqq == 0;
        X = xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    elseif ppp .> qqq;
        X  = eei[(rows(eei)+1-rows(yyi)):rows(eei), .]~xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    else;
        X  = eei~xxi~yyi[(rows(yyi)+1-rows(xxi)):rows(yyi), .];
    endif;
    
    // Parameter estimation
    // Add constant to x
    ONEX = ones(rows(X), 1)~X;
    
    // Adjust y for length of x
    Y  = yy[(nn-rows(X)+1):nn, 1];
    Y_qr = Y;
    ONEX_qr = ONEX;
    call _qardlCheckFullColumnRank(ONEX, "qardl", "levels design matrix");
    
    // Storage for bt
    bt = zeros(cols(ONEX), ss);
    fh = zeros(ss, 1);
    
    // Turn off constant
    struct qfitControl qCtl;
    qctl = qfitControlCreate();
    qCtl.const = 0;
    qCtl.verbose = 0;
    
    struct qfitOut qOut;
    qOut = quantileFit(Y, ONEX, tau, 0, qCtl);
    bt = qOut.beta;
    
    //  Loop through all specified
    //  tau values
    jj = 1;
    do until jj > ss;
        
        // Residuals from estimation
        uu = Y - ONEX*bt[.,jj];
        fh[jj, 1] = meanc(pdfn(-uu/hb[jj, 1]))/hb[jj, 1];
        
        jj = jj + 1;
    endo;
    
    if qqq == 0;
        midbt = zeros(k0, ss);
        jj = 1;
        do until jj > ss;
            midbt[., jj] = bt[2:1+k0, jj]/(1-sumc(bt[2+k0:1+k0+ppp, jj]));
            jj = jj + 1;
        endo;
        bigbt = vec(midbt);

        midphi = zeros(ppp, ss);
        jj = 1;
        do until jj > ss;
            midphi[., jj] = bt[2+k0:1+k0+ppp, jj];
            jj = jj + 1;
        endo;
        bigphi = vec(midphi);

        midgam = zeros(k0, ss);
        jj = 1;
        do until jj > ss;
            midgam[., jj] = bt[2:1+k0, jj];
            jj = jj + 1;
        endo;
        bigam = vec(midgam);

        D_qr = ONEX_qr'*ONEX_qr / rows(Y_qr);
        D_inv_qr = _qardlSafeInv(D_qr, "qardl", "QR moment matrix");
        cov_lags = 0;
        if cov_type $== "hac";
            cov_lags = hac_lags;
            if cov_lags == 0;
                cov_lags = _qardlAutomaticHACLags(rows(Y_qr));
            endif;
        endif;
        full_cov = _qardlQRCovSandwich(ONEX_qr, Y_qr, bt, tau, fh, D_inv_qr, cov_lags);
        { bigbtmm, bigpi, bigff } = _qardlLevelsCovFromFull(full_cov, bt, ppp, qqq, k0, ss);

        struct qardlOut qaOutQ0;
        qaOutQ0.model_family = "QARDL";
        qaOutQ0.formula = "";
        qaOutQ0.depvar = depvar;
        qaOutQ0.xvars = xvars;
        qaOutQ0.deterministic = "constant";
        qaOutQ0.covariance_type = cov_type;
        qaOutQ0.selection_criterion = "none";
        qaOutQ0.ecm_type = "none";
        qaOutQ0.sample_start = 1;
        qaOutQ0.sample_end = rows(data);
        qaOutQ0.estimation_start = rows(data) - rows(Y_qr) + 1;
        qaOutQ0.estimation_end = rows(data);
        qaOutQ0.tau = tau;
        qaOutQ0.p = ppp;
        qaOutQ0.q = qqq;
        qaOutQ0.qvec = qqq*ones(k0, 1);
        qaOutQ0.nobs = rows(Y_qr);
        qaOutQ0.k = k0;
        qaOutQ0.design_rank = rank(ONEX_qr);
        qaOutQ0.design_cols = cols(ONEX_qr);
        qaOutQ0.design_condition = sqrt(_qardlConditionNumber(ONEX_qr'ONEX_qr));
        qaOutQ0.bigbt = bigbt;
        qaOutQ0.bigbt_cov = bigbtmm;
        qaOutQ0.phi = bigphi;
        qaOutQ0.phi_cov = bigpi;
        qaOutQ0.gamma = bigam;
        qaOutQ0.gamma_cov = bigff;
        qaOutQ0.alpha = bt[1, .]';
        qaOutQ0.rho = -(1 - sumc(bt[2+k0:1+k0+ppp, .]));
        qaOutQ0.bt = bt;
        fitted_mat = ONEX_qr*bt;
        resid_mat = Y_qr*ones(1, ss) - fitted_mat;
        qaOutQ0.fitted = fitted_mat;
        qaOutQ0.resid = resid_mat;

        if print_results;
            call printQARDL(qaOutQ0, tau);
        endif;

        retp(qaOutQ0);
    endif;

    // Testing long-run parameter: beta
    barw = zeros(nn-1, qqq*k0);
    
    jj = 1;
    do until jj > qqq;
        barw[jj:(nn-1), (k0*(jj-1)+1):(k0*jj)] = ee[2:(nn-jj+1), .];
        jj = jj + 1;
    endo;
    
    //    tw = ones(nn-1,1)~ee[2:nn,.];
    tw = ones(nn-1, 1)~barw;
    mm = (xx[(qqq+1):nn, .]'*xx[(qqq+1):nn, .] - xx[(qqq+1):nn, .]'*tw[qqq:(nn-1), .]*inv(tw[qqq:(nn-1), .]'*tw[qqq:(nn-1), .])*tw[qqq:(nn-1), .]'*xx[(qqq+1):nn, .])/(nn-qqq)^2;
    
    bb = 1/((1-sumc(bt[2+(qqq+1)*k0:1+(qqq+1)*k0+ppp, .])).*fh);
    
    qq = zeros(ss, ss);
    jj = 1;
    
    mtau = tau.*tau';
    mbb = bb.*bb';
    do until jj > ss;
        ii = 1;
        do until ii > ss;
            
            psu = zeros(2, 1);
            psu[1, 1] = tau[jj, 1];
            psu[2, 1] = tau[ii, 1];
            qq[jj, ii] = (minc(psu) - mtau[jj, ii])*mbb[jj, ii];
            
            ii = ii + 1;
        endo;
        
        jj = jj + 1;
    endo;
    
    midbt = zeros(k0, ss);
    jj = 1;
    do until jj > ss;
        midbt[., jj] = bt[2+qqq*k0:1+(qqq+1)*k0, jj]/(1-sumc(bt[2+(qqq+1)*k0:1+(qqq+1)*k0+ppp, jj]));
        jj = jj + 1;
    endo;
    bigbt = vec(midbt);
    bigbtmm = (qq.*. inv(mm));
    
    // Testing short-run parameters: phi
    if ppp .> qqq;
        xxj = zeros(nn-ppp, k0);
        wwj = zeros(nn-ppp, qqq*k0);
        
        yyj = yyi;
        
        ii = 1;
        do until ii > k0;
            jj = 1;
            do until jj > qqq;
                wwj[., jj+(ii-1)*qqq] = ee[(ppp-jj+2):(nn-jj+1), ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        
        xxj = xx[(ppp+1):nn, .];
        kk = zeros(nn-ppp, ss*ppp);
        
        jj = 1;
        do until jj > ppp;
            Y = yyj[., jj];
            ONEX = ones(nn-ppp, 1)~xxj~wwj;
            struct qfitOut qOut2;
            
            qOut2 = quantileFit(Y, ONEX, tau, 0, qCtl);
            bbt = qOut2.beta;
            
            ii = 1;
            do until ii > ss;
                kkk = Y - ONEX*bbt[., ii];
                kk[., jj+(ii-1)*ppp] = kkk;
                ii = ii + 1;
            endo;
            jj = jj + 1;
        endo;
        tilw = tw[ppp:(nn-1), .];
        lll = (kk'*kk - kk'*tilw*inv(tilw'*tilw)*tilw'*kk)/(nn-ppp);
    else;
        yyj = zeros(nn-qqq, ppp);
        xxj = zeros(nn-qqq, k0);
        wwj = zeros(nn-qqq, qqq*k0);
        jj = 1;
        do until jj > ppp;
            yyj[., jj] = yy[(qqq+1-jj):(nn-jj), 1];
            jj = jj + 1;
        endo;
        ii = 1;
        do until ii > k0;
            jj = 1;
            do until jj > qqq;
                wwj[., jj+(ii-1)*qqq] = ee[(qqq-jj+2):(nn-jj+1), ii];
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
        xxj = xx[(qqq+1):nn, .];
        kk = zeros(nn-qqq, ss*ppp);
        jj = 1;
        do until jj > ppp;
            Y = yyj[., jj];
            ONEX = ones(nn-qqq, 1)~xxj~wwj;
            struct qfitOut qOut3;
            qOut3 = quantileFit(Y, ONEX, tau, 0, qCtl);
            bbt = qOut3.beta;
            
            ii = 1;
            do until ii > ss;
                kkk = Y - ONEX*bbt[.,ii];
                kk[.,jj+(ii-1)*ppp] = kkk;
                ii = ii + 1;
            endo;
            jj = jj + 1;
        endo;
        tilw = tw[qqq:(nn-1),.];
        lll = (kk'*kk - kk'*tilw*inv(tilw'*tilw)*tilw'*kk)/(nn-qqq);
    endif;
    
    mfh = fh.*fh';
    cc = zeros(ss,ss);
    jj = 1;
    
    do until jj > ss;
        ii = 1;
        do until ii > ss;
            psu = zeros(2,1);
            psu[1,1] = tau[jj,1];
            psu[2,1] = tau[ii,1];
            cc[jj,ii] = (minc(psu) - mtau[jj, ii])/(mfh[jj, ii]);
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;
    
    bigpi = zeros(ss*ppp,ss*ppp);
    jj = 1;
    do until jj > ss;
        ii = 1;
        do until ii > ss;
            psu = inv(lll[(jj-1)*ppp+1:jj*ppp,(jj-1)*ppp+1:jj*ppp])*lll[(jj-1)*ppp+1:jj*ppp,(ii-1)*ppp+1:ii*ppp]*inv(lll[(ii-1)*ppp+1:ii*ppp,(ii-1)*ppp+1:ii*ppp]);
            bigpi[(jj-1)*ppp+1:jj*ppp,(ii-1)*ppp+1:ii*ppp] = cc[jj,ii]*psu;
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;
    
    midphi = zeros(ppp,ss);
    jj = 1;
    do until jj > ss;
        midphi[.,jj] = bt[2+(qqq+1)*k0:1+(qqq+1)*k0+ppp,jj];
        jj = jj + 1;
    endo;
    bigphi = vec(midphi);
    
    /* testing short-run parameters: gamma */
    
    midgam = zeros(k0,ss);
    jj = 1;
    do until jj > ss;
        midgam[.,jj] = bt[2+qqq*k0:1+(qqq+1)*k0,jj];
        jj = jj + 1;
    endo;
    bigam = vec(midgam);
    bilam = zeros(k0*ss,ss*ppp);
    
    jj = 1;
    do until jj > ss;
        bilam[((jj-1)*k0+1):(jj*k0),(jj-1)*ppp+1:(jj*ppp)] = midbt[.,jj]*ones(1,ppp);
        jj = jj + 1;
    endo;
    
    bigff = bilam*bigpi*bilam';

    if not (cov_type $== "iid");
        cov_lags = hac_lags;
        if cov_type $== "robust";
            cov_lags = 0;
        elseif cov_lags == 0;
            cov_lags = _qardlAutomaticHACLags(rows(Y));
        endif;

        D_qr = ONEX_qr'*ONEX_qr / rows(Y_qr);
        D_inv_qr = _qardlSafeInv(D_qr, "qardl", "QR moment matrix");
        full_cov = _qardlQRCovSandwich(ONEX_qr, Y_qr, bt, tau, fh, D_inv_qr, cov_lags);
        { bigbtmm, bigpi, bigff } = _qardlLevelsCovFromFull(full_cov, bt, ppp, qqq, k0, ss);
    endif;
    
    struct qardlOut qaOut;
    
    qaOut.model_family = "QARDL";
    qaOut.formula = "";
    qaOut.depvar = depvar;
    qaOut.xvars = xvars;
    qaOut.deterministic = "constant";
    qaOut.covariance_type = cov_type;
    qaOut.selection_criterion = "none";
    qaOut.ecm_type = "none";
    qaOut.sample_start = 1;
    qaOut.sample_end = rows(data);
    qaOut.estimation_start = rows(data) - rows(Y_qr) + 1;
    qaOut.estimation_end = rows(data);
    qaOut.tau = tau;
    qaOut.p = ppp;
    qaOut.q = qqq;
    qaOut.qvec = qqq*ones(k0, 1);
    qaOut.nobs = rows(Y);
    qaOut.k = k0;
    qaOut.design_rank = rank(ONEX_qr);
    qaOut.design_cols = cols(ONEX_qr);
    qaOut.design_condition = sqrt(_qardlConditionNumber(ONEX_qr'ONEX_qr));
    qaOut.bigbt = bigbt;
    qaOut.bigbt_cov = bigbtmm;
    qaOut.phi = bigphi;
    qaOut.phi_cov = bigpi;
    qaOut.gamma = bigam;
    qaOut.gamma_cov = bigff;

    // Intercept: alpha(tau) = bt[1, .], transposed to (ss x 1)
    qaOut.alpha = bt[1, .]';

    // ECM adjustment coefficient: rho(tau) = -(1 - sum_j phi_j(tau))
    // sumc over (ppp x ss) matrix gives (ss x 1) column vector directly
    qaOut.rho = -(1 - sumc(bt[2+(qqq+1)*k0:1+(qqq+1)*k0+ppp, .]));

    // Full coefficient matrix for downstream use (e.g., QIRF)
    qaOut.bt = bt;
    fitted_mat = ONEX_qr*bt;
    resid_mat = Y_qr*ones(1, ss) - fitted_mat;
    qaOut.fitted = fitted_mat;
    qaOut.resid = resid_mat;

    if print_results;
        call printQARDL(qaOut, tau);
    endif;

    retp(qaOut);
endp;

/*
**> qardlRobust
**
**  Purpose:    Levels-form QARDL with heteroskedasticity-robust QR sandwich
**              covariance for beta, gamma/theta, and phi.
*/
proc (struct qardlOut) = qardlRobust(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, print_results = 1);
    struct qardlOut qaOut;
    qaOut = qardl(data, ppp, qqq, tau, "robust", 0, print_results);
    retp(qaOut);
endp;

/*
**> qardlHAC
**
**  Purpose:    Levels-form QARDL with Newey-West/Bartlett HAC QR sandwich
**              covariance for beta, gamma/theta, and phi.
**
**  Input:      hac_lags    scalar non-negative lag truncation. Use 0 for the
**                          automatic Newey-West bandwidth.
*/
proc (struct qardlOut) = qardlHAC(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, hac_lags = 0, print_results = 1);
    struct qardlOut qaOut;
    qaOut = qardl(data, ppp, qqq, tau, "hac", hac_lags, print_results);
    retp(qaOut);
endp;

/*
**> qardlX
**
**  Purpose:    Levels-form QARDL with a separate distributed-lag order for
**              each regressor. qvec is k x 1 or 1 x k and contains
**              non-negative integer q_i values.
**
**  Format:     qaOut = qardlX(data, ppp, qvec);
**              qaOut = qardlX(data, ppp, qvec, tau, cov_type, hac_lags, print_results);
**
**  Notes:      Uses the QR sandwich covariance path for all covariance types.
**              `qaOut.q` stores max(qvec); keep qvec with your model spec.
*/
proc (struct qardlOut) = qardlX(data, ppp, qvec, tau = { 0.25, 0.5, 0.75 }, cov_type = "robust", hac_lags = 0, print_results = 1);
    local nn, k0, ss, za, hb, hs, jj, yy, Y, ONEX, bt, fh, uu;
    local qmax, theta_start, phi_start, D_qr, D_inv_qr, cov_lags, full_cov;
    local midbt, bigbt, midphi, bigphi, midgam, bigam, bigbtmm, bigpi, bigff;
    local depvar, xvars, fitted_mat, resid_mat;

    call _qardlValidateEstimatorInputs(data, ppp, 0, tau, "qardlX");
    k0 = cols(data) - 1;
    { depvar, xvars } = _qardlFormulaNames("", k0);
    qvec = _qardlNormalizeQVector(qvec, k0, "qardlX: qvec");
    cov_type = lower(cov_type);
    call _qardlValidateECMCovType(cov_type, "qardlX");
    call _qardlValidateHACLags(hac_lags, "qardlX");

    nn = rows(data);
    ss = rows(tau);
    tau = sortc(tau, 1);
    yy = data[., 1];
    qmax = maxc(qvec);

    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);
    call _qardlCheckFullColumnRank(ONEX, "qardlX", "levels design matrix");

    za = cdfni(0.975);
    hb = zeros(ss, 1);
    hs = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        hb[jj] = (4.5*pdfn(cdfni(tau[jj]))^4/(nn*(2*cdfni(tau[jj])^2+1)^2))^0.2;
        hs[jj] = za^(2/3)*(1.5*pdfn(cdfni(tau[jj]))^2/(nn*(2*cdfni(tau[jj])^2+1)))^(1/3);
        jj = jj + 1;
    endo;

    struct qfitControl qCtl;
    qCtl = qfitControlCreate();
    qCtl.const = 0;
    qCtl.verbose = 0;

    struct qfitOut qOut;
    qOut = quantileFit(Y, ONEX, tau, 0, qCtl);
    bt = qOut.beta;

    fh = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        uu = Y - ONEX*bt[., jj];
        fh[jj] = meanc(pdfn(-uu/hb[jj]))/hb[jj];
        jj = jj + 1;
    endo;

    midbt = zeros(k0, ss);
    midphi = zeros(ppp, ss);
    midgam = zeros(k0, ss);
    jj = 1;
    do until jj > ss;
        midbt[., jj] = bt[theta_start:theta_start+k0-1, jj] /
                       (1 - sumc(bt[phi_start:phi_start+ppp-1, jj]));
        midphi[., jj] = bt[phi_start:phi_start+ppp-1, jj];
        midgam[., jj] = bt[theta_start:theta_start+k0-1, jj];
        jj = jj + 1;
    endo;
    bigbt = vec(midbt);
    bigphi = vec(midphi);
    bigam = vec(midgam);

    cov_lags = 0;
    if cov_type $== "hac";
        cov_lags = hac_lags;
        if cov_lags == 0;
            cov_lags = _qardlAutomaticHACLags(rows(Y));
        endif;
    endif;

    D_qr = ONEX'*ONEX / rows(Y);
    D_inv_qr = _qardlSafeInv(D_qr, "qardlX", "QR moment matrix");
    full_cov = _qardlQRCovSandwich(ONEX, Y, bt, tau, fh, D_inv_qr, cov_lags);
    { bigbtmm, bigpi, bigff } =
        _qardlLevelsCovFromFullPositions(full_cov, bt, theta_start, phi_start, k0, ppp, ss);

    struct qardlOut qaOut;
    qaOut.model_family = "QARDL";
    qaOut.formula = "";
    qaOut.depvar = depvar;
    qaOut.xvars = xvars;
    qaOut.deterministic = "constant";
    qaOut.covariance_type = cov_type;
    qaOut.selection_criterion = "none";
    qaOut.ecm_type = "none";
    qaOut.sample_start = 1;
    qaOut.sample_end = rows(data);
    qaOut.estimation_start = rows(data) - rows(Y) + 1;
    qaOut.estimation_end = rows(data);
    qaOut.tau = tau;
    qaOut.p = ppp;
    qaOut.q = qmax;
    qaOut.qvec = qvec;
    qaOut.nobs = rows(Y);
    qaOut.k = k0;
    qaOut.design_rank = rank(ONEX);
    qaOut.design_cols = cols(ONEX);
    qaOut.design_condition = sqrt(_qardlConditionNumber(ONEX'ONEX));
    qaOut.bigbt = bigbt;
    qaOut.bigbt_cov = bigbtmm;
    qaOut.phi = bigphi;
    qaOut.phi_cov = bigpi;
    qaOut.gamma = bigam;
    qaOut.gamma_cov = bigff;
    qaOut.alpha = bt[1, .]';
    qaOut.rho = -(1 - sumc(bt[phi_start:phi_start+ppp-1, .]));
    qaOut.bt = bt;
    fitted_mat = ONEX*bt;
    resid_mat = Y*ones(1, ss) - fitted_mat;
    qaOut.fitted = fitted_mat;
    qaOut.resid = resid_mat;

    if print_results;
        call printQARDL(qaOut, tau);
    endif;

    retp(qaOut);
endp;

/*
**> qardlECM
**
**  Purpose:    Perform QARDL-ECM estimation.
**
**              The default two-step estimator first estimates the ARDL model
**              by OLS to obtain consistent long-run coefficient estimates
**              (beta_lr) and the OLS speed of adjustment (rho_ols). It then
**              forms the error correction term
**                      EC_{t-1} = y_{t-1} - beta_lr'*x_{t-1}
**              and estimates the ECM by quantile regression:
**                        Dy_t = alpha(tau) + rho(tau)*EC_{t-1}
**                               + sum_j psi_j(tau)*Dy_{t-j}      [j=1,...,p-1]
**                               + sum_j delta_j(tau)*Dx_{t-j}    [j=0,...,q-1]
**                               + u_t(tau)
**              With ecm_type = "uecm", lagged y and lagged x levels enter the
**              ECM design directly and long-run coefficients are derived as
**              -theta/rho at each quantile.
**
**  Format:     qECMOut = qardlECM(data, ppp, qqq);
**              qECMOut = qardlECM(data, ppp, qqq, tau);
**              qECMOut = qardlECM(data, ppp, qqq, tau, cov_type, hac_lags, print_results);
**              qECMOut = qardlECM(data, ppp, qqq, tau, cov_type, hac_lags, print_results, ecm_type);
**
**  Input:      data        (n x (1+k)) matrix. Column 1 is the dependent variable;
**                          columns 2:(1+k) are the k regressors.
**
**              ppp         scalar, AR lag order p >= 1.
**
**              qqq         scalar, distributed-lag order q >= 1.
**
**              tau         (s x 1) vector of quantile levels, sorted ascending.
**
**              cov_type    string, covariance estimator: "iid" (default),
**                          "robust", or "hac".
**
**              hac_lags    scalar, non-negative HAC lag truncation. If cov_type
**                          is "hac" and hac_lags = 0, a Newey-West automatic
**                          bandwidth floor(4*(T/100)^(2/9)) is used.
**
**              ecm_type    string, "two-step" (default) or "uecm".
**
**  Output:     qECMOut     instance of qardlECMOut. Members:
**
**                  qECMOut.beta_lr     long-run coefficients. For "two-step",
**                                      this is (k x 1) OLS beta; for "uecm",
**                                      this is (k x s) quantile-specific beta.
**
**                  qECMOut.rho_ols     scalar (1x1 matrix), OLS speed of adjustment
**                                      rho_OLS = -(1 - sum_j phi_j^OLS).
**
**                  qECMOut.alpha       (s x 1) ECM intercept at each quantile.
**
**                  qECMOut.rho         (s x 1) speed of adjustment at each quantile.
**
**                  qECMOut.rho_cov     (s x s) asymptotic covariance of rho across
**                                      quantiles.
**
**  Notes:      Requires cointegration between y_t and x_t. The two-step
**              approach avoids nonlinear QR by using OLS for the long-run
**              relationship (Cho, Kim & Shin 2015; Aptech GAUSS forum).
**
**  Developed:  March 2026
*/

proc (struct qardlECMOut) = qardlECM(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, cov_type = "iid", hac_lags = 0, print_results = 1, ecm_type = "two-step");
    local nn, k0, ss, jj, ii, j;
    local yy, xx, ee;
    local eei, xxi, yyi, X_ols, ONEX_ols, Y_ols;
    local bt_ols, rho_ols, beta_lr_ols;
    local N, T0, N_ecm;
    local ec_lag, dy_lags, dx_ecm, ONEX_ecm, Y_ecm;
    local bt_ecm, fh_ecm, uu_ecm, hb;
    local za, cc, mfh, mtau, psu;
    local D_ecm, D_inv_ecm, rho_cov, alpha_cov, cov_lags;
    local depvar, xvars, fitted_mat, resid_mat, beta_lr_ecm;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "qardlECM");
    ecm_type = _ardlNormalizeECMType(ecm_type, "qardlECM", 0);
    cov_type = lower(cov_type);
    call _qardlValidateECMCovType(cov_type, "qardlECM");
    call _qardlValidateHACLags(hac_lags, "qardlECM");

    nn = rows(data);
    k0 = cols(data) - 1;
    { depvar, xvars } = _qardlFormulaNames("", k0);
    ss = rows(tau);
    tau = sortc(tau, 1);

    // Bandwidth for density estimation at each quantile
    za = cdfni(0.975);
    hb = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        hb[jj] = (4.5*pdfn(cdfni(tau[jj]))^4/(nn*(2*cdfni(tau[jj])^2+1)^2))^0.2;
        jj = jj + 1;
    endo;

    yy = data[., 1];
    xx = data[., 2:cols(data)];

    // First differences of x (prepend zero row for alignment)
    ee = xx[2:nn, .] - xx[1:(nn-1), .];
    ee = zeros(1, k0)|ee;

    // ---- Step 1: OLS ARDL (identical regressor construction to qardl) ----
    if qqq > 0;
        eei = zeros(nn-qqq, qqq*k0);
        xxi = xx[qqq+1:nn, .];
    else;
        xxi = xx;
    endif;
    yyi = zeros(nn-ppp, ppp);

    if qqq > 0;
        jj = 1;
        do until jj > k0;
            eei[., 1+(jj-1)*qqq:(jj-1)*qqq+qqq] = packr(lagn(ee[., jj], seqa(-qqq, 1, qqq)));
            jj = jj + 1;
        endo;
    endif;

    yyi = packr(lagn(yy, seqa(-ppp+1, 1, ppp)));
    yyi = yyi[1:rows(yyi)-1, .];

    if qqq == 0;
        X_ols = xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    elseif ppp .> qqq;
        X_ols = eei[(rows(eei)+1-rows(yyi)):rows(eei), .]~xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    else;
        X_ols = eei~xxi~yyi[(rows(yyi)+1-rows(xxi)):rows(yyi), .];
    endif;

    ONEX_ols = ones(rows(X_ols), 1)~X_ols;
    Y_ols = yy[(nn-rows(X_ols)+1):nn, 1];
    N = rows(Y_ols);
    T0 = nn - N;
    call _qardlCheckFullColumnRank(ONEX_ols, "qardlECM", "levels OLS design matrix");

    // OLS ARDL coefficient vector
    bt_ols = _qardlSafeInv(ONEX_ols'*ONEX_ols, "qardlECM", "levels OLS moment matrix")*ONEX_ols'*Y_ols;

    // OLS speed of adjustment: rho_ols = -(1 - sum_j phi_j)
    rho_ols = -(1 - sumc(bt_ols[2+(qqq+1)*k0:1+(qqq+1)*k0+ppp]));

    // OLS long-run coefficient: beta_lr = theta / (-rho_ols)
    // where theta = bt_ols[2+qqq*k0:1+(qqq+1)*k0] are the x-level coefficients
    beta_lr_ols = bt_ols[2+qqq*k0:1+(qqq+1)*k0] ./ (-rho_ols);

    { Y_ecm, ONEX_ecm } =
        _ardlBuildECMDesignX(data, ppp, qqq*ones(k0, 1), beta_lr_ols, ecm_type, 3);
    N_ecm = rows(Y_ecm);
    call _qardlCheckFullColumnRank(ONEX_ecm, "qardlECM", "ECM design matrix");

    // ---- Step 3: Quantile regression of ECM ----
    struct qfitControl qCtl;
    qCtl = qfitControlCreate();
    qCtl.const = 0;
    qCtl.verbose = 0;

    struct qfitOut qOutECM;
    qOutECM = quantileFit(Y_ecm, ONEX_ecm, tau, 0, qCtl);
    bt_ecm = qOutECM.beta;
    if ecm_type $== "uecm";
        beta_lr_ecm = zeros(k0, ss);
        jj = 1;
        do until jj > ss;
            beta_lr_ecm[., jj] = _ardlLongRunFromUECM(bt_ecm[., jj], 2, 3, k0);
            jj = jj + 1;
        endo;
    else;
        beta_lr_ecm = beta_lr_ols;
    endif;

    // Density estimates at quantile residuals (for covariance computation)
    fh_ecm = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        uu_ecm = Y_ecm - ONEX_ecm*bt_ecm[., jj];
        fh_ecm[jj] = meanc(pdfn(-uu_ecm/hb[jj]))/hb[jj];
        jj = jj + 1;
    endo;

    // ---- Asymptotic covariance of rho estimates ----
    // For stationary ECM regressors, Cov(rho(tau_i), rho(tau_j)) = cc[i,j]*D_inv[2,2]/N_ecm
    // where cc[i,j] = (min(tau_i, tau_j) - tau_i*tau_j) / (fh_i * fh_j)
    // and D = ONEX_ecm'*ONEX_ecm / N_ecm
    mtau = tau.*tau';
    mfh = fh_ecm.*fh_ecm';

    cc = zeros(ss, ss);
    jj = 1;
    do until jj > ss;
        ii = 1;
        do until ii > ss;
            psu = zeros(2, 1);
            psu[1] = tau[jj];
            psu[2] = tau[ii];
            cc[jj, ii] = (minc(psu) - mtau[jj, ii]) / mfh[jj, ii];
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;

    D_ecm = ONEX_ecm'*ONEX_ecm / N_ecm;
    D_inv_ecm = _qardlSafeInv(D_ecm, "qardlECM", "ECM moment matrix");

    if cov_type $== "iid";
        // Extract variance contributions: row 1 = alpha, row 2 = rho
        rho_cov   = cc * D_inv_ecm[2, 2] / N_ecm;
        alpha_cov = cc * D_inv_ecm[1, 1] / N_ecm;
    else;
        cov_lags = hac_lags;
        if cov_type $== "robust";
            cov_lags = 0;
        elseif cov_lags == 0;
            cov_lags = _qardlAutomaticHACLags(N_ecm);
        endif;
        { alpha_cov, rho_cov } = _qardlECMCovSandwich(ONEX_ecm, Y_ecm, bt_ecm, tau,
                                                      fh_ecm, D_inv_ecm, cov_lags);
    endif;

    // ---- Package results ----
    struct qardlECMOut qECMOut;
    qECMOut.model_family = "QARDL-ECM";
    qECMOut.formula = "";
    qECMOut.depvar = depvar;
    qECMOut.xvars = xvars;
    qECMOut.deterministic = "constant";
    qECMOut.covariance_type = cov_type;
    qECMOut.selection_criterion = "none";
    qECMOut.ecm_type = ecm_type;
    qECMOut.sample_start = 1;
    qECMOut.sample_end = rows(data);
    qECMOut.estimation_start = rows(data) - N_ecm + 1;
    qECMOut.estimation_end = rows(data);
    qECMOut.tau       = tau;
    qECMOut.p         = ppp;
    qECMOut.q         = qqq;
    qECMOut.qvec      = qqq*ones(k0, 1);
    qECMOut.nobs      = N_ecm;
    qECMOut.k         = k0;
    qECMOut.design_rank = rank(ONEX_ecm);
    qECMOut.design_cols = cols(ONEX_ecm);
    qECMOut.design_condition = sqrt(_qardlConditionNumber(ONEX_ecm'ONEX_ecm));
    qECMOut.beta_lr   = beta_lr_ecm;
    qECMOut.rho_ols   = rho_ols;
    qECMOut.alpha     = bt_ecm[1, .]';
    qECMOut.rho       = bt_ecm[2, .]';
    qECMOut.rho_cov   = rho_cov;
    qECMOut.alpha_cov = alpha_cov;
    qECMOut.bt        = bt_ecm;
    fitted_mat = ONEX_ecm*bt_ecm;
    resid_mat = Y_ecm*ones(1, ss) - fitted_mat;
    qECMOut.fitted = fitted_mat;
    qECMOut.resid = resid_mat;

    if print_results;
        call printQARDLECM(qECMOut, tau);
    endif;

    retp(qECMOut);
endp;

/*
**> qardlECMRobust
**
**  Purpose:    Two-step QARDL-ECM estimation with heteroskedasticity-robust
**              quantile-regression sandwich covariance for alpha and rho.
*/
proc (struct qardlECMOut) = qardlECMRobust(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, print_results = 1, ecm_type = "two-step");
    struct qardlECMOut qECMOut;
    qECMOut = qardlECM(data, ppp, qqq, tau, "robust", 0, print_results, ecm_type);
    retp(qECMOut);
endp;

/*
**> qardlECMHAC
**
**  Purpose:    Two-step QARDL-ECM estimation with Newey-West/Bartlett HAC
**              quantile-regression sandwich covariance for alpha and rho.
**
**  Input:      hac_lags    scalar non-negative lag truncation. Use 0 for the
**                          automatic Newey-West bandwidth.
*/
proc (struct qardlECMOut) = qardlECMHAC(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, hac_lags = 0, print_results = 1, ecm_type = "two-step");
    struct qardlECMOut qECMOut;
    qECMOut = qardlECM(data, ppp, qqq, tau, "hac", hac_lags, print_results, ecm_type);
    retp(qECMOut);
endp;

/*
**> qardlECMX
**
**  Purpose:    Two-step QARDL-ECM with a separate distributed-lag order for
**              each regressor.
*/
proc (struct qardlECMOut) = qardlECMX(data, ppp, qvec, tau = { 0.25, 0.5, 0.75 }, cov_type = "robust", hac_lags = 0, print_results = 1, ecm_type = "two-step");
    local nn, k0, ss, yy, xx, Y_ols, ONEX_ols, theta_start, phi_start;
    local bt_ols, rho_ols, beta_lr_ols, qmax, T0, N, N_ecm, Y_ecm, ec_lag;
    local ONEX_ecm, dy_lags, dx_ecm, ii, jj, j, bt_ecm, fh_ecm, uu_ecm;
    local za, hb, D_ecm, D_inv_ecm, rho_cov, alpha_cov, cov_lags, cc, mtau, mfh, psu;
    local depvar, xvars, fitted_mat, resid_mat, beta_lr_ecm;

    call _qardlValidateEstimatorInputs(data, ppp, 0, tau, "qardlECMX");
    ecm_type = _ardlNormalizeECMType(ecm_type, "qardlECMX", 0);
    k0 = cols(data) - 1;
    { depvar, xvars } = _qardlFormulaNames("", k0);
    qvec = _qardlNormalizeQVector(qvec, k0, "qardlECMX: qvec");
    cov_type = lower(cov_type);
    call _qardlValidateECMCovType(cov_type, "qardlECMX");
    call _qardlValidateHACLags(hac_lags, "qardlECMX");

    nn = rows(data);
    ss = rows(tau);
    tau = sortc(tau, 1);
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    qmax = maxc(qvec);

    { Y_ols, ONEX_ols, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, ppp, qvec);
    call _qardlCheckFullColumnRank(ONEX_ols, "qardlECMX", "levels OLS design matrix");
    bt_ols = _qardlSafeInv(ONEX_ols'*ONEX_ols, "qardlECMX", "levels OLS moment matrix")*ONEX_ols'*Y_ols;
    rho_ols = -(1 - sumc(bt_ols[phi_start:phi_start+ppp-1]));
    beta_lr_ols = bt_ols[theta_start:theta_start+k0-1] ./ (-rho_ols);

    { Y_ecm, ONEX_ecm } =
        _ardlBuildECMDesignX(data, ppp, qvec, beta_lr_ols, ecm_type, 3);
    N_ecm = rows(Y_ecm);
    call _qardlCheckFullColumnRank(ONEX_ecm, "qardlECMX", "ECM design matrix");

    za = cdfni(0.975);
    hb = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        hb[jj] = (4.5*pdfn(cdfni(tau[jj]))^4/(nn*(2*cdfni(tau[jj])^2+1)^2))^0.2;
        jj = jj + 1;
    endo;

    struct qfitControl qCtl;
    qCtl = qfitControlCreate();
    qCtl.const = 0;
    qCtl.verbose = 0;

    struct qfitOut qOutECM;
    qOutECM = quantileFit(Y_ecm, ONEX_ecm, tau, 0, qCtl);
    bt_ecm = qOutECM.beta;
    if ecm_type $== "uecm";
        beta_lr_ecm = zeros(k0, ss);
        jj = 1;
        do until jj > ss;
            beta_lr_ecm[., jj] = _ardlLongRunFromUECM(bt_ecm[., jj], 2, 3, k0);
            jj = jj + 1;
        endo;
    else;
        beta_lr_ecm = beta_lr_ols;
    endif;

    fh_ecm = zeros(ss, 1);
    jj = 1;
    do until jj > ss;
        uu_ecm = Y_ecm - ONEX_ecm*bt_ecm[., jj];
        fh_ecm[jj] = meanc(pdfn(-uu_ecm/hb[jj]))/hb[jj];
        jj = jj + 1;
    endo;

    D_ecm = ONEX_ecm'*ONEX_ecm / N_ecm;
    D_inv_ecm = _qardlSafeInv(D_ecm, "qardlECMX", "ECM moment matrix");

    if cov_type $== "iid";
        mtau = tau.*tau';
        mfh = fh_ecm.*fh_ecm';
        cc = zeros(ss, ss);
        jj = 1;
        do until jj > ss;
            ii = 1;
            do until ii > ss;
                psu = zeros(2, 1);
                psu[1] = tau[jj];
                psu[2] = tau[ii];
                cc[jj, ii] = (minc(psu) - mtau[jj, ii]) / mfh[jj, ii];
                ii = ii + 1;
            endo;
            jj = jj + 1;
        endo;
        rho_cov = cc * D_inv_ecm[2, 2] / N_ecm;
        alpha_cov = cc * D_inv_ecm[1, 1] / N_ecm;
    else;
        cov_lags = hac_lags;
        if cov_type $== "robust";
            cov_lags = 0;
        elseif cov_lags == 0;
            cov_lags = _qardlAutomaticHACLags(N_ecm);
        endif;
        { alpha_cov, rho_cov } = _qardlECMCovSandwich(ONEX_ecm, Y_ecm, bt_ecm, tau,
                                                      fh_ecm, D_inv_ecm, cov_lags);
    endif;

    struct qardlECMOut qECMOut;
    qECMOut.model_family = "QARDL-ECM";
    qECMOut.formula = "";
    qECMOut.depvar = depvar;
    qECMOut.xvars = xvars;
    qECMOut.deterministic = "constant";
    qECMOut.covariance_type = cov_type;
    qECMOut.selection_criterion = "none";
    qECMOut.ecm_type = ecm_type;
    qECMOut.sample_start = 1;
    qECMOut.sample_end = rows(data);
    qECMOut.estimation_start = rows(data) - N_ecm + 1;
    qECMOut.estimation_end = rows(data);
    qECMOut.tau = tau;
    qECMOut.p = ppp;
    qECMOut.q = qmax;
    qECMOut.qvec = qvec;
    qECMOut.nobs = N_ecm;
    qECMOut.k = k0;
    qECMOut.design_rank = rank(ONEX_ecm);
    qECMOut.design_cols = cols(ONEX_ecm);
    qECMOut.design_condition = sqrt(_qardlConditionNumber(ONEX_ecm'ONEX_ecm));
    qECMOut.beta_lr = beta_lr_ecm;
    qECMOut.rho_ols = rho_ols;
    qECMOut.alpha = bt_ecm[1, .]';
    qECMOut.rho = bt_ecm[2, .]';
    qECMOut.rho_cov = rho_cov;
    qECMOut.alpha_cov = alpha_cov;
    qECMOut.bt = bt_ecm;
    fitted_mat = ONEX_ecm*bt_ecm;
    resid_mat = Y_ecm*ones(1, ss) - fitted_mat;
    qECMOut.fitted = fitted_mat;
    qECMOut.resid = resid_mat;

    if print_results;
        call printQARDLECM(qECMOut, tau);
    endif;

    retp(qECMOut);
endp;

proc (2) = qardlAR2Sim(nnn, alpha, phi, rho, the0, the1);
    local gam, bes, eee1, eee2, eee, xxx, yyy, uuu, jjj;
    
    gam = the0 + the1;
    bes = gam/(1 - phi);
    
    // Generate data
    eee1= rndn(nnn+1, 1);
    eee2 = rndn(nnn, 1);
    eee = eee1[1:nnn];
    xxx = cumsumc(eee)~cumsumc(eee2);
    uuu = rndn(nnn, 1);
    yyy = zeros(nnn, 1);
    jjj = 2;
    
    do until jjj > nnn;
        yyy[jjj] = alpha + phi*yyy[jjj-1] + the0*xxx[jjj, 1] + the1*xxx[jjj-1, 1]
            + the0*xxx[jjj, 2] + the1*xxx[jjj-1, 2] + uuu[jjj];
        jjj = jjj + 1;
    endo;
    
    retp(yyy, xxx);
endp;

proc (0) = plotQARDL(struct qardlOut qaOut, tau = { 0.25, 0.5, 0.75 }, show_bands = 0, alpha = 0.05);
    local _beta, _gamma, _phi, _alpha, _rho, ntau, k, p, nCols;

    call _qardlValidateTau(tau, "plotQARDL");
    call _qardlValidatePlotBandInputs(show_bands, alpha, "plotQARDL");

    if show_bands;
        call plotQARDLbands(qaOut, tau, alpha);
        retp;
    endif;

    ntau = rows(tau);

    _beta  = qaOut.bigbt;
    _gamma = qaOut.gamma;
    _phi   = qaOut.phi;
    _alpha = qaOut.alpha;
    _rho   = qaOut.rho;

    // Get dimensions of model
    k = rows(_beta) / ntau;
    p = rows(_phi)  / ntau;

    if round(k) /= k or round(p) /= p;
        errorlog "plotQARDL: tau length does not match qaOut";
        end;
    endif;

    // Reshape parameter matrices
    _beta  = reshape(_beta,  ntau, k);
    _phi   = reshape(_phi,   ntau, p);
    _gamma = reshape(_gamma, ntau, k);

    // Set up graph controls
    struct plotControl myPlot;
    myPlot = plotSetQARDLDefaults(p, k);

    // 4-row layout: beta | gamma | phi | alpha+rho
    nCols = maxc(p|k);

    plotBetaGraphs(_beta,  k, p, tau, nCols, myPlot);
    plotGammaGraphs(_gamma, k, p, tau, nCols, myPlot);
    plotPhiGraphs(_phi,    k, p, tau, nCols, myPlot);
    plotAlphaRhoGraphs(_alpha, _rho, tau, nCols, myPlot);

    plotClearLayout();

endp;

proc (0) = plotBetaGraphs(_beta, k, p, tau, nCols, struct PlotControl myPlot);
    local vnames_beta, gp_indx;

    gp_indx = 1;
    vnames_beta = "\\beta_" $+ ntos(seqa(1, 1, k));

    for i(1, k, 1);
        plotLayout(4, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames_beta[i]);
        plotXY(myPlot, tau, _beta[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (0) = plotGammaGraphs(_gamma, k, p, tau, nCols, struct PlotControl myPlot);
    local vnames_gamma, gp_indx;

    gp_indx = maxc(k|p) + 1;
    vnames_gamma = "\\gamma_" $+ ntos(seqa(1, 1, k));

    for i(1, k, 1);
        plotLayout(4, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames_gamma[i]);
        plotXY(myPlot, tau, _gamma[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (0) = plotPhiGraphs(_phi, k, p, tau, nCols, struct plotControl myPlot);
    local vnames_phi, gp_indx;

    gp_indx = 2*maxc(k|p) + 1;
    vnames_phi = "\\phi_{t-" $+ ntos(seqa(1, 1, p)) $+ "}";

    for i(1, p, 1);
        plotLayout(4, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames_phi[i]);
        plotXY(myPlot, tau, _phi[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (0) = plotAlphaRhoGraphs(_alpha, _rho, tau, nCols, struct plotControl myPlot);
    local gp_indx;

    // Row 4, columns 1 and 2
    gp_indx = 3*nCols + 1;

    plotLayout(4, nCols, gp_indx);
    plotSetTitle(&myPlot, "\\alpha(\\tau)");
    plotXY(myPlot, tau, _alpha);

    plotLayout(4, nCols, gp_indx + 1);
    plotSetTitle(&myPlot, "\\rho(\\tau)");
    plotXY(myPlot, tau, _rho);
endp;

/*
**> plotQARDLbands
**
**  Purpose:    Plot quantile process curves with asymptotic confidence
**              bands for long-run (beta), short-run (gamma), and AR (phi)
**              parameters.  Bands are point-wise: estimate +/- z(alpha) * SE,
**              where SE is extracted from the diagonal of the covariance
**              matrices stored in the qardlOut struct.
**
**  Format:     plotQARDLbands(qaOut, tau);
**              plotQARDLbands(qaOut, tau, alpha);
**
**  Input:      qaOut       struct qardlOut returned by qardl().
**              tau         (ss x 1) vector of quantile indices.
**              alpha       scalar, significance level. Default is 0.05.
*/
proc (0) = plotQARDLbands(struct qardlOut qaOut, tau = { 0.25, 0.5, 0.75 }, alpha = 0.05);
    local _beta, _gamma, _phi, ntau, k, p, nCols;
    local se_beta, se_gamma, se_phi;
    local lb_beta, ub_beta, lb_gamma, ub_gamma, lb_phi, ub_phi, zcrit;

    call _qardlValidateTau(tau, "plotQARDLbands");
    call _qardlValidatePlotBandInputs(1, alpha, "plotQARDLbands");

    ntau = rows(tau);

    _beta  = qaOut.bigbt;
    _gamma = qaOut.gamma;
    _phi   = qaOut.phi;

    // Recover dimensions
    k = rows(_beta) / ntau;
    p = rows(_phi)  / ntau;

    if round(k) /= k or round(p) /= p;
        errorlog "plotQARDLbands: tau length does not match qaOut";
        end;
    endif;

    // Reshape to (ntau x param)
    _beta  = reshape(_beta,  ntau, k);
    _phi   = reshape(_phi,   ntau, p);
    _gamma = reshape(_gamma, ntau, k);

    // Standard errors from covariance diagonals
    se_beta  = reshape(sqrt(diag(qaOut.bigbt_cov)),  ntau, k);
    se_phi   = reshape(sqrt(diag(qaOut.phi_cov)),    ntau, p);
    se_gamma = reshape(sqrt(diag(qaOut.gamma_cov)),  ntau, k);

    // Pointwise bands
    zcrit = cdfni(1 - alpha/2);
    lb_beta  = _beta  - zcrit * se_beta;
    ub_beta  = _beta  + zcrit * se_beta;
    lb_gamma = _gamma - zcrit * se_gamma;
    ub_gamma = _gamma + zcrit * se_gamma;
    lb_phi   = _phi   - zcrit * se_phi;
    ub_phi   = _phi   + zcrit * se_phi;

    // Set up graph controls
    struct plotControl myPlot;
    myPlot = plotSetQARDLDefaults(p, k);

    // Line styles: dashed | solid | dashed  (lower, estimate, upper)
    plotSetLineStyle(&myPlot, 2|1|2);

    nCols = maxc(p|k);

    plotBetaBandGraphs(_beta, lb_beta, ub_beta, k, p, tau, nCols, myPlot);
    plotGammaBandGraphs(_gamma, lb_gamma, ub_gamma, k, p, tau, nCols, myPlot);
    plotPhiBandGraphs(_phi, lb_phi, ub_phi, k, p, tau, nCols, myPlot);

    plotClearLayout();

endp;

proc (0) = plotBetaBandGraphs(_beta, lb, ub, k, p, tau, nCols, struct plotControl myPlot);
    local vnames, gp_indx;

    gp_indx = 1;
    vnames = "\\beta_" $+ ntos(seqa(1, 1, k));

    for i(1, k, 1);
        plotLayout(3, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames[i]);
        plotXY(myPlot, tau, lb[., i]~_beta[., i]~ub[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (0) = plotGammaBandGraphs(_gamma, lb, ub, k, p, tau, nCols, struct plotControl myPlot);
    local vnames, gp_indx;

    gp_indx = maxc(k|p) + 1;
    vnames = "\\gamma_" $+ ntos(seqa(1, 1, k));

    for i(1, k, 1);
        plotLayout(3, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames[i]);
        plotXY(myPlot, tau, lb[., i]~_gamma[., i]~ub[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (0) = plotPhiBandGraphs(_phi, lb, ub, k, p, tau, nCols, struct plotControl myPlot);
    local vnames, gp_indx;

    gp_indx = 2*maxc(k|p) + 1;
    vnames = "\\phi_{t-" $+ ntos(seqa(1, 1, p)) $+ "}";

    for i(1, p, 1);
        plotLayout(3, nCols, gp_indx);
        plotSetTitle(&myPlot, vnames[i]);
        plotXY(myPlot, tau, lb[., i]~_phi[., i]~ub[., i]);
        gp_indx = gp_indx + 1;
    endfor;
endp;

proc (struct plotControl) = plotSetQARDLDefaults(p, k);
    local _font, title_size, axis_size, label_size;
    
    _font = "Arial";
    title_size = 18 - maxc(k|p);
    axis_size = 16 - maxc(k|p);
    label_size = 14 - maxc(k|p);
    
    struct plotControl myPlot;
    myPlot = plotGetDefaults("xy");
    plotSetTitle(&myPlot, "", _font, title_size);
    
    plotSetTextInterpreter(&myPlot, "LaTex", "all");
    
    plotSetXLabel(&myPlot, "\\tau", _font, axis_size);
    
    plotSetTicLabelFont(&myPlot, _font, label_size);
    
    plotSetYTicCount(&myPlot, 5);
    
    retp(myPlot);
endp;

/*
**> plotRollingQARDLECM
**
**  Purpose:    Plot rolling-window QARDL-ECM estimates.  Produces a 2-row
**              layout: top row shows rho(tau,t); bottom
**              row shows alpha(tau,t) with bands.  One panel per quantile.
**
**  Format:     plotRollingQARDLECM(rECMOut);
**              plotRollingQARDLECM(rECMOut, tau = { 0.25, 0.5, 0.75 });
**              plotRollingQARDLECM(rECMOut, tau, dates, show_bands, alpha);
**
**  Input:      rECMOut     struct rollingQardlECMOut returned by rollingQardlECM().
**              tau         (ss x 1) quantile vector.
**              dates       (num_est x 1) vector of date values for x-axis.
**                          Pass 0 (default) to use window indices 1, 2, ...
**              show_bands  optional scalar, 1 = plot stored confidence bands.
**              alpha       scalar, significance level. Default is 0.05.
**
**  Developed:  April 2026
*/
proc (0) = plotRollingQARDLECM(struct rollingQardlECMOut rECMOut, tau = { 0.25, 0.5, 0.75 }, dates = 0, show_bands = 1, alpha = 0.05);
    local ss, num_est, t_axis, jj;
    local rho_lb, rho_ub, alpha_lb, alpha_ub, zcrit;
    local _font, title_size, axis_size, label_size;
    struct plotControl myPlot;

    call _qardlValidateTau(tau, "plotRollingQARDLECM");
    call _qardlValidatePlotBandInputs(show_bands, alpha, "plotRollingQARDLECM");

    ss      = rows(tau);
    num_est = rows(rECMOut.rho);

    if cols(rECMOut.rho) /= ss or cols(rECMOut.alpha) /= ss;
        errorlog "plotRollingQARDLECM: tau length does not match rolling output";
        end;
    endif;

    // Build time axis
    if scalmiss(dates) or (rows(dates) == 1 and dates == 0);
        t_axis = seqa(1, 1, num_est);
    else;
        if rows(dates) /= num_est;
            errorlog "plotRollingQARDLECM: dates must have one row per rolling estimate";
            end;
        endif;
        t_axis = dates;
    endif;

    zcrit = cdfni(1 - alpha/2);
    rho_lb   = rECMOut.rho   - zcrit * rECMOut.rho_se;
    rho_ub   = rECMOut.rho   + zcrit * rECMOut.rho_se;
    alpha_lb = rECMOut.alpha - zcrit * rECMOut.alpha_se;
    alpha_ub = rECMOut.alpha + zcrit * rECMOut.alpha_se;

    _font      = "Arial";
    title_size = 16 - ss;
    axis_size  = 14 - ss;
    label_size = 12 - ss;

    myPlot = plotGetDefaults("xy");
    plotSetTitle(&myPlot, "", _font, title_size);
    plotSetTextInterpreter(&myPlot, "LaTex", "all");
    plotSetXLabel(&myPlot, "Window", _font, axis_size);
    plotSetTicLabelFont(&myPlot, _font, label_size);
    plotSetYTicCount(&myPlot, 5);
    if show_bands;
        plotSetLineStyle(&myPlot, 2|1|2);
    endif;

    for jj(1, ss, 1);
        plotLayout(2, ss, jj);
        plotSetTitle(&myPlot, "\\rho(" $+ ntos(tau[jj]) $+ ")");
        if show_bands;
            plotXY(myPlot, t_axis, rho_lb[., jj]~rECMOut.rho[., jj]~rho_ub[., jj]);
        else;
            plotXY(myPlot, t_axis, rECMOut.rho[., jj]);
        endif;

        plotLayout(2, ss, ss + jj);
        plotSetTitle(&myPlot, "\\alpha(" $+ ntos(tau[jj]) $+ ")");
        if show_bands;
            plotXY(myPlot, t_axis, alpha_lb[., jj]~rECMOut.alpha[., jj]~alpha_ub[., jj]);
        else;
            plotXY(myPlot, t_axis, rECMOut.alpha[., jj]);
        endif;
    endfor;

    plotClearLayout();
endp;

/*
**> plotRollingQARDL
**
**  Purpose:    Plot rolling-window QARDL long-run beta estimates with optional
**              stored confidence bands.  Produces a grid with ss rows (one per quantile) and k
**              columns (one per x variable).
**
**  Format:     plotRollingQARDL(rqaOut);
**              plotRollingQARDL(rqaOut, tau = { 0.25, 0.5, 0.75 });
**              plotRollingQARDL(rqaOut, tau, dates, show_bands, alpha);
**
**  Input:      rqaOut      struct rollingQardlOut returned by rollingQardl().
**              tau         (ss x 1) quantile vector.
**              dates       (num_est x 1) x-axis values.  Pass 0 for 1..num_est.
**              show_bands  optional scalar, 1 = plot stored confidence bands.
**              alpha       scalar, significance level. Default is 0.05.
**
**  Developed:  April 2026
*/
proc (0) = plotRollingQARDL(struct rollingQardlOut rqaOut, tau = { 0.25, 0.5, 0.75 }, dates = 0, show_bands = 1, alpha = 0.05);
    local ss, num_est, k, t_axis, jj, vv;
    local beta_v, se_v, lb, ub, zcrit;
    local _font, title_size, axis_size, label_size;
    struct plotControl myPlot;

    local _dims;
    call _qardlValidateTau(tau, "plotRollingQARDL");
    call _qardlValidatePlotBandInputs(show_bands, alpha, "plotRollingQARDL");

    ss  = rows(tau);
    _dims   = getorders(rqaOut.bigbt);  // [k, num_est, num_tau]
    k       = _dims[1];
    num_est = _dims[2];

    if _dims[3] /= ss;
        errorlog "plotRollingQARDL: tau length does not match rolling output";
        end;
    endif;

    // Build time axis
    if scalmiss(dates) or (rows(dates) == 1 and dates == 0);
        t_axis = seqa(1, 1, num_est);
    else;
        if rows(dates) /= num_est;
            errorlog "plotRollingQARDL: dates must have one row per rolling estimate";
            end;
        endif;
        t_axis = dates;
    endif;

    _font      = "Arial";
    title_size = 16 - maxc(k|ss);
    axis_size  = 14 - maxc(k|ss);
    label_size = 12 - maxc(k|ss);

    myPlot = plotGetDefaults("xy");
    plotSetTitle(&myPlot, "", _font, title_size);
    plotSetTextInterpreter(&myPlot, "LaTex", "all");
    plotSetXLabel(&myPlot, "Window", _font, axis_size);
    plotSetTicLabelFont(&myPlot, _font, label_size);
    plotSetYTicCount(&myPlot, 5);
    if show_bands;
        plotSetLineStyle(&myPlot, 2|1|2);
    endif;

    zcrit = cdfni(1 - alpha/2);

    // Grid: rows = quantiles, cols = x variables
    for jj(1, ss, 1);
        for vv(1, k, 1);
            // Extract rolling beta and SE for variable vv at quantile jj
            // Arrays indexed [variable, window, quantile]
            beta_v = squeeze(rqaOut.bigbt[vv, ., jj]);
            se_v   = squeeze(rqaOut.bigbt_se[vv, ., jj]);
            lb     = beta_v - zcrit * se_v;
            ub     = beta_v + zcrit * se_v;

            plotLayout(ss, k, (jj-1)*k + vv);
            plotSetTitle(&myPlot, "\\beta_" $+ ntos(vv) $+ "(\\tau=" $+ ntos(tau[jj]) $+ ")");
            if show_bands;
                plotXY(myPlot, t_axis, lb~beta_v~ub);
            else;
                plotXY(myPlot, t_axis, beta_v);
            endif;
        endfor;
    endfor;

    plotClearLayout();
endp;

proc (struct rollingQardlOut) = rollingQardl(data, pend, qend, tau, struct waldTestRestrictions wCtl);
    local window_size, k, T, num_est, num_tau, st, fin_obs, pst, qst,
        beta_array, phi_array, gamma_array, beta_se, gamma_se, phi_se, data_subset,
    wald_beta, pv_beta, wald_gamma, wald_phi, pv_gamma, pv_phi, c_indx, bigR_phi_test;

    // Struct declared once at proc scope (not inside the loop)
    struct qardlOut qaOut;
    struct rollingQardlOut rqaOut;

    call _qardlValidateSearchInputs(data, pend, qend, tau, "rollingQardl");
    
    // qardl order estimation
    // Estimated using full sample
    { pst, qst } = pqorder(data, pend, qend, "bic", 0.1);
    
    // Select window size
    window_size = trunc(0.1*rows(data));
    if window_size <= maxc(pst|qst) + 2;
        errorlog "rollingQardl: rolling window is too short for selected lag orders";
        end;
    endif;
    
    // Dimensions
    k = cols(data) - 1;
    T = rows(data);
    num_est = T-window_size;
    num_tau = rows(tau);

    call _qardlValidateRestrictionShape(wCtl.bigR_beta, wCtl.smlr_beta, k*num_tau, "rollingQardl: beta restrictions");
    call _qardlValidateRestrictionShape(wCtl.bigR_phi, wCtl.smlr_phi, pend*num_tau, "rollingQardl: phi restrictions");
    call _qardlValidateRestrictionShape(wCtl.bigR_gamma, wCtl.smlr_gamma, k*num_tau, "rollingQardl: gamma restrictions");
    
    // Starting indeces for rolling data
    st = 1;
    fin_obs = window_size;
    
    // Initialize storage arrays
    beta_array = arrayinit(k|num_est|num_tau, 0);
    gamma_array = beta_array;
    phi_array = arrayinit(pst|num_est|num_tau, 0);
    
    beta_se = beta_array;
    gamma_se = gamma_array;
    phi_se = phi_array;
    
    // Wald test matrices
    wald_beta = zeros(num_est, 1);
    wald_phi = zeros(num_est, 1 );
    wald_gamma = zeros(num_est, 1);
    pv_beta = zeros(num_est, 1);
    pv_phi = zeros(num_est, 1);
    pv_gamma = zeros(num_est, 1);
    
    do while fin_obs<rows(data);
        
        // Get data subset
        data_subset = data[st:fin_obs, .];
        
        // Parameter estimation
        qaOut = qardl(data_subset, pst, qst, tau, "iid", 0, 0);
        
        // Wald tests
        // Long-run parameter (beta) testing
        { wald_beta[st], pv_beta[st] } = wtestlrb(qaOut.bigbt, qaOut.bigbt_cov, wCtl.bigR_beta, wCtl.smlr_beta, data_subset);
        
        // Short-run parameter (phi) testing
        bigR_phi_test = wCtl.bigR_phi;
        if pst < pend;
            c_indx = seqa(pst*rows(tau)+1, 1, cols(wCtl.bigR_phi)-(pst*rows(tau)));
            bigR_phi_test = delcols(wCtl.bigR_phi, c_indx);
        endif;   
        { wald_phi[st], pv_phi[st] } = wtestsrp(qaOut.phi, qaOut.phi_cov, bigR_phi_test, wCtl.smlr_phi, data_subset);
        
        // Short-run parameter (gamma) testing
        { wald_gamma[st], pv_gamma[st] } = wtestsrg(qaOut.gamma, qaOut.gamma_cov, wCtl.bigR_gamma, wCtl.smlr_gamma, data_subset);
        
        // Extract estimates
        beta_array[., st, .] = _getBetaArray(qaOut.bigbt, num_tau, k);
        gamma_array[., st, .] = _getGammaArray(qaOut.gamma, num_tau, k);
        phi_array[., st, .] = _getPhiArray(qaOut.phi, num_tau, pst);
        
        // Standard errors
        beta_se[., st, .] = _getBetaSE(qaOut.bigbt_cov, num_tau, k);
        gamma_se[., st, .] = _getGammaSE(qaOut.gamma_cov, num_tau, k);
        phi_se[., st, .] = _getPhiSE(qaOut.phi_cov, num_tau, pst);

        st = st + 1;
        fin_obs = fin_obs + 1;
    endo;
    
    // Output structure for results
    rqaOut.bigbt = beta_array;
    rqaOut.bigbt_se = beta_se;
    rqaOut.phi = phi_array;
    rqaOut.phi_se = phi_se;
    rqaOut.gamma = gamma_array;
    rqaOut.gamma_se = gamma_se;
    
    // Wald Test Results
    rqaOut.rWaldOut.wald_gamma = wald_gamma;
    rqaOut.rWaldOut.pv_gamma = pv_gamma;
    rqaOut.rWaldOut.wald_beta = wald_beta;
    rqaOut.rWaldOut.pv_beta = pv_beta;
    rqaOut.rWaldOut.wald_phi = wald_phi;
    rqaOut.rWaldOut.pv_phi = pv_phi;
    
    retp(rqaOut);
endp;

/*
**> rollingQardlECM
**
**  Purpose:    Rolling-window estimation of the QARDL-ECM model.  For each
**              window of length window_size = floor(0.1*T) rows, qardlECM()
**              is called and the resulting alpha(tau), rho(tau) and their
**              asymptotic standard errors are stored.
**
**  Format:     rECMOut = rollingQardlECM(data, ppp, qqq, tau);
**              rECMOut = rollingQardlECM(data, ppp, qqq, tau, ecm_type);
**
**  Input:      data    (T x (1+k)) matrix.
**              ppp     scalar, AR lag order.
**              qqq     scalar, distributed-lag order.
**              tau     (ss x 1) vector of quantile levels.
**              ecm_type string, "two-step" (default) or "uecm".
**
**  Output:     rECMOut     struct rollingQardlECMOut with fields:
**                  .ecm_type   "two-step" or "uecm".
**                  .alpha      (num_est x ss) rolling intercept at each tau.
**                  .rho        (num_est x ss) rolling speed of adjustment.
**                  .alpha_se   (num_est x ss) SE of alpha.
**                  .rho_se     (num_est x ss) SE of rho.
**                  .beta_lr    two-step: (num_est x k) OLS long-run
**                              coefficients; UECM: (num_est x (k*ss))
**                              quantile-specific long-run coefficients
**                              stacked by tau, then regressor.
**                  .rho_ols    (num_est x 1) OLS speed of adjustment.
**
**  Developed:  March 2026
*/
proc (struct rollingQardlECMOut) = rollingQardlECM(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, ecm_type = "two-step");
    local window_size, k, T, num_est, ss, st, fin_obs;
    local alpha_mat, rho_mat, alpha_se_mat, rho_se_mat;
    local beta_lr_mat, rho_ols_vec;
    local data_subset, beta_cols, lr_row, tt, kk;

    // Structs declared once at proc scope (not inside the loop)
    struct qardlECMOut qECMOut;
    struct rollingQardlECMOut rECMOut;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "rollingQardlECM");
    ecm_type = _ardlNormalizeECMType(ecm_type, "rollingQardlECM", 0);

    T          = rows(data);
    k          = cols(data) - 1;
    ss         = rows(tau);
    window_size = trunc(0.1 * T);
    if window_size <= maxc(ppp|qqq) + 2;
        errorlog "rollingQardlECM: rolling window is too short for selected lag orders";
        end;
    endif;
    num_est    = T - window_size;

    // Storage matrices: each row = one estimation window
    alpha_mat    = zeros(num_est, ss);
    rho_mat      = zeros(num_est, ss);
    alpha_se_mat = zeros(num_est, ss);
    rho_se_mat   = zeros(num_est, ss);
    if ecm_type $== "uecm";
        beta_cols = k*ss;
    else;
        beta_cols = k;
    endif;
    beta_lr_mat  = zeros(num_est, beta_cols);
    rho_ols_vec  = zeros(num_est, 1);

    st      = 1;
    fin_obs = window_size;

    do while fin_obs < rows(data);

        data_subset = data[st:fin_obs, .];

        qECMOut = qardlECM(data_subset, ppp, qqq, tau, "iid", 0, 0, ecm_type);

        alpha_mat[st, .]    = qECMOut.alpha';
        rho_mat[st, .]      = qECMOut.rho';
        alpha_se_mat[st, .] = sqrt(diag(qECMOut.alpha_cov))';
        rho_se_mat[st, .]   = sqrt(diag(qECMOut.rho_cov))';
        if ecm_type $== "uecm";
            lr_row = zeros(1, k*ss);
            tt = 1;
            do until tt > ss;
                kk = 1;
                do until kk > k;
                    lr_row[1, (tt-1)*k+kk] = qECMOut.beta_lr[kk, tt];
                    kk = kk + 1;
                endo;
                tt = tt + 1;
            endo;
            beta_lr_mat[st, .]  = lr_row;
        else;
            beta_lr_mat[st, .]  = qECMOut.beta_lr';
        endif;
        rho_ols_vec[st]     = qECMOut.rho_ols[1, 1];

        st      = st + 1;
        fin_obs = fin_obs + 1;
    endo;

    rECMOut.ecm_type = ecm_type;
    rECMOut.alpha    = alpha_mat;
    rECMOut.rho      = rho_mat;
    rECMOut.alpha_se = alpha_se_mat;
    rECMOut.rho_se   = rho_se_mat;
    rECMOut.beta_lr  = beta_lr_mat;
    rECMOut.rho_ols  = rho_ols_vec;

    retp(rECMOut);
endp;

proc (1) = _getBetaSE(_beta_cov, num_tau, k);
    local beta_se, beta_se_array;
    
    // Get  SE
    beta_se = sqrt(diag((_beta_cov)));
    
    // Reshape
    beta_se = reshape(beta_se, num_tau, k);
    
    beta_se_array = arrayinit(k|1|num_tau, 0);
    
    for i(1, k, 1);
        beta_se_array[i, ., .] = beta_se[., i]';
    endfor;
    
    retp(beta_se_array);
endp;

proc (1) = _getGammaSE(_gamma_cov, num_tau, k);
    local gamma_se, gamma_se_array;
    
    // Get  SE
    gamma_se = sqrt(diag((_gamma_cov)));
    
    // Reshape
    gamma_se = reshape(gamma_se, num_tau, k);
    
    gamma_se_array = arrayinit(k|1|num_tau, 0);
    
    for i(1, k, 1);
        gamma_se_array[i, ., .] = gamma_se[., i]';
    endfor;
    
    retp(gamma_se_array);
endp;

proc (1) = _getPhiSE(_phi_cov, num_tau, p);
    local phi_se, phi_se_array;
    
    // Get  SE
    phi_se = sqrt(diag((_phi_cov)));
    
    // Reshape
    phi_se = reshape(phi_se, num_tau, p);
    
    phi_se_array = arrayinit(p|1|num_tau, 0);
    
    for i(1, p, 1);
        phi_se_array[i, ., .] = phi_se[., i]';
    endfor;
    
    retp(phi_se_array);
endp;

proc (1) = _getBetaArray(_beta, num_tau, k);
    local beta_mat, beta_array;
    
    beta_mat = reshape(_beta, num_tau, k);
    
    beta_array = arrayinit(k|1|num_tau, 0);
    
    for i(1, k, 1);
        beta_array[i, ., .] = beta_mat[., i]';
    endfor;
    
    retp(beta_array);
endp;

proc (1) = _getGammaArray(_gamma, num_tau, k);
    local gamma_mat, gamma_array;
    
    gamma_mat = reshape(_gamma, num_tau, k);
    
    gamma_array = arrayinit(k|1|num_tau, 0);
    
    for i(1, k, 1);
        gamma_array[i, ., .] = gamma_mat[., i]';
    endfor;
    
    retp(gamma_array);
endp;

proc (1) = _getPhiArray(_phi, num_tau, p);
    local phi_mat, phi_array;

    phi_mat = reshape(_phi, num_tau, p);

    phi_array = arrayinit(p|1|num_tau, 0);

    for i(1, p, 1);
        phi_array[i, ., .] = phi_mat[., i]';
    endfor;

    retp(phi_array);
endp;

/*
**> printQARDL
**
**  Purpose:    Print a formatted summary table of QARDL estimation results,
**              including parameter estimates, asymptotic standard errors,
**              z-statistics, and two-sided p-values for all parameter sets.
**
**  Format:     printQARDL(qaOut, tau);
**
**  Input:      qaOut   struct, instance of qardlOut returned by qardl().
**
**              tau     (s x 1) vector of quantile levels used in estimation.
**
**  Output:     Prints to screen only. No return value.
**
**  Note:       The printed table has columns [tau, variable, estimate, SE,
**              z-stat, p-value, significance, lower CI, upper CI].
**              Significance codes are *** p < 0.01, ** p < 0.05,
**              and * p < 0.10. P-values use the asymptotic standard normal
**              (z-test) as in qardl_pval().
**
**  Developed:  March 2026
*/

proc (1) = _qardlSignifStars(pval);
    if scalmiss(pval);
        retp("");
    elseif pval < 0.01;
        retp("***");
    elseif pval < 0.05;
        retp("**");
    elseif pval < 0.10;
        retp("*");
    endif;

    retp("");
endp;

proc (1) = _qardlSignifNote();
    retp("Signif. codes: *** p < 0.01, ** p < 0.05, * p < 0.10");
endp;

proc (1) = _qardlAlphaLabel(alpha);
    retp(ftos(100*alpha, "%*.*lf", 1, 0) $+ "%");
endp;

proc (1) = _qardlInterpWidth();
    retp(132);
endp;

proc (1) = _qardlInterpTestWidth();
    retp(22);
endp;

proc (1) = _qardlInterpNullWidth();
    retp(36);
endp;

proc (1) = _qardlInterpOutcomeWidth();
    retp(18);
endp;

proc (1) = _qardlInterpTextWidth();
    retp(50);
endp;

proc (0) = _qardlPrintInterpHeader();
    local width, eq_line, dash_line;

    width = _qardlInterpWidth();
    eq_line = _qardlTableBorder("=", width);
    dash_line = _qardlTableBorder("-", width);

    print eq_line;
    print "Interpretation";
    print eq_line;
    sprintf("%-22s  %-36s  %-18s  %-50s",
            "Test", "Null hypothesis", "Outcome", "Interpretation");
    print dash_line;
endp;

proc (0) = _qardlPrintInterpEnd();
    print _qardlTableBorder("=", _qardlInterpWidth());
endp;

proc (1) = _qardlStringLineCount(s, width);
    local n;

    n = ceil(strlen(s) / width);
    if n < 1;
        n = 1;
    endif;

    retp(n);
endp;

proc (1) = _qardlStringChunk(s, width, line_num);
    local start_pos, nchar;

    start_pos = (line_num - 1)*width + 1;
    if start_pos > strlen(s);
        retp("");
    endif;

    nchar = minc(width|(strlen(s) - start_pos + 1));
    retp(strsect(s, start_pos, nchar));
endp;

proc (0) = _qardlPrintInterpRow(test_name, null_text, outcome, interpretation);
    local wt, wn, wo, wi, nlines, line_num;
    local test_chunk, null_chunk, outcome_chunk, interp_chunk;

    wt = _qardlInterpTestWidth();
    wn = _qardlInterpNullWidth();
    wo = _qardlInterpOutcomeWidth();
    wi = _qardlInterpTextWidth();

    nlines = maxc(_qardlStringLineCount(test_name, wt)|
                  _qardlStringLineCount(null_text, wn)|
                  _qardlStringLineCount(outcome, wo)|
                  _qardlStringLineCount(interpretation, wi));

    line_num = 1;
    do until line_num > nlines;
        test_chunk = _qardlStringChunk(test_name, wt, line_num);
        null_chunk = _qardlStringChunk(null_text, wn, line_num);
        outcome_chunk = _qardlStringChunk(outcome, wo, line_num);
        interp_chunk = _qardlStringChunk(interpretation, wi, line_num);
        sprintf("%-22s  %-36s  %-18s  %-50s",
                test_chunk, null_chunk, outcome_chunk, interp_chunk);
        line_num = line_num + 1;
    endo;
endp;

proc (0) = _qardlPrintDecisionRow(label, pval, null_text, reject_text, fail_text, alpha);
    if scalmiss(pval);
        call _qardlPrintInterpRow(label, null_text, "Missing p-value",
                                  "No p-value is available for this test.");
    elseif pval < alpha;
        call _qardlPrintInterpRow(label, null_text, "Reject", reject_text);
    else;
        call _qardlPrintInterpRow(label, null_text, "Cannot reject", fail_text);
    endif;
endp;

proc (0) = _qardlPrintECMInterpRow(rho, pval, alpha);
    local outcome, interp;

    if scalmiss(pval);
        outcome = "Missing p-value";
        interp = "Adjustment significance cannot be assessed.";
    elseif rho < 0 and pval < alpha;
        outcome = "Reject; rho < 0";
        interp = "Adjustment back toward long-run equilibrium is supported.";
    elseif rho < 0;
        outcome = "Cannot reject; rho < 0";
        interp = "Adjustment has expected sign but is not significant.";
    elseif pval < alpha;
        outcome = "Reject; rho >= 0";
        interp = "Significant coefficient lacks the expected adjustment sign.";
    else;
        outcome = "Cannot reject; rho >= 0";
        interp = "Stable long-run adjustment is not supported.";
    endif;

    call _qardlPrintInterpRow("Error correction", "rho = 0", outcome, interp);
endp;

proc (0) = _qardlPrintECMInterpretation(rho, pval, alpha);
    call _qardlPrintInterpHeader();
    call _qardlPrintECMInterpRow(rho, pval, alpha);
    call _qardlPrintInterpEnd();
endp;

proc (0) = _qardlPrintECMQInterp(rho, pval, tau, alpha);
    local ii, good, nvalid, outcome, interp;

    good = 0;
    nvalid = 0;
    ii = 1;
    do until ii > rows(rho);
        if not scalmiss(pval[ii]);
            nvalid = nvalid + 1;
            if rho[ii] < 0 and pval[ii] < alpha;
                good = good + 1;
            endif;
        endif;
        ii = ii + 1;
    endo;

    if good > 0;
        outcome = "Reject: " $+ ntos(good) $+ "/" $+ ntos(nvalid);
        interp = "Some quantiles support long-run equilibrium adjustment.";
    else;
        outcome = "Reject: 0/" $+ ntos(nvalid);
        interp = "No reported quantile supports stable adjustment.";
    endif;

    call _qardlPrintInterpHeader();
    call _qardlPrintInterpRow("Error correction", "rho(tau) = 0", outcome, interp);
    call _qardlPrintInterpEnd();
endp;

proc (0) = _qardlPrintRejectCountRow(label, pvals, null_text, reject_text, fail_text, alpha);
    local ii, nvalid, nreject, outcome;

    nvalid = 0;
    nreject = 0;
    ii = 1;
    do until ii > rows(pvals);
        if not scalmiss(pvals[ii]);
            nvalid = nvalid + 1;
            if pvals[ii] < alpha;
                nreject = nreject + 1;
            endif;
        endif;
        ii = ii + 1;
    endo;

    outcome = "Reject: " $+ ntos(nreject) $+ "/" $+ ntos(nvalid);
    if nreject > 0;
        call _qardlPrintInterpRow(label, null_text, outcome, reject_text);
    else;
        call _qardlPrintInterpRow(label, null_text, outcome, fail_text);
    endif;
endp;

proc (1) = _qardlTableBorder(ch, width);
    local ii, border;

    border = "";
    ii = 1;
    do until ii > width;
        border = border $+ ch;
        ii = ii + 1;
    endo;

    retp(border);
endp;

proc (0) = printARDL(struct ardlOut arOut);
    local ii, se_beta, se_phi, z_beta, z_phi, pv_beta, pv_phi;
    local header, note, table_width, eq_line, dash_line;

    se_beta = sqrt(diag(arOut.bigbt_cov));
    se_phi = sqrt(diag(arOut.phi_cov));
    z_beta = arOut.bigbt ./ se_beta;
    z_phi = arOut.phi ./ se_phi;
    pv_beta = 2*cdfnc(abs(z_beta));
    pv_phi = 2*cdfnc(abs(z_phi));

    header = "Name                  Coeff.       Std. Err.      z-value       P>|z|    Sig.";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|84|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    print "ARDL Levels Estimator";
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", arOut.nobs,
            "No. regressors:", arOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", arOut.p,
            "DL lags (q):", arOut.q);
    print "Covariance: " $+ arOut.covariance_type;
    print dash_line;
    print header;
    print dash_line;

    ii = 1;
    do until ii > arOut.k;
        sprintf("  beta_x%-7d%16.6f%15.6f%13.6f%12.6f%7s",
                ii, arOut.bigbt[ii], se_beta[ii], z_beta[ii], pv_beta[ii],
                _qardlSignifStars(pv_beta[ii]));
        ii = ii + 1;
    endo;

    ii = 1;
    do until ii > arOut.p;
        sprintf("  phi_l%-8d%16.6f%15.6f%13.6f%12.6f%7s",
                ii, arOut.phi[ii], se_phi[ii], z_phi[ii], pv_phi[ii],
                _qardlSignifStars(pv_phi[ii]));
        ii = ii + 1;
    endo;

    sprintf("  alpha        %16.6f", arOut.alpha);
    sprintf("  rho          %16.6f", arOut.rho);
    print eq_line;
    print note;
endp;

proc (0) = printARDLECM(struct ardlECMOut arECMOut);
    local ii, se_alpha, se_rho, z_alpha, z_rho, pv_alpha, pv_rho;
    local header, note, table_width, eq_line, dash_line;

    se_rho = sqrt(arECMOut.rho_cov);
    z_rho = arECMOut.rho ./ se_rho;
    pv_rho = 2*cdfnc(abs(z_rho));
    if arECMOut.alpha_cov > 0;
        se_alpha = sqrt(arECMOut.alpha_cov);
        z_alpha = arECMOut.alpha ./ se_alpha;
        pv_alpha = 2*cdfnc(abs(z_alpha));
    else;
        se_alpha = 0;
        z_alpha = 0;
        pv_alpha = 1;
    endif;

    header = "Name                  Coeff.       Std. Err.      z-value       P>|z|    Sig.";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|84|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    if arECMOut.ecm_type $== "uecm";
        print "ARDL-ECM Estimator (Unrestricted)";
    else;
        print "ARDL-ECM Estimator (Two-Step)";
    endif;
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", arECMOut.nobs,
            "No. regressors:", arECMOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", arECMOut.p,
            "DL lags (q):", arECMOut.q);
    print "Covariance: " $+ arECMOut.covariance_type;
    print dash_line;

    if arECMOut.ecm_type $== "uecm";
        print "Unrestricted ECM Long-Run Coefficients";
    else;
        print "Step 1 - OLS Long-Run Coefficients";
    endif;
    print dash_line;
    ii = 1;
    do until ii > arECMOut.k;
        sprintf("  beta_lr_x%-4d%16.6f", ii, arECMOut.beta_lr[ii]);
        ii = ii + 1;
    endo;
    sprintf("  rho_OLS      %16.6f", arECMOut.rho_ols[1, 1]);

    print "";
    if arECMOut.ecm_type $== "uecm";
        print "Unrestricted ECM Parameters";
    else;
        print "Step 2 - ECM Parameters";
    endif;
    print dash_line;
    print header;
    print dash_line;
    if arECMOut.alpha_cov > 0;
        sprintf("  alpha        %16.6f%15.6f%13.6f%12.6f%7s",
                arECMOut.alpha, se_alpha, z_alpha, pv_alpha,
                _qardlSignifStars(pv_alpha));
    else;
        sprintf("  alpha        %16.6f%15s%13s%12s%7s",
                arECMOut.alpha, "", "", "", "");
    endif;
    sprintf("  rho          %16.6f%15.6f%13.6f%12.6f%7s",
            arECMOut.rho, se_rho, z_rho, pv_rho,
            _qardlSignifStars(pv_rho));
    print eq_line;
    print note;
    call _qardlPrintECMInterpretation(arECMOut.rho, pv_rho, 0.05);
endp;

proc (0) = printQARDL(struct qardlOut qaOut, tau = { 0.25, 0.5, 0.75 });
    local ss, k, p, jj, ii, idx, level, alpha_ci, zcrit;
    local se_bt, se_phi, se_gam;
    local z_bt, z_phi, z_gam;
    local pv_bt, pv_phi, pv_gam;
    local lb, ub;
    local header, note, table_width, eq_line, dash_line;

    ss = rows(tau);
    k  = rows(qaOut.bigbt) / ss;
    p  = rows(qaOut.phi)   / ss;
    level = 0.95;
    alpha_ci = 1 - level;
    zcrit = cdfni(1 - alpha_ci/2);

    se_bt  = sqrt(diag(qaOut.bigbt_cov));
    se_phi = sqrt(diag(qaOut.phi_cov));
    se_gam = sqrt(diag(qaOut.gamma_cov));

    z_bt  = qaOut.bigbt  ./ se_bt;
    z_phi = qaOut.phi    ./ se_phi;
    z_gam = qaOut.gamma  ./ se_gam;

    pv_bt  = 2 * cdfnc(abs(z_bt));
    pv_phi = 2 * cdfnc(abs(z_phi));
    pv_gam = 2 * cdfnc(abs(z_gam));

    header = "Name                  Coeff.       Std. Err.      z-value       P>|z|    Sig.          lb           ub";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|101|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    print "QARDL Levels Estimator";
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", qaOut.nobs,
            "No. regressors:", qaOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", qaOut.p,
            "DL lags (q):", qaOut.q);
    sprintf("%-26s%12.0f        %-26s%12.4f", "No. quantiles:", ss,
            "CI level:", level);
    print "Covariance: " $+ qaOut.covariance_type;
    print dash_line;
    print header;
    print dash_line;

    jj = 1;
    do until jj > ss;
        sprintf("Tau = %8.4f", tau[jj]);

        ii = 1;
        do until ii > k;
            idx = (jj-1)*k + ii;
            lb = qaOut.bigbt[idx] - zcrit*se_bt[idx];
            ub = qaOut.bigbt[idx] + zcrit*se_bt[idx];
            sprintf("  beta_x%-4d%16.6f%15.6f%13.6f%12.6f%7s%13.6f%13.6f",
                    ii, qaOut.bigbt[idx], se_bt[idx], z_bt[idx], pv_bt[idx],
                    _qardlSignifStars(pv_bt[idx]), lb, ub);
            ii = ii + 1;
        endo;

        ii = 1;
        do until ii > k;
            idx = (jj-1)*k + ii;
            lb = qaOut.gamma[idx] - zcrit*se_gam[idx];
            ub = qaOut.gamma[idx] + zcrit*se_gam[idx];
            sprintf("  gamma_x%-3d%16.6f%15.6f%13.6f%12.6f%7s%13.6f%13.6f",
                    ii, qaOut.gamma[idx], se_gam[idx], z_gam[idx], pv_gam[idx],
                    _qardlSignifStars(pv_gam[idx]), lb, ub);
            ii = ii + 1;
        endo;

        ii = 1;
        do until ii > p;
            idx = (jj-1)*p + ii;
            lb = qaOut.phi[idx] - zcrit*se_phi[idx];
            ub = qaOut.phi[idx] + zcrit*se_phi[idx];
            sprintf("  phi_l%-5d%16.6f%15.6f%13.6f%12.6f%7s%13.6f%13.6f",
                    ii, qaOut.phi[idx], se_phi[idx], z_phi[idx], pv_phi[idx],
                    _qardlSignifStars(pv_phi[idx]), lb, ub);
            ii = ii + 1;
        endo;

        sprintf("  alpha     %16.6f", qaOut.alpha[jj]);
        sprintf("  rho       %16.6f", qaOut.rho[jj]);
        print dash_line;
        jj = jj + 1;
    endo;

    print eq_line;
    print note;

endp;

/*
**> printQARDLECM
**
**  Purpose:    Print a formatted results table for a qardlECMOut instance.
**              Shows OLS long-run coefficients, then quantile-varying alpha(tau)
**              and rho(tau) with asymptotic standard errors, z-statistics,
**              p-values, significance codes, and confidence limits.
**
**  Format:     printQARDLECM(qECMOut);
**              printQARDLECM(qECMOut, tau = { 0.25, 0.5, 0.75 });
**
**  Input:      qECMOut     struct qardlECMOut returned by qardlECM().
**              tau         (ss x 1) vector of quantile levels.
**
**  Developed:  April 2026
*/
proc (0) = printQARDLECM(struct qardlECMOut qECMOut, tau = { 0.25, 0.5, 0.75 });
    local ss, k, jj, kk, level, alpha_ci, zcrit, lb, ub;
    local se_alpha, se_rho;
    local z_alpha, z_rho;
    local pv_alpha, pv_rho;
    local header, note, table_width, eq_line, dash_line;

    ss = rows(tau);
    k  = qECMOut.k;
    level = 0.95;
    alpha_ci = 1 - level;
    zcrit = cdfni(1 - alpha_ci/2);

    se_alpha = sqrt(diag(qECMOut.alpha_cov));
    se_rho   = sqrt(diag(qECMOut.rho_cov));

    z_alpha  = qECMOut.alpha ./ se_alpha;
    z_rho    = qECMOut.rho   ./ se_rho;
    pv_alpha = 2 * cdfnc(abs(z_alpha));
    pv_rho   = 2 * cdfnc(abs(z_rho));

    header = "Name                  Coeff.       Std. Err.      z-value       P>|z|    Sig.          lb           ub";
    note = _qardlSignifNote();
    table_width = maxc(strlen(header)|101|strlen(note));
    eq_line = _qardlTableBorder("=", table_width);
    dash_line = _qardlTableBorder("-", table_width);

    print eq_line;
    if qECMOut.ecm_type $== "uecm";
        print "QARDL-ECM Estimator (Unrestricted)";
    else;
        print "QARDL-ECM Estimator (Two-Step)";
    endif;
    print eq_line;
    sprintf("%-26s%12.0f        %-26s%12.0f", "No. of obs:", qECMOut.nobs,
            "No. regressors:", qECMOut.k);
    sprintf("%-26s%12.0f        %-26s%12.0f", "AR lags (p):", qECMOut.p,
            "DL lags (q):", qECMOut.q);
    print "Covariance: " $+ qECMOut.covariance_type;
    sprintf("%-26s%12.0f        %-26s%12.4f", "No. quantiles:", ss,
            "CI level:", level);
    print dash_line;

    print "";
    if qECMOut.ecm_type $== "uecm";
        print "Unrestricted ECM Long-Run Coefficients";
    else;
        print "Step 1 - OLS Long-Run Coefficients";
    endif;
    print dash_line;
    if qECMOut.ecm_type $== "uecm";
        print "Name                    Tau            Coeff.";
        jj = 1;
        do until jj > ss;
            kk = 1;
            do until kk > k;
                sprintf("  x%-4d           %8.4f      %16.6f",
                        kk, tau[jj], qECMOut.beta_lr[kk, jj]);
                kk = kk + 1;
            endo;
            jj = jj + 1;
        endo;
    else;
        print "Name                  Coeff.";
        jj = 1;
        do until jj > k;
            sprintf("  x%-4d      %16.6f", jj, qECMOut.beta_lr[jj]);
            jj = jj + 1;
        endo;
        sprintf("  rho_OLS   %16.6f", qECMOut.rho_ols[1, 1]);
    endif;

    print "";
    if qECMOut.ecm_type $== "uecm";
        print "Unrestricted ECM Quantile Parameters";
    else;
        print "Step 2 - ECM Quantile Parameters";
    endif;
    print dash_line;
    print header;
    print dash_line;

    jj = 1;
    do until jj > ss;
        sprintf("Tau = %8.4f", tau[jj]);

        lb = qECMOut.alpha[jj] - zcrit*se_alpha[jj];
        ub = qECMOut.alpha[jj] + zcrit*se_alpha[jj];
        sprintf("  alpha     %16.6f%15.6f%13.6f%12.6f%7s%13.6f%13.6f",
                qECMOut.alpha[jj], se_alpha[jj], z_alpha[jj], pv_alpha[jj],
                _qardlSignifStars(pv_alpha[jj]), lb, ub);

        lb = qECMOut.rho[jj] - zcrit*se_rho[jj];
        ub = qECMOut.rho[jj] + zcrit*se_rho[jj];
        sprintf("  rho       %16.6f%15.6f%13.6f%12.6f%7s%13.6f%13.6f",
                qECMOut.rho[jj], se_rho[jj], z_rho[jj], pv_rho[jj],
                _qardlSignifStars(pv_rho[jj]), lb, ub);

        print dash_line;
        jj = jj + 1;
    endo;

    print eq_line;
    print note;
    call _qardlPrintECMQInterp(qECMOut.rho, pv_rho, tau, 0.05);

endp;

proc (1) = _predictARDLLevels(struct ardlOut arOut, data, formula = "");
    local Y, ONEX, theta_start, phi_start;

    data = applyQARDLFormula(data, formula);
    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, arOut.p, arOut.qvec);
    retp(ONEX*arOut.bt);
endp;

proc (1) = _forecastARDLLevels(struct ardlOut arOut, data, h = 1, formula = "", future_x = error(0));
    local yy, xx, xfuture, xall, dxall, yall, out, ii, jj, kk, yhat;
    local dx_count, col_idx, row_idx, xrow, dx_terms, y_lags, qvec;

    call _qardlValidateLagScalar(h, "forecastARDL: h");
    data = applyQARDLFormula(data, formula);
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    qvec = arOut.qvec;
    dx_count = sumc(qvec);
    xfuture = _ardlFutureXOrHoldLast(xx, h, arOut.k, future_x, "forecastARDL");
    xall = xx|xfuture;
    dxall = zeros(rows(xall), arOut.k);
    dxall[2:rows(xall), .] = xall[2:rows(xall), .] - xall[1:rows(xall)-1, .];
    yall = yy|zeros(h, 1);

    out = zeros(h, 1);
    ii = 1;
    do until ii > h;
        row_idx = rows(yy) + ii;
        xrow = ones(1, 1);

        if dx_count > 0;
            dx_terms = zeros(1, dx_count);
            col_idx = 1;
            kk = 1;
            do until kk > arOut.k;
                if qvec[kk] > 0;
                    for jj(0, qvec[kk]-1, 1);
                        dx_terms[1, col_idx] = dxall[row_idx-jj, kk];
                        col_idx = col_idx + 1;
                    endfor;
                endif;
                kk = kk + 1;
            endo;
            xrow = xrow~dx_terms;
        endif;

        y_lags = zeros(1, arOut.p);
        jj = 1;
        do until jj > arOut.p;
            y_lags[1, jj] = yall[row_idx-jj];
            jj = jj + 1;
        endo;

        xrow = xrow~xall[row_idx, .]~y_lags;
        yhat = xrow*arOut.bt;
        out[ii] = yhat;
        yall[row_idx] = yhat;
        ii = ii + 1;
    endo;

    retp(out);
endp;

/*
**> predictQARDL
**
**  Purpose:    Backward-compatible QARDL prediction wrapper.
*/
proc (1) = predictQARDL(struct qardlOut qaOut, data, formula = "");
    retp(_predictQARDLLevels(qaOut, data, formula));
endp;

proc (1) = _predictQARDLLevels(struct qardlOut qaOut, data, formula = "");
    local Y, ONEX, theta_start, phi_start;

    data = applyQARDLFormula(data, formula);
    { Y, ONEX, theta_start, phi_start } = _qardlBuildLevelsDesignX(data, qaOut.p, qaOut.qvec);
    retp(ONEX*qaOut.bt);
endp;

/*
**> forecastQARDL
**
**  Purpose:    Backward-compatible QARDL forecast wrapper.
**
**  TODO: Validate multi-step quantile forecast behavior against external
**        QARDL forecast references before using for publication results.
*/
proc (1) = forecastQARDL(struct qardlOut qaOut, data, h = 1, formula = "", future_x = error(0));
    retp(_forecastQARDLLevels(qaOut, data, h, formula, future_x));
endp;

proc (1) = _forecastQARDLLevels(struct qardlOut qaOut, data, h = 1, formula = "", future_x = error(0));
    local yy, xx, xfuture, xall, dxall, yall, out, ii, jj, kk, ss, yhat;
    local dx_count, col_idx, row_idx, xrow, dx_terms, y_lags, qvec;

    call _qardlValidateLagScalar(h, "forecastQARDL: h");
    data = applyQARDLFormula(data, formula);
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    qvec = qaOut.qvec;
    dx_count = sumc(qvec);
    xfuture = _ardlFutureXOrHoldLast(xx, h, qaOut.k, future_x, "forecastQARDL");
    xall = xx|xfuture;
    dxall = zeros(rows(xall), qaOut.k);
    dxall[2:rows(xall), .] = xall[2:rows(xall), .] - xall[1:rows(xall)-1, .];
    ss = cols(qaOut.bt);

    out = zeros(h, ss);
    ss = 1;
    do until ss > cols(qaOut.bt);
        yall = yy|zeros(h, 1);
        ii = 1;
        do until ii > h;
            row_idx = rows(yy) + ii;
            xrow = ones(1, 1);

            if dx_count > 0;
                dx_terms = zeros(1, dx_count);
                col_idx = 1;
                kk = 1;
                do until kk > qaOut.k;
                    if qvec[kk] > 0;
                        for jj(0, qvec[kk]-1, 1);
                            dx_terms[1, col_idx] = dxall[row_idx-jj, kk];
                            col_idx = col_idx + 1;
                        endfor;
                    endif;
                    kk = kk + 1;
                endo;
                xrow = xrow~dx_terms;
            endif;

            y_lags = zeros(1, qaOut.p);
            jj = 1;
            do until jj > qaOut.p;
                y_lags[1, jj] = yall[row_idx-jj];
                jj = jj + 1;
            endo;

            xrow = xrow~xall[row_idx, .]~y_lags;
            yhat = xrow*qaOut.bt[., ss];
            out[ii, ss] = yhat;
            yall[row_idx] = yhat;
            ii = ii + 1;
        endo;
        ss = ss + 1;
    endo;

    retp(out);
endp;

proc (1) = _ardlFutureXPathProvided(future_x);
    retp(not (rows(future_x) == 1 and cols(future_x) == 1 and scalmiss(future_x)));
endp;

proc (1) = _ardlFutureXOrHoldLast(xx, h, k0, future_x, caller);
    local xfuture;

    if not _ardlFutureXPathProvided(future_x);
        retp(ones(h, 1)*xx[rows(xx), .]);
    endif;

    if rows(future_x) < h or cols(future_x) /= k0;
        errorlog caller $+ ": future_x must have at least h rows and one column per regressor";
        end;
    endif;

    if ismiss(future_x);
        errorlog caller $+ ": future_x contains missing values";
        end;
    endif;

    xfuture = future_x[1:h, .];
    retp(xfuture);
endp;
/*
**> saveQARDLECMResults
**
**  Purpose:    Export QARDL-ECM estimation results to CSV files.
**              Writes OLS long-run coefficients and quantile-varying alpha(tau)
**              and rho(tau) with standard errors, z-statistics, and p-values.
**
**  Format:     saveQARDLECMResults(qECMOut);
**              saveQARDLECMResults(qECMOut, tau = { 0.25, 0.5, 0.75 }, outdir = ".");
**
**  Input:      qECMOut     struct qardlECMOut returned by qardlECM().
**              tau         (ss x 1) vector of quantile levels.
**              outdir      string, output directory.  Default: current directory.
**
**  Output:     Writes two CSV files:
**                  <outdir>/qardl_ecm_lr.csv   (OLS long-run: var_index, beta_lr)
**                  <outdir>/qardl_ecm_qr.csv   (QR ECM: tau, alpha, se_alpha,
**                                               z_alpha, pval_alpha, rho, se_rho,
**                                               z_rho, pval_rho)
**
**  Developed:  April 2026
*/
proc (0) = saveQARDLECMResults(struct qardlECMOut qECMOut, tau = { 0.25, 0.5, 0.75 }, outdir = ".");
    local ss, k, jj, ii, row, sep, fpath;
    local se_alpha, se_rho, z_alpha, z_rho, pv_alpha, pv_rho;
    local out_lr, out_qr;

    call _qardlValidateTau(tau, "saveQARDLECMResults");

    ss = rows(tau);
    k  = qECMOut.k;

    if rows(qECMOut.alpha) /= ss or rows(qECMOut.rho) /= ss;
        errorlog "saveQARDLECMResults: tau length does not match qECMOut";
        end;
    endif;

    // Ensure outdir ends with separator
    if strsect(outdir, strlen(outdir), 1) $/= "/";
        outdir = outdir $+ "/";
    endif;

    fpath  = outdir $+ "qardl_ecm_lr.csv";
    if qECMOut.ecm_type $== "uecm";
        out_lr = zeros(k*ss, 3);
        row = 1;
        jj = 1;
        do until jj > ss;
            ii = 1;
            do until ii > k;
                out_lr[row, .] = tau[jj]~ii~qECMOut.beta_lr[ii, jj];
                row = row + 1;
                ii = ii + 1;
            endo;
            jj = jj + 1;
        endo;
        _saveCSV(out_lr, "tau,var_index,beta_lr", fpath);
    else;
        // OLS long-run CSV: [var_index, beta_lr]
        out_lr = seqa(1, 1, k)~qECMOut.beta_lr;
        _saveCSV(out_lr, "var_index,beta_lr", fpath);
    endif;

    // Quantile ECM CSV: [tau, alpha, se_alpha, z_alpha, pval_alpha, rho, se_rho, z_rho, pval_rho]
    se_alpha = sqrt(diag(qECMOut.alpha_cov));
    se_rho   = sqrt(diag(qECMOut.rho_cov));
    z_alpha  = qECMOut.alpha ./ se_alpha;
    z_rho    = qECMOut.rho   ./ se_rho;
    pv_alpha = 2 * cdfnc(abs(z_alpha));
    pv_rho   = 2 * cdfnc(abs(z_rho));

    out_qr = tau~qECMOut.alpha~se_alpha~z_alpha~pv_alpha~qECMOut.rho~se_rho~z_rho~pv_rho;
    fpath  = outdir $+ "qardl_ecm_qr.csv";
    _saveCSV(out_qr, "tau,alpha,se_alpha,z_alpha,pval_alpha,rho,se_rho,z_rho,pval_rho", fpath);

    print "saveQARDLECMResults: wrote results to " $+ outdir;

endp;

/*
**> saveQARDLResults
**
**  Purpose:    Export QARDL estimation results to CSV files.  One file is
**              written per parameter group (beta, gamma, phi, ecm).  Each
**              file contains columns: tau, param_index, estimate, se, z, pval.
**
**  Format:     saveQARDLResults(qaOut, tau, outdir);
**
**  Input:      qaOut       struct qardlOut returned by qardl().
**
**              tau         (ss x 1) vector of quantile levels.
**
**              outdir      string, output directory path.  A trailing path
**                          separator is added automatically if absent.
**                          Pass "." to write to the current working directory.
**
**  Output:     Writes four CSV files:
**                  <outdir>/qardl_beta.csv
**                  <outdir>/qardl_gamma.csv
**                  <outdir>/qardl_phi.csv
**                  <outdir>/qardl_ecm.csv
**
**  Developed:  March 2026
*/
proc (0) = saveQARDLResults(struct qardlOut qaOut, tau = { 0.25, 0.5, 0.75 }, outdir = ".");
    local ss, k, p;
    local se_beta, se_gamma, se_phi;
    local _beta, _gamma, _phi;
    local z_beta, z_gamma, z_phi;
    local pv_beta, pv_gamma, pv_phi;
    local out_beta, out_gamma, out_phi, out_ecm;
    local jj, ii, row;
    local fpath, sep;

    call _qardlValidateTau(tau, "saveQARDLResults");

    ss = rows(tau);

    _beta  = qaOut.bigbt;
    _gamma = qaOut.gamma;
    _phi   = qaOut.phi;

    k = rows(_beta) / ss;
    p = rows(_phi)  / ss;

    if round(k) /= k or round(p) /= p;
        errorlog "saveQARDLResults: tau length does not match qaOut";
        end;
    endif;

    // Reshape to (ss x param)
    _beta  = reshape(_beta,  ss, k);
    _gamma = reshape(_gamma, ss, k);
    _phi   = reshape(_phi,   ss, p);

    // Standard errors
    se_beta  = reshape(sqrt(diag(qaOut.bigbt_cov)),  ss, k);
    se_gamma = reshape(sqrt(diag(qaOut.gamma_cov)),  ss, k);
    se_phi   = reshape(sqrt(diag(qaOut.phi_cov)),    ss, p);

    // z-statistics and p-values
    z_beta   = _beta  ./ se_beta;
    z_gamma  = _gamma ./ se_gamma;
    z_phi    = _phi   ./ se_phi;

    pv_beta  = 2 * cdfnc(abs(z_beta));
    pv_gamma = 2 * cdfnc(abs(z_gamma));
    pv_phi   = 2 * cdfnc(abs(z_phi));

    // Ensure outdir ends with a separator
    if strsect(outdir, strlen(outdir), 1) $/= "/";
        outdir = outdir $+ "/";
    endif;

    // --- Write beta CSV ---
    // Rows: (tau, param_index, estimate, se, z, pval)
    out_beta = zeros(ss * k, 6);
    row = 1;
    jj = 1;
    do until jj > ss;
        ii = 1;
        do until ii > k;
            out_beta[row, 1] = tau[jj];
            out_beta[row, 2] = ii;
            out_beta[row, 3] = _beta[jj, ii];
            out_beta[row, 4] = se_beta[jj, ii];
            out_beta[row, 5] = z_beta[jj, ii];
            out_beta[row, 6] = pv_beta[jj, ii];
            row = row + 1;
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;
    fpath = outdir $+ "qardl_beta.csv";
    _saveCSV(out_beta, "tau,param_index,estimate,se,z,pval", fpath);

    // --- Write gamma CSV ---
    out_gamma = zeros(ss * k, 6);
    row = 1;
    jj = 1;
    do until jj > ss;
        ii = 1;
        do until ii > k;
            out_gamma[row, 1] = tau[jj];
            out_gamma[row, 2] = ii;
            out_gamma[row, 3] = _gamma[jj, ii];
            out_gamma[row, 4] = se_gamma[jj, ii];
            out_gamma[row, 5] = z_gamma[jj, ii];
            out_gamma[row, 6] = pv_gamma[jj, ii];
            row = row + 1;
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;
    fpath = outdir $+ "qardl_gamma.csv";
    _saveCSV(out_gamma, "tau,param_index,estimate,se,z,pval", fpath);

    // --- Write phi CSV ---
    out_phi = zeros(ss * p, 6);
    row = 1;
    jj = 1;
    do until jj > ss;
        ii = 1;
        do until ii > p;
            out_phi[row, 1] = tau[jj];
            out_phi[row, 2] = ii;
            out_phi[row, 3] = _phi[jj, ii];
            out_phi[row, 4] = se_phi[jj, ii];
            out_phi[row, 5] = z_phi[jj, ii];
            out_phi[row, 6] = pv_phi[jj, ii];
            row = row + 1;
            ii = ii + 1;
        endo;
        jj = jj + 1;
    endo;
    fpath = outdir $+ "qardl_phi.csv";
    _saveCSV(out_phi, "tau,param_index,estimate,se,z,pval", fpath);

    // --- Write ECM CSV (alpha and rho, no SE available in qardlOut) ---
    out_ecm = zeros(ss, 3);
    out_ecm[., 1] = tau;
    out_ecm[., 2] = qaOut.alpha;
    out_ecm[., 3] = qaOut.rho;
    fpath = outdir $+ "qardl_ecm.csv";
    _saveCSV(out_ecm, "tau,alpha,rho", fpath);

    print "saveQARDLResults: wrote results to " $+ outdir;

endp;

// Helper: write numeric matrix with header line to a CSV file
proc (0) = _saveCSV(mat, header, fpath);
    local fid, nr, nc, jj, ii, csv_row, ret;

    fid = fopen(fpath, "w");

    if fid == -1;
        errorlog "saveQARDLResults: could not open " $+ fpath;
        end;
    endif;

    // Write header
    ret = fputs(fid, header $+ "\n");

    // Write data rows
    nr = rows(mat);
    nc = cols(mat);
    jj = 1;
    do until jj > nr;
        csv_row = "";
        ii = 1;
        do until ii > nc;
            if ii > 1;
                csv_row = csv_row $+ ",";
            endif;
            csv_row = csv_row $+ ftos(mat[jj, ii], "%g", 1, 0);
            ii = ii + 1;
        endo;
        ret = fputs(fid, csv_row $+ "\n");
        jj = jj + 1;
    endo;

    ret = close(fid);
endp;

/*
**> blockBootstrapQARDL
**
**  Purpose:    Compute bootstrap confidence intervals for QARDL parameter
**              estimates using the moving-block bootstrap (Kunsch 1989;
**              Liu & Singh 1992).  Resampling blocks of consecutive
**              observations preserves the short-run serial dependence
**              structure of the data.
**
**  Format:     { ci_beta, ci_gamma, ci_phi } =
**                  blockBootstrapQARDL(data, ppp, qqq);
**              { ci_beta, ci_gamma, ci_phi } =
**                  blockBootstrapQARDL(data, ppp, qqq, tau, B, blk_len, alpha);
**              { ci_beta, ci_gamma, ci_phi } =
**                  blockBootstrapQARDL(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 },
**                                      B = 999, blk_len = 0, alpha = 0.05);
**
**  Input:      data        (T x (1+k)) matrix.
**
**              ppp         scalar, AR lag order.
**
**              qqq         scalar, distributed-lag order.
**
**              tau         (ss x 1) vector of quantile levels.
**                          Default: { 0.25, 0.5, 0.75 }.
**
**              B           scalar, number of bootstrap replications.
**                          Default: 999.
**
**              blk_len     scalar, block length.  0 or omitted =>
**                          auto-select floor(T^(1/3)).  Default: 0.
**
**              alpha       scalar, confidence level in (0,1).
**                          Default: 0.05 (95% intervals).
**
**  Output:     ci_beta     (k*ss x 2) matrix.  Each row is one (tau,param)
**                          combination; columns are [lower, upper] bounds.
**
**              ci_gamma    (k*ss x 2) confidence intervals for gamma.
**
**              ci_phi      (p*ss x 2) confidence intervals for phi.
**
**  Remarks:    The bootstrap resamples blocks of length blk_len with
**              replacement and stacks them to form a pseudo-sample of
**              length T.  qardl() is re-estimated on each pseudo-sample.
**              The (alpha/2) and (1-alpha/2) empirical quantiles of the
**              B bootstrap draws are returned as the CI bounds.
**
**              The procedure uses rndu() for random block starts; results
**              are NOT reproducible unless the seed is set by the caller
**              via rndseed.
**
**  Developed:  March 2026
*/
proc (3) = blockBootstrapQARDL(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, B = 999, blk_len = 0, alpha = 0.05);
    retp(blockBootstrapQARDLMethod(data, ppp, qqq, tau, B, blk_len, alpha, "moving"));
endp;

/*
**> blockBootstrapQARDLMethod
**
**  Purpose:    Bootstrap confidence intervals for QARDL parameters with
**              selectable resampling method.
**
**  Input:      method      string: "moving" (default moving-block bootstrap),
**                          "circular" (circular-block bootstrap), or
**                          "stationary" (Politis-Romano stationary bootstrap).
*/
proc (3) = blockBootstrapQARDLMethod(data, ppp, qqq, tau, B, blk_len, alpha, method);
    local T, k0, ss, jj, bbb, idx, boot_data, used_blk_len;
    local dim_beta, dim_phi, dim_gamma;
    local boot_beta, boot_gamma, boot_phi;
    local ci_beta, ci_gamma, ci_phi;
    local q_lo, q_hi;

    struct qardlOut qa_b;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "blockBootstrapQARDLMethod");

    if rows(B) * cols(B) /= 1 or B < 1 or round(B) /= B;
        errorlog "blockBootstrapQARDLMethod: B must be a positive integer";
        end;
    endif;

    if rows(alpha) * cols(alpha) /= 1 or alpha <= 0 or alpha >= 1;
        errorlog "blockBootstrapQARDLMethod: alpha must be a scalar in (0, 1)";
        end;
    endif;

    method = lower(method);
    call _qardlValidateBootstrapMethod(method, "blockBootstrapQARDLMethod");

    T = rows(data);
    k0 = cols(data) - 1;
    ss = rows(tau);
    used_blk_len = _qardlResolvedBlockLength(T, blk_len, "blockBootstrapQARDLMethod");

    dim_beta  = k0 * ss;
    dim_gamma = k0 * ss;
    dim_phi   = ppp * ss;

    boot_beta  = zeros(B, dim_beta);
    boot_gamma = zeros(B, dim_gamma);
    boot_phi   = zeros(B, dim_phi);

    bbb = 1;
    do until bbb > B;
        idx = _qardlBootstrapIndex(T, used_blk_len, method);
        boot_data = data[idx, .];

        qa_b = qardl(boot_data, ppp, qqq, tau, "iid", 0, 0);

        boot_beta[bbb, .]  = qa_b.bigbt';
        boot_gamma[bbb, .] = qa_b.gamma';
        boot_phi[bbb, .]   = qa_b.phi';

        bbb = bbb + 1;
    endo;

    q_lo = alpha / 2;
    q_hi = 1 - q_lo;

    ci_beta  = zeros(dim_beta,  2);
    ci_gamma = zeros(dim_gamma, 2);
    ci_phi   = zeros(dim_phi,   2);

    jj = 1;
    do until jj > dim_beta;
        ci_beta[jj, 1] = quantile(boot_beta[., jj], q_lo);
        ci_beta[jj, 2] = quantile(boot_beta[., jj], q_hi);
        jj = jj + 1;
    endo;

    jj = 1;
    do until jj > dim_gamma;
        ci_gamma[jj, 1] = quantile(boot_gamma[., jj], q_lo);
        ci_gamma[jj, 2] = quantile(boot_gamma[., jj], q_hi);
        jj = jj + 1;
    endo;

    jj = 1;
    do until jj > dim_phi;
        ci_phi[jj, 1] = quantile(boot_phi[., jj], q_lo);
        ci_phi[jj, 2] = quantile(boot_phi[., jj], q_hi);
        jj = jj + 1;
    endo;

    retp(ci_beta, ci_gamma, ci_phi);
endp;

/*
**> blockBootstrapQARDLDiag
**
**  Purpose:    Moving-block bootstrap confidence intervals for QARDL
**              parameters with reproducible seed control and simple run
**              diagnostics.
**
**  Format:     { ci_beta, ci_gamma, ci_phi, boot_diag } =
**                  blockBootstrapQARDLDiag(data, ppp, qqq, tau, B, blk_len,
**                                         alpha, seed);
**
**  Input:      seed        scalar.  If seed > 0, rndseed is set before
**                          drawing bootstrap block starts.  Use 0 to leave
**                          the current GAUSS random state unchanged.
**
**  Output:     boot_diag   (1 x 5) matrix:
**                          [B requested, B completed, B failed, blk_len, seed].
**
**  Remarks:    Rank-deficient bootstrap resamples are skipped before
**              estimation and counted as failed replications. The procedure
**              attempts up to 5*B draws to complete B valid replications.
*/
proc (4) = blockBootstrapQARDLDiag(data, ppp, qqq, tau, B, blk_len, alpha, seed);
    local T, k0, ss, jj, bbb, attempts, max_attempts, failed_reps, completed_reps;
    local n_blks, starts, idx, boot_data, idx_first, idx_last;
    local dim_beta, dim_phi, dim_gamma;
    local boot_beta, boot_gamma, boot_phi;
    local ci_beta, ci_gamma, ci_phi, boot_diag, used_blk_len;
    local q_lo, q_hi;

    struct qardlOut qa_b;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "blockBootstrapQARDLDiag");

    if rows(B) * cols(B) /= 1 or B < 1 or round(B) /= B;
        errorlog "blockBootstrapQARDLDiag: B must be a positive integer";
        end;
    endif;

    if rows(alpha) * cols(alpha) /= 1 or alpha <= 0 or alpha >= 1;
        errorlog "blockBootstrapQARDLDiag: alpha must be a scalar in (0, 1)";
        end;
    endif;

    call _qardlValidateBootstrapSeed(seed, "blockBootstrapQARDLDiag");

    T = rows(data);
    k0 = cols(data) - 1;
    ss = rows(tau);
    used_blk_len = _qardlResolvedBlockLength(T, blk_len, "blockBootstrapQARDLDiag");
    n_blks = ceil(T / used_blk_len);

    dim_beta  = k0 * ss;
    dim_gamma = k0 * ss;
    dim_phi   = ppp * ss;

    boot_beta  = zeros(B, dim_beta);
    boot_gamma = zeros(B, dim_gamma);
    boot_phi   = zeros(B, dim_phi);

    if seed > 0;
        rndseed seed;
    endif;

    completed_reps = 0;
    failed_reps = 0;
    attempts = 0;
    max_attempts = 5*B;

    do until completed_reps >= B or attempts >= max_attempts;
        attempts = attempts + 1;

        starts = ceil(rndu(n_blks, 1) * (T - used_blk_len + 1));

        idx = zeros(n_blks*used_blk_len, 1);
        jj = 1;
        do until jj > n_blks;
            idx_first = (jj-1)*used_blk_len + 1;
            idx_last  = jj*used_blk_len;
            idx[idx_first:idx_last] = seqa(starts[jj], 1, used_blk_len);
            jj = jj + 1;
        endo;
        idx = idx[1:T, .];

        boot_data = data[idx, .];

        if _qardlLevelsDesignOK(boot_data, ppp, qqq);
            qa_b = qardl(boot_data, ppp, qqq, tau, "iid", 0, 0);
            completed_reps = completed_reps + 1;
            boot_beta[completed_reps, .]  = qa_b.bigbt';
            boot_gamma[completed_reps, .] = qa_b.gamma';
            boot_phi[completed_reps, .]   = qa_b.phi';
        else;
            failed_reps = failed_reps + 1;
        endif;
    endo;

    if completed_reps < 1;
        errorlog "blockBootstrapQARDLDiag: no valid bootstrap replications completed";
        end;
    endif;

    if completed_reps < B;
        boot_beta  = boot_beta[1:completed_reps, .];
        boot_gamma = boot_gamma[1:completed_reps, .];
        boot_phi   = boot_phi[1:completed_reps, .];
    endif;

    q_lo = alpha / 2;
    q_hi = 1 - q_lo;

    ci_beta  = zeros(dim_beta,  2);
    ci_gamma = zeros(dim_gamma, 2);
    ci_phi   = zeros(dim_phi,   2);

    jj = 1;
    do until jj > dim_beta;
        ci_beta[jj, 1] = quantile(boot_beta[., jj], q_lo);
        ci_beta[jj, 2] = quantile(boot_beta[., jj], q_hi);
        jj = jj + 1;
    endo;

    jj = 1;
    do until jj > dim_gamma;
        ci_gamma[jj, 1] = quantile(boot_gamma[., jj], q_lo);
        ci_gamma[jj, 2] = quantile(boot_gamma[., jj], q_hi);
        jj = jj + 1;
    endo;

    jj = 1;
    do until jj > dim_phi;
        ci_phi[jj, 1] = quantile(boot_phi[., jj], q_lo);
        ci_phi[jj, 2] = quantile(boot_phi[., jj], q_hi);
        jj = jj + 1;
    endo;

    boot_diag = B~completed_reps~failed_reps~used_blk_len~seed;

    retp(ci_beta, ci_gamma, ci_phi, boot_diag);
endp;

/*
**> blockBootstrapQARDLECM
**
**  Purpose:    Moving-block bootstrap confidence intervals for the QARDL-ECM
**              speed-of-adjustment rho(tau) and intercept alpha(tau).  Uses
**              the same block-resampling scheme as blockBootstrapQARDL.
**
**  Format:     { ci_rho, ci_alpha } = blockBootstrapQARDLECM(data, ppp, qqq);
**              { ci_rho, ci_alpha } = blockBootstrapQARDLECM(data, ppp, qqq,
**                  tau = { 0.25, 0.5, 0.75 }, B = 999, blk_len = 0,
**                  alpha = 0.05, formula = "");
**
**  Input:      data        (T x (1+k)) matrix.
**              ppp         scalar, AR lag order.
**              qqq         scalar, distributed-lag order.
**              tau         (ss x 1) quantile vector.
**              B           scalar, bootstrap replications. Default 999.
**              blk_len     scalar, block length. 0 = floor(T^(1/3)). Default 0.
**              alpha       scalar, confidence level. Default 0.05 (95% CI).
**              formula     string, Wilkinson formula. Default "".
**
**  Output:     ci_rho      (ss x 2) [lower, upper] CI bounds for rho(tau).
**              ci_alpha    (ss x 2) [lower, upper] CI bounds for alpha(tau).
**
**  Developed:  April 2026
*/
proc (2) = blockBootstrapQARDLECM(data, ppp, qqq, tau = { 0.25, 0.5, 0.75 }, B = 999, blk_len = 0, alpha = 0.05);
    retp(blockBootstrapQARDLECMMethod(data, ppp, qqq, tau, B, blk_len, alpha, "moving"));
endp;

/*
**> blockBootstrapQARDLECMMethod
**
**  Purpose:    Bootstrap confidence intervals for QARDL-ECM alpha/rho with
**              selectable resampling method.
**
**  Input:      method      string: "moving", "circular", or "stationary".
*/
proc (2) = blockBootstrapQARDLECMMethod(data, ppp, qqq, tau, B, blk_len, alpha, method);
    local T, ss, jj, bbb, idx, boot_data, used_blk_len;
    local boot_rho, boot_alpha;
    local ci_rho, ci_alpha;
    local q_lo, q_hi;

    struct qardlECMOut qecm_b;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "blockBootstrapQARDLECMMethod");

    if rows(B) * cols(B) /= 1 or B < 1 or round(B) /= B;
        errorlog "blockBootstrapQARDLECMMethod: B must be a positive integer";
        end;
    endif;

    if rows(alpha) * cols(alpha) /= 1 or alpha <= 0 or alpha >= 1;
        errorlog "blockBootstrapQARDLECMMethod: alpha must be a scalar in (0, 1)";
        end;
    endif;

    method = lower(method);
    call _qardlValidateBootstrapMethod(method, "blockBootstrapQARDLECMMethod");

    T = rows(data);
    ss = rows(tau);
    used_blk_len = _qardlResolvedBlockLength(T, blk_len, "blockBootstrapQARDLECMMethod");

    boot_rho   = zeros(B, ss);
    boot_alpha = zeros(B, ss);

    bbb = 1;
    do until bbb > B;
        idx = _qardlBootstrapIndex(T, used_blk_len, method);
        boot_data = data[idx, .];

        qecm_b = qardlECM(boot_data, ppp, qqq, tau, "iid", 0, 0);

        boot_rho[bbb, .]   = qecm_b.rho';
        boot_alpha[bbb, .] = qecm_b.alpha';

        bbb = bbb + 1;
    endo;

    q_lo = alpha / 2;
    q_hi = 1 - q_lo;

    ci_rho   = zeros(ss, 2);
    ci_alpha = zeros(ss, 2);

    jj = 1;
    do until jj > ss;
        ci_rho[jj, 1]   = quantile(boot_rho[., jj], q_lo);
        ci_rho[jj, 2]   = quantile(boot_rho[., jj], q_hi);
        ci_alpha[jj, 1] = quantile(boot_alpha[., jj], q_lo);
        ci_alpha[jj, 2] = quantile(boot_alpha[., jj], q_hi);
        jj = jj + 1;
    endo;

    retp(ci_rho, ci_alpha);
endp;

/*
**> blockBootstrapQARDLECMDiag
**
**  Purpose:    Moving-block bootstrap confidence intervals for QARDL-ECM
**              alpha/rho with reproducible seed control and simple run
**              diagnostics.
**
**  Format:     { ci_rho, ci_alpha, boot_diag } =
**                  blockBootstrapQARDLECMDiag(data, ppp, qqq, tau, B, blk_len,
**                                            alpha, seed);
**
**  Output:     boot_diag   (1 x 5) matrix:
**                          [B requested, B completed, B failed, blk_len, seed].
**
**  Remarks:    Rank-deficient bootstrap resamples are skipped before
**              estimation and counted as failed replications. The procedure
**              attempts up to 5*B draws to complete B valid replications.
*/
proc (3) = blockBootstrapQARDLECMDiag(data, ppp, qqq, tau, B, blk_len, alpha, seed);
    local T, ss, jj, attempts, max_attempts, failed_reps, completed_reps;
    local n_blks, starts, idx, boot_data, idx_first, idx_last;
    local boot_rho, boot_alpha, ci_rho, ci_alpha, boot_diag, used_blk_len;
    local q_lo, q_hi;

    struct qardlECMOut qecm_b;

    call _qardlValidateEstimatorInputs(data, ppp, qqq, tau, "blockBootstrapQARDLECMDiag");

    if rows(B) * cols(B) /= 1 or B < 1 or round(B) /= B;
        errorlog "blockBootstrapQARDLECMDiag: B must be a positive integer";
        end;
    endif;

    if rows(alpha) * cols(alpha) /= 1 or alpha <= 0 or alpha >= 1;
        errorlog "blockBootstrapQARDLECMDiag: alpha must be a scalar in (0, 1)";
        end;
    endif;

    call _qardlValidateBootstrapSeed(seed, "blockBootstrapQARDLECMDiag");

    T = rows(data);
    ss = rows(tau);
    used_blk_len = _qardlResolvedBlockLength(T, blk_len, "blockBootstrapQARDLECMDiag");
    n_blks = ceil(T / used_blk_len);

    boot_rho   = zeros(B, ss);
    boot_alpha = zeros(B, ss);

    if seed > 0;
        rndseed seed;
    endif;

    completed_reps = 0;
    failed_reps = 0;
    attempts = 0;
    max_attempts = 5*B;

    do until completed_reps >= B or attempts >= max_attempts;
        attempts = attempts + 1;

        starts = ceil(rndu(n_blks, 1) * (T - used_blk_len + 1));

        idx = zeros(n_blks*used_blk_len, 1);
        jj = 1;
        do until jj > n_blks;
            idx_first = (jj-1)*used_blk_len + 1;
            idx_last  = jj*used_blk_len;
            idx[idx_first:idx_last] = seqa(starts[jj], 1, used_blk_len);
            jj = jj + 1;
        endo;
        idx = idx[1:T, .];

        boot_data = data[idx, .];

        if _qardlECMDesignOK(boot_data, ppp, qqq);
            qecm_b = qardlECM(boot_data, ppp, qqq, tau, "iid", 0, 0);
            completed_reps = completed_reps + 1;
            boot_rho[completed_reps, .]   = qecm_b.rho';
            boot_alpha[completed_reps, .] = qecm_b.alpha';
        else;
            failed_reps = failed_reps + 1;
        endif;
    endo;

    if completed_reps < 1;
        errorlog "blockBootstrapQARDLECMDiag: no valid bootstrap replications completed";
        end;
    endif;

    if completed_reps < B;
        boot_rho   = boot_rho[1:completed_reps, .];
        boot_alpha = boot_alpha[1:completed_reps, .];
    endif;

    q_lo = alpha / 2;
    q_hi = 1 - q_lo;

    ci_rho   = zeros(ss, 2);
    ci_alpha = zeros(ss, 2);

    jj = 1;
    do until jj > ss;
        ci_rho[jj, 1]   = quantile(boot_rho[., jj], q_lo);
        ci_rho[jj, 2]   = quantile(boot_rho[., jj], q_hi);
        ci_alpha[jj, 1] = quantile(boot_alpha[., jj], q_lo);
        ci_alpha[jj, 2] = quantile(boot_alpha[., jj], q_hi);
        jj = jj + 1;
    endo;

    boot_diag = B~completed_reps~failed_reps~used_blk_len~seed;

    retp(ci_rho, ci_alpha, boot_diag);
endp;

/*
** Internal validation helpers for public QARDL APIs.
*/
proc (0) = _qardlValidateEstimatorInputs(data, ppp, qqq, tau, caller);
    local nn, k0, max_lag, n_eff, n_param;

    if rows(data) < 1 or cols(data) < 2;
        errorlog caller $+ ": data must have at least one dependent variable and one regressor column";
        end;
    endif;

    if ismiss(data);
        errorlog caller $+ ": data contains missing values; clean or align the sample before estimation";
        end;
    endif;

    call _qardlValidateLagScalar(ppp, caller $+ ": p");
    call _qardlValidateLagScalarZero(qqq, caller $+ ": q");
    call _qardlValidateTau(tau, caller);

    nn      = rows(data);
    k0      = cols(data) - 1;
    max_lag = maxc(ppp|qqq);
    n_eff   = nn - max_lag;
    n_param = 1 + qqq*k0 + k0 + ppp;

    if n_eff <= n_param;
        errorlog caller $+ ": not enough observations for the requested lag orders";
        end;
    endif;
endp;

proc (0) = _qardlValidateSearchInputs(data, pend, qend, tau, caller);
    if rows(data) < 1 or cols(data) < 2;
        errorlog caller $+ ": data must have at least one dependent variable and one regressor column";
        end;
    endif;

    if ismiss(data);
        errorlog caller $+ ": data contains missing values; clean or align the sample before estimation";
        end;
    endif;

    call _qardlValidateLagScalar(pend, caller $+ ": pend");
    call _qardlValidateLagScalarZero(qend, caller $+ ": qend");
    call _qardlValidateTau(tau, caller);

    call _qardlValidateEstimatorInputs(data, pend, qend, tau, caller);
endp;

proc (0) = _qardlValidateLagScalar(lag, label);
    if rows(lag) * cols(lag) /= 1 or lag < 1 or round(lag) /= lag;
        errorlog label $+ " must be a positive integer";
        end;
    endif;
endp;

proc (0) = _qardlValidateLagScalarZero(lag, label);
    if rows(lag) * cols(lag) /= 1 or lag < 0 or round(lag) /= lag;
        errorlog label $+ " must be a non-negative integer";
        end;
    endif;
endp;

proc (1) = _qardlNormalizeQVector(qvec, k0, label);
    local qv, ii;

    if rows(qvec) == 1 and cols(qvec) == k0;
        qv = qvec';
    elseif rows(qvec) == k0 and cols(qvec) == 1;
        qv = qvec;
    else;
        errorlog label $+ " must be a k x 1 or 1 x k vector with one lag order per regressor";
        end;
    endif;

    ii = 1;
    do until ii > k0;
        call _qardlValidateLagScalarZero(qv[ii], label $+ "[" $+ ftos(ii, "%g", 1, 0) $+ "]");
        ii = ii + 1;
    endo;

    retp(qv);
endp;

proc (0) = _qardlValidateRestrictionShape(bigR, smr, nparam, caller);
    if rows(bigR) < 1 or cols(bigR) /= nparam;
        errorlog caller $+ ": R must have one column per tested parameter";
        end;
    endif;

    if rows(smr) /= rows(bigR) or cols(smr) /= 1;
        errorlog caller $+ ": r must be a column vector with one row per restriction";
        end;
    endif;
endp;

proc (1) = _qardlConditionNumber(X);
    local U, S, V, sdiag, smax, smin;

    { U, S, V } = svd1(X);
    sdiag = abs(diag(S));
    smax = maxc(sdiag);
    smin = minc(sdiag);

    if smax <= 0 or smin <= 1e-14*smax;
        retp(1e256);
    endif;

    retp(smax/smin);
endp;

proc (0) = _qardlCheckFullColumnRank(X, caller, label);
    local rnk, cond_no;

    if rows(X) <= cols(X);
        errorlog caller $+ ": " $+ label $+ " has too few observations for its regressors";
        end;
    endif;

    rnk = rank(X);
    if rnk < cols(X);
        errorlog caller $+ ": " $+ label $+ " is rank deficient";
        errorlog "  rank = " $+ ftos(rnk, "%g", 1, 0) $+ ", columns = " $+ ftos(cols(X), "%g", 1, 0);
        end;
    endif;

    cond_no = sqrt(_qardlConditionNumber(X'X));
    if cond_no > 1e10;
        print "WARNING (" $+ caller $+ "): " $+ label $+ " is ill-conditioned; condition number = " $+ ftos(cond_no, "%*.*lf", 1, 4);
    endif;
endp;

proc (1) = _qardlSafeInv(X, caller, label);
    local rnk, cond_no;

    if rows(X) /= cols(X);
        errorlog caller $+ ": " $+ label $+ " must be square before inversion";
        end;
    endif;

    rnk = rank(X);
    if rnk < rows(X);
        errorlog caller $+ ": " $+ label $+ " is singular and cannot be inverted";
        errorlog "  rank = " $+ ftos(rnk, "%g", 1, 0) $+ ", order = " $+ ftos(rows(X), "%g", 1, 0);
        end;
    endif;

    cond_no = _qardlConditionNumber(X);
    if cond_no > 1e14;
        errorlog caller $+ ": " $+ label $+ " is too ill-conditioned to invert safely";
        errorlog "  condition number = " $+ ftos(cond_no, "%*.*lf", 1, 4);
        end;
    elseif cond_no > 1e10;
        print "WARNING (" $+ caller $+ "): " $+ label $+ " inversion is ill-conditioned; condition number = " $+ ftos(cond_no, "%*.*lf", 1, 4);
    endif;

    retp(inv(X));
endp;

proc (2) = _qardlWaldInvAndRank(X, caller, label);
    local rnk, cond_no, X_inv;

    if rows(X) /= cols(X);
        errorlog caller $+ ": " $+ label $+ " must be square before Wald inversion";
        end;
    endif;

    rnk = rank(X);
    if rnk < 1;
        errorlog caller $+ ": " $+ label $+ " has zero rank";
        end;
    endif;

    cond_no = _qardlConditionNumber(X);
    if rnk < rows(X);
        print "WARNING (" $+ caller $+ "): " $+ label $+ " is rank deficient; using pseudoinverse and rank-adjusted chi-square degrees of freedom.";
        X_inv = pinv(X);
    elseif cond_no > 1e10;
        print "WARNING (" $+ caller $+ "): " $+ label $+ " is ill-conditioned; using pseudoinverse. condition number = " $+ ftos(cond_no, "%*.*lf", 1, 4);
        X_inv = pinv(X);
    else;
        X_inv = inv(X);
    endif;

    retp(X_inv, rnk);
endp;

proc (0) = _qardlValidateWaldInputs(param, cov, bigR, smr, data, caller);
    if rows(param) < 1 or cols(param) /= 1;
        errorlog caller $+ ": parameter vector must be a non-empty column vector";
        end;
    endif;

    if rows(cov) /= rows(param) or cols(cov) /= rows(param);
        errorlog caller $+ ": covariance matrix must be square and conformable with the parameter vector";
        end;
    endif;

    call _qardlValidateRestrictionShape(bigR, smr, rows(param), caller);

    if rows(data) < 2;
        errorlog caller $+ ": data must contain at least two observations";
        end;
    endif;
endp;

proc (1) = _qardlLevelsDesignOK(data, ppp, qqq);
    local yy, xx, ee, nn, k0, jj;
    local eei, xxi, yyi, X, ONEX;

    nn = rows(data);
    k0 = cols(data) - 1;
    yy = data[., 1];
    xx = data[., 2:cols(data)];

    ee = xx[2:nn, .] - xx[1:(nn-1), .];
    ee = zeros(1, k0)|ee;

    if qqq > 0;
        eei = zeros(nn-qqq, qqq*k0);
        xxi = xx[qqq+1:nn, .];
    else;
        xxi = xx;
    endif;

    if qqq > 0;
        jj = 1;
        do until jj > k0;
            eei[., 1+(jj-1)*qqq:(jj-1)*qqq+qqq] = packr(lagn(ee[., jj], seqa(-qqq, 1, qqq)));
            jj = jj + 1;
        endo;
    endif;

    yyi = packr(lagn(yy, seqa(-ppp+1, 1, ppp)));
    yyi = yyi[1:rows(yyi)-1, .];

    if qqq == 0;
        X = xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    elseif ppp .> qqq;
        X = eei[(rows(eei)+1-rows(yyi)):rows(eei), .]~xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    else;
        X = eei~xxi~yyi[(rows(yyi)+1-rows(xxi)):rows(yyi), .];
    endif;

    ONEX = ones(rows(X), 1)~X;

    retp(rank(ONEX) == cols(ONEX));
endp;

proc (4) = _qardlBuildLevelsDesignX(data, ppp, qvec);
    local yy, xx, ee, nn, k0, qmax, T0, N, Y, X, ONEX;
    local dx_terms, y_lags, ii, jj, col_idx, theta_start, phi_start;

    nn = rows(data);
    k0 = cols(data) - 1;
    yy = data[., 1];
    xx = data[., 2:cols(data)];

    qvec = _qardlNormalizeQVector(qvec, k0, "_qardlBuildLevelsDesignX: qvec");
    qmax = maxc(qvec);
    T0 = maxc(ppp|qmax);
    N = nn - T0;

    if N <= 0;
        errorlog "_qardlBuildLevelsDesignX: insufficient observations for requested lag orders";
        end;
    endif;

    Y = yy[(T0+1):nn];
    ee = xx[2:nn, .] - xx[1:(nn-1), .];
    ee = zeros(1, k0)|ee;

    if sumc(qvec) > 0;
        dx_terms = zeros(N, sumc(qvec));
        col_idx = 1;
        ii = 1;
        do until ii > k0;
            if qvec[ii] > 0;
                for jj(0, qvec[ii]-1, 1);
                    dx_terms[., col_idx] = ee[(T0+1-jj):(nn-jj), ii];
                    col_idx = col_idx + 1;
                endfor;
            endif;
            ii = ii + 1;
        endo;
        X = dx_terms~xx[(T0+1):nn, .];
    else;
        X = xx[(T0+1):nn, .];
    endif;

    y_lags = zeros(N, ppp);
    jj = 1;
    do until jj > ppp;
        y_lags[., jj] = yy[(T0+1-jj):(nn-jj)];
        jj = jj + 1;
    endo;

    X = X~y_lags;
    ONEX = ones(N, 1)~X;
    theta_start = 2 + sumc(qvec);
    phi_start = theta_start + k0;

    retp(Y, ONEX, theta_start, phi_start);
endp;

proc (2) = _ardlOLSCov(X, resid, caller);
    local N, K, sigma2, invXX, cov;

    N = rows(X);
    K = cols(X);
    sigma2 = (resid'*resid) / (N - K);
    invXX = _qardlSafeInv(X'*X, caller, "OLS covariance moment matrix");
    cov = sigma2*invXX;

    retp(cov, sigma2);
endp;

proc (1) = _ardlNormalizeECMType(ecm_type, caller, allow_none);
    ecm_type = lower(ecm_type);

    if ecm_type $== "twostep" or ecm_type $== "two_step" or
       ecm_type $== "restricted" or ecm_type $== "recm";
        ecm_type = "two-step";
    elseif ecm_type $== "unrestricted";
        ecm_type = "uecm";
    endif;

    if allow_none and ecm_type $== "none";
        retp(ecm_type);
    endif;

    if ecm_type $== "two-step" or ecm_type $== "uecm";
        retp(ecm_type);
    endif;

    if allow_none;
        errorlog caller $+ ": ecm_type must be 'none', 'two-step', or 'uecm'";
    else;
        errorlog caller $+ ": ecm_type must be 'two-step' or 'uecm'";
    endif;
    end;
endp;

proc (3) = _ardlAutoCases(data, ppp, qqq, gets_pval, caller);
    local det_coef, det_pv, case_ids;
    struct ardlECMOut ecm5;

    ecm5 = ardlECM(data, ppp, qqq, "", 0, "uecm", 5);
    det_coef = ecm5.bt[1:2];
    det_pv = _ardlDetPValues(ecm5.bt, ecm5.coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);

    retp(case_ids, det_coef, det_pv);
endp;

proc (1) = _ardlDetPValues(bt, coef_cov, det_cols);
    local pv, se, z, ii;

    pv = ones(det_cols, 1);
    ii = 1;
    do until ii > det_cols;
        se = sqrt(coef_cov[ii, ii]);
        if se > 0;
            z = bt[ii] / se;
            pv[ii] = 2*cdfnc(abs(z));
        endif;
        ii = ii + 1;
    endo;

    retp(pv);
endp;

proc (1) = _ardlNormalizeGETSMode(gets_mode, caller);
    gets_mode = lower(gets_mode);

    if gets_mode $== "hierarchical" or gets_mode $== "lag" or
       gets_mode $== "lag-block";
        retp("hierarchical");
    elseif gets_mode $== "sparse" or gets_mode $== "terms" or
           gets_mode $== "term";
        retp("sparse");
    endif;

    errorlog caller $+ ": gets_mode must be 'hierarchical' or 'sparse'";
    end;
endp;

proc (1) = _qardlMaskIndices(mask);
    local idx, ii, jj;

    idx = zeros(sumc(mask .== 1), 1);
    jj = 1;
    ii = 1;
    do until ii > rows(mask);
        if mask[ii] == 1;
            idx[jj] = ii;
            jj = jj + 1;
        endif;
        ii = ii + 1;
    endo;

    retp(idx);
endp;

proc (1) = _qardlDroppedCols(keep);
    local mask;

    mask = keep .== 0;
    if sumc(mask) == 0;
        retp(error(0));
    endif;

    retp(_qardlMaskIndices(mask));
endp;

proc (1) = _ardlSparseGETSLabels(xvars, ppp, qqq);
    local labels, k0, ii, jj;

    k0 = rows(xvars);
    labels = "const" $| "trend" $| "y_lag";

    ii = 1;
    do until ii > k0;
        labels = labels $| ("x_lag_" $+ xvars[ii]);
        ii = ii + 1;
    endo;

    if ppp > 1;
        jj = 1;
        do until jj > ppp-1;
            labels = labels $| ("dy_lag" $+ ntos(jj));
            jj = jj + 1;
        endo;
    endif;

    if qqq > 0;
        ii = 1;
        do until ii > k0;
            jj = 0;
            do until jj > qqq-1;
                labels = labels $| ("dx_" $+ xvars[ii] $+ "_lag" $+ ntos(jj));
                jj = jj + 1;
            endo;
            ii = ii + 1;
        endo;
    endif;

    retp(labels);
endp;

proc (6) = _qardlSparseGETS(Y, X, protect_cols, gets_pval, caller);
    local kx, keep, protect, ii, jj, idx, Xk, bt, fitted, resid;
    local coef_cov, sigma2, se, pv, max_pv, drop_col, active_col;
    local bt_full, cov_full;

    kx = cols(X);
    keep = ones(kx, 1);
    protect = zeros(kx, 1);
    if not scalmiss(protect_cols);
        ii = 1;
        do until ii > rows(protect_cols);
            if protect_cols[ii] >= 1 and protect_cols[ii] <= kx;
                protect[protect_cols[ii]] = 1;
            endif;
            ii = ii + 1;
        endo;
    endif;

    do while 1;
        idx = _qardlMaskIndices(keep);
        Xk = X[., idx];
        call _qardlCheckFullColumnRank(Xk, caller, "sparse GETS design matrix");
        bt = _qardlSafeInv(Xk'*Xk, caller, "sparse GETS moment matrix")*Xk'*Y;
        fitted = Xk*bt;
        resid = Y - fitted;
        { coef_cov, sigma2 } = _ardlOLSCov(Xk, resid, caller);

        max_pv = -1;
        drop_col = 0;
        ii = 1;
        do until ii > rows(idx);
            active_col = idx[ii];
            if protect[active_col] == 0;
                se = sqrt(coef_cov[ii, ii]);
                pv = 1;
                if se > 0;
                    pv = 2*cdfnc(abs(bt[ii] / se));
                endif;
                if pv > max_pv;
                    max_pv = pv;
                    drop_col = active_col;
                endif;
            endif;
            ii = ii + 1;
        endo;

        if drop_col == 0 or max_pv <= gets_pval;
            break;
        endif;

        keep[drop_col] = 0;
    endo;

    bt_full = zeros(kx, 1);
    cov_full = zeros(kx, kx);
    idx = _qardlMaskIndices(keep);
    ii = 1;
    do until ii > rows(idx);
        bt_full[idx[ii]] = bt[ii];
        jj = 1;
        do until jj > rows(idx);
            cov_full[idx[ii], idx[jj]] = coef_cov[ii, jj];
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    retp(keep, bt_full, cov_full, fitted, resid, sigma2);
endp;

proc (9) = _ardlSparseAutoCases(data, ppp, qqq, gets_pval, caller);
    local k0, Y, XU, protect_cols, keep, bt, coef_cov, fitted, resid;
    local sigma2, det_coef, det_pv, case_ids;

    k0 = cols(data) - 1;
    { Y, XU } =
        _ardlBuildECMDesignX(data, ppp, qqq*ones(k0, 1), zeros(k0, 1),
                             "uecm", 5);
    protect_cols = seqa(3, 1, k0 + 1);
    { keep, bt, coef_cov, fitted, resid, sigma2 } =
        _qardlSparseGETS(Y, XU, protect_cols, gets_pval, caller);

    det_coef = bt[1:2];
    det_pv = _ardlDetPValues(bt, coef_cov, 2);
    case_ids = _ardlCaseIDs(det_pv, gets_pval);

    retp(case_ids, det_coef, det_pv, keep, bt, coef_cov, fitted, resid,
         sigma2);
endp;

proc (1) = _ardlCaseIDs(det_pv, gets_pval);
    local keep_const, keep_trend;

    keep_const = det_pv[1] <= gets_pval;
    keep_trend = det_pv[2] <= gets_pval;

    if keep_trend and not keep_const;
        keep_const = 1;
    endif;

    if not keep_const and not keep_trend;
        retp({ 1 });
    elseif keep_const and not keep_trend;
        retp({ 2, 3 });
    endif;

    retp({ 4, 5 });
endp;

proc (1) = _ardlAutoBoundsTable(data, ppp, qqq, case_ids);
    local out, ii, Fstat, tstat, cv, used_case, q_restrict;

    out = zeros(rows(case_ids), 10);
    ii = 1;
    do until ii > rows(case_ids);
        { Fstat, tstat, cv, used_case, q_restrict } =
            ardlboundsCase(data, ppp, qqq, case_ids[ii]);
        out[ii, .] = used_case~Fstat~tstat~q_restrict~
                     cv[1, 1]~cv[1, 2]~cv[2, 1]~cv[2, 2]~
                     cv[3, 1]~cv[3, 2];
        ii = ii + 1;
    endo;

    retp(out);
endp;

proc (0) = _ardlPrintAutoCase(caller, pst, qst, case_ids, det_pv, bounds_table);
    local ii;

    print caller $+ ": GETS-selected p = " $+ ntos(pst) $+ ", q = " $+ ntos(qst);
    print caller $+ ": deterministic-term p-values from Case V UECM";
    sprintf("  %-12s%12.6f", "intercept", det_pv[1]);
    sprintf("  %-12s%12.6f", "trend", det_pv[2]);
    print caller $+ ": admissible PSS case set";
    ii = 1;
    do until ii > rows(case_ids);
        print "  Case " $+ ntos(case_ids[ii]) $+ " - " $+ _ardlDeterministicLabel(case_ids[ii]);
        ii = ii + 1;
    endo;
    print caller $+ ": bounds rows [case, F, t, q_restrict]";
    ii = 1;
    do until ii > rows(bounds_table);
        sprintf("  %4.0f%14.6f%14.6f%10.0f",
                bounds_table[ii, 1], bounds_table[ii, 2],
                bounds_table[ii, 3], bounds_table[ii, 4]);
        ii = ii + 1;
    endo;
    print caller $+ ": interpretation";
    print "  Primary admissible PSS case: Case " $+ ntos(case_ids[1]) $+ " - " $+ _ardlDeterministicLabel(case_ids[1]);
endp;

proc (0) = _ardlValidateCaseID(case_id, caller);
    if rows(case_id) * cols(case_id) /= 1 or round(case_id) /= case_id or
       case_id < 1 or case_id > 5;
        errorlog caller $+ ": case_id must be an integer from 1 through 5";
        end;
    endif;
endp;

proc (0) = _ardlValidateECMCase(ecm_type, case_id, caller);
    // case_id is valid for both two-step and UECM ECM designs.
endp;

proc (1) = _ardlDeterministicColumnCount(case_id);
    if case_id == 1;
        retp(0);
    elseif case_id == 4 or case_id == 5;
        retp(2);
    endif;
    retp(1);
endp;

proc (1) = _ardlDeterministicLabel(case_id);
    if case_id == 1;
        retp("case I: no intercept, no trend");
    elseif case_id == 2;
        retp("case II: restricted intercept, no trend");
    elseif case_id == 3;
        retp("case III: unrestricted intercept, no trend");
    elseif case_id == 4;
        retp("case IV: unrestricted intercept, restricted trend");
    endif;
    retp("case V: unrestricted intercept, unrestricted trend");
endp;

proc (2) = _ardlBuildECMDesignX(data, ppp, qvec, beta_lr, ecm_type,
                                case_id = 3);
    local nn, k0, qmax, T0, N_ecm, yy, xx, Y, ONEX;
    local ec_lag, y_lag, x_lag, dy_lags, dx_lags, ii, jj, col_idx;
    local trend, level_terms;

    nn = rows(data);
    k0 = cols(data) - 1;
    yy = data[., 1];
    xx = data[., 2:cols(data)];
    qvec = _qardlNormalizeQVector(qvec, k0, "_ardlBuildECMDesignX: qvec");
    qmax = maxc(qvec);
    T0 = maxc(ppp|qmax);
    N_ecm = nn - T0 - 1;

    if N_ecm <= 0;
        errorlog "_ardlBuildECMDesignX: insufficient observations for requested lag orders";
        end;
    endif;

    Y = yy[(T0+2):nn] - yy[(T0+1):(nn-1)];
    trend = seqa(T0+2, 1, N_ecm);

    if ecm_type $== "uecm";
        y_lag = yy[(T0+1):(nn-1)];
        x_lag = xx[(T0+1):(nn-1), .];
        level_terms = y_lag~x_lag;
        if case_id == 1;
            ONEX = level_terms;
        elseif case_id == 2 or case_id == 3;
            ONEX = ones(N_ecm, 1)~level_terms;
        else;
            ONEX = ones(N_ecm, 1)~trend~level_terms;
        endif;
    else;
        ec_lag = yy[(T0+1):(nn-1)] - xx[(T0+1):(nn-1), .]*beta_lr;
        if case_id == 1;
            ONEX = ec_lag;
        elseif case_id == 2 or case_id == 3;
            ONEX = ones(N_ecm, 1)~ec_lag;
        else;
            ONEX = ones(N_ecm, 1)~trend~ec_lag;
        endif;
    endif;

    if ppp > 1;
        dy_lags = zeros(N_ecm, ppp-1);
        for jj(1, ppp-1, 1);
            dy_lags[., jj] = yy[(T0+2-jj):(nn-jj)] - yy[(T0+1-jj):(nn-jj-1)];
        endfor;
        ONEX = ONEX~dy_lags;
    endif;

    if sumc(qvec) > 0;
        dx_lags = zeros(N_ecm, sumc(qvec));
        col_idx = 1;
        ii = 1;
        do until ii > k0;
            if qvec[ii] > 0;
                for jj(0, qvec[ii]-1, 1);
                    dx_lags[., col_idx] = xx[(T0+2-jj):(nn-jj), ii] -
                                          xx[(T0+1-jj):(nn-jj-1), ii];
                    col_idx = col_idx + 1;
                endfor;
            endif;
            ii = ii + 1;
        endo;
        ONEX = ONEX~dx_lags;
    endif;

    retp(Y, ONEX);
endp;

proc (1) = _ardlLongRunFromUECM(bt, y_lag_pos, x_lag_start, k0);
    retp(-bt[x_lag_start:x_lag_start+k0-1] ./ bt[y_lag_pos]);
endp;

proc (1) = _ardlUECMLongRunCov(bt, coef_cov, y_lag_pos, x_lag_start, k0);
    local G, jj, rho, theta;

    rho = bt[y_lag_pos];
    G = zeros(k0, rows(bt));
    jj = 1;
    do until jj > k0;
        theta = bt[x_lag_start+jj-1];
        G[jj, y_lag_pos] = theta/(rho^2);
        G[jj, x_lag_start+jj-1] = -1/rho;
        jj = jj + 1;
    endo;

    retp(G*coef_cov*G');
endp;

proc (1) = _ardlLongRunCov(bt, coef_cov, theta_start, phi_start, k0, ppp);
    local G, denom, ii, jj;

    denom = 1 - sumc(bt[phi_start:phi_start+ppp-1]);
    G = zeros(k0, rows(bt));

    ii = 1;
    do until ii > k0;
        G[ii, theta_start+ii-1] = 1 / denom;
        jj = 1;
        do until jj > ppp;
            G[ii, phi_start+jj-1] = bt[theta_start+ii-1] / (denom^2);
            jj = jj + 1;
        endo;
        ii = ii + 1;
    endo;

    retp(G*coef_cov*G');
endp;

proc (1) = _qardlECMDesignOK(data, ppp, qqq);
    local yy, xx, ee, nn, k0, jj, j;
    local eei, xxi, yyi, X_ols, ONEX_ols, bt_ols, beta_lr_ols;
    local N, T0, N_ecm, Y_ecm, ec_lag, ONEX_ecm, dy_lags, dx_ecm;

    if not _qardlLevelsDesignOK(data, ppp, qqq);
        retp(0);
    endif;

    nn = rows(data);
    k0 = cols(data) - 1;
    yy = data[., 1];
    xx = data[., 2:cols(data)];

    ee = xx[2:nn, .] - xx[1:(nn-1), .];
    ee = zeros(1, k0)|ee;

    if qqq > 0;
        eei = zeros(nn-qqq, qqq*k0);
        xxi = xx[qqq+1:nn, .];
    else;
        xxi = xx;
    endif;

    if qqq > 0;
        jj = 1;
        do until jj > k0;
            eei[., 1+(jj-1)*qqq:(jj-1)*qqq+qqq] = packr(lagn(ee[., jj], seqa(-qqq, 1, qqq)));
            jj = jj + 1;
        endo;
    endif;

    yyi = packr(lagn(yy, seqa(-ppp+1, 1, ppp)));
    yyi = yyi[1:rows(yyi)-1, .];

    if qqq == 0;
        X_ols = xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    elseif ppp .> qqq;
        X_ols = eei[(rows(eei)+1-rows(yyi)):rows(eei), .]~xxi[(rows(xxi)+1-rows(yyi)):rows(xxi), .]~yyi;
    else;
        X_ols = eei~xxi~yyi[(rows(yyi)+1-rows(xxi)):rows(yyi), .];
    endif;

    ONEX_ols = ones(rows(X_ols), 1)~X_ols;
    if rank(ONEX_ols) /= cols(ONEX_ols);
        retp(0);
    endif;

    bt_ols = inv(ONEX_ols'ONEX_ols)*ONEX_ols'*yy[(nn-rows(X_ols)+1):nn, 1];
    beta_lr_ols = -bt_ols[(2+qqq*k0):(1+(qqq+1)*k0), 1] /
                  (sumc(bt_ols[(2+(qqq+1)*k0):(1+(qqq+1)*k0+ppp), 1]) - 1);

    T0 = maxc(ppp|qqq);
    N = nn - T0;
    N_ecm = N - 1;

    if N_ecm <= 0;
        retp(0);
    endif;

    Y_ecm = yy[(T0+2):nn] - yy[(T0+1):(nn-1)];
    ec_lag = yy[(T0+1):(nn-1)] - xx[(T0+1):(nn-1), .]*beta_lr_ols;
    ONEX_ecm = ones(N_ecm, 1)~ec_lag;

    if ppp > 1;
        dy_lags = zeros(N_ecm, ppp-1);
        for j(1, ppp-1, 1);
            dy_lags[., j] = yy[(T0+2-j):(nn-j)] - yy[(T0+1-j):(nn-j-1)];
        endfor;
        ONEX_ecm = ONEX_ecm~dy_lags;
    endif;

    if qqq > 0;
        dx_ecm = zeros(N_ecm, qqq*k0);
        jj = 1;
        do until jj > k0;
            for j(0, qqq-1, 1);
                dx_ecm[., (jj-1)*qqq + j + 1] =
                    xx[(T0+2-j):(nn-j), jj] - xx[(T0+1-j):(nn-j-1), jj];
            endfor;
            jj = jj + 1;
        endo;
        ONEX_ecm = ONEX_ecm~dx_ecm;
    endif;

    retp(rank(ONEX_ecm) == cols(ONEX_ecm) and rows(Y_ecm) > cols(ONEX_ecm));
endp;

proc (1) = _qardlQRCovSandwich(ONEX, Y, bt, tau, fh, D_inv, hac_lags);
    local N, K, ss, ii, jj, lag, w;
    local full_cov, resid_i, resid_j, psi_i, psi_j;
    local scores_i, scores_j, S_ij, cov_block, scale_i, scale_j;

    N = rows(ONEX);
    K = cols(ONEX);
    ss = rows(tau);

    full_cov = zeros(K*ss, K*ss);

    jj = 1;
    do until jj > ss;
        resid_j = Y - ONEX*bt[., jj];
        psi_j = tau[jj] - (resid_j .< 0);
        scores_j = ONEX .* (psi_j*ones(1, K));

        ii = 1;
        do until ii > ss;
            resid_i = Y - ONEX*bt[., ii];
            psi_i = tau[ii] - (resid_i .< 0);
            scores_i = ONEX .* (psi_i*ones(1, K));

            S_ij = scores_i'*scores_j / N;

            lag = 1;
            do until lag > hac_lags;
                w = 1 - lag/(hac_lags + 1);
                S_ij = S_ij
                     + w*(scores_i[(lag+1):N, .]'*scores_j[1:(N-lag), .] / N)
                     + w*(scores_i[1:(N-lag), .]'*scores_j[(lag+1):N, .] / N);
                lag = lag + 1;
            endo;

            scale_i = fh[ii];
            scale_j = fh[jj];
            cov_block = D_inv*S_ij*D_inv / (scale_i*scale_j*N);

            full_cov[(ii-1)*K+1:ii*K, (jj-1)*K+1:jj*K] = cov_block;

            ii = ii + 1;
        endo;

        jj = jj + 1;
    endo;

    retp(full_cov);
endp;

proc (3) = _qardlLevelsCovFromFull(full_cov, bt, ppp, qqq, k0, ss);
    local K, theta_start, theta_end, phi_start, phi_end;
    local bigbt_cov, phi_cov, gamma_cov, ii, jj, row_i, row_j;
    local trans_i, trans_j, block_ij, cov_beta_ij, theta_i, den_i;

    K = rows(bt);
    theta_start = 2 + qqq*k0;
    theta_end = 1 + (qqq+1)*k0;
    phi_start = 2 + (qqq+1)*k0;
    phi_end = 1 + (qqq+1)*k0 + ppp;

    bigbt_cov = zeros(k0*ss, k0*ss);
    phi_cov = zeros(ppp*ss, ppp*ss);
    gamma_cov = zeros(k0*ss, k0*ss);

    ii = 1;
    do until ii > ss;
        theta_i = bt[theta_start:theta_end, ii];
        den_i = 1 - sumc(bt[phi_start:phi_end, ii]);

        trans_i = zeros(k0, K);
        trans_i[., theta_start:theta_end] = eye(k0) / den_i;
        trans_i[., phi_start:phi_end] = (theta_i/(den_i^2))*ones(1, ppp);

        jj = 1;
        do until jj > ss;
            theta_i = bt[theta_start:theta_end, jj];
            den_i = 1 - sumc(bt[phi_start:phi_end, jj]);

            trans_j = zeros(k0, K);
            trans_j[., theta_start:theta_end] = eye(k0) / den_i;
            trans_j[., phi_start:phi_end] = (theta_i/(den_i^2))*ones(1, ppp);

            row_i = (ii-1)*K + 1;
            row_j = (jj-1)*K + 1;
            block_ij = full_cov[row_i:row_i+K-1, row_j:row_j+K-1];

            cov_beta_ij = trans_i*block_ij*trans_j';

            bigbt_cov[(ii-1)*k0+1:ii*k0, (jj-1)*k0+1:jj*k0] = cov_beta_ij;
            gamma_cov[(ii-1)*k0+1:ii*k0, (jj-1)*k0+1:jj*k0] =
                block_ij[theta_start:theta_end, theta_start:theta_end];
            phi_cov[(ii-1)*ppp+1:ii*ppp, (jj-1)*ppp+1:jj*ppp] =
                block_ij[phi_start:phi_end, phi_start:phi_end];

            jj = jj + 1;
        endo;

        ii = ii + 1;
    endo;

    retp(bigbt_cov, phi_cov, gamma_cov);
endp;

proc (3) = _qardlLevelsCovFromFullPositions(full_cov, bt, theta_start, phi_start, k0, ppp, ss);
    local K, theta_end, phi_end;
    local bigbt_cov, phi_cov, gamma_cov, ii, jj, row_i, row_j;
    local trans_i, trans_j, block_ij, cov_beta_ij, theta_i, den_i;

    K = rows(bt);
    theta_end = theta_start + k0 - 1;
    phi_end = phi_start + ppp - 1;

    bigbt_cov = zeros(k0*ss, k0*ss);
    phi_cov = zeros(ppp*ss, ppp*ss);
    gamma_cov = zeros(k0*ss, k0*ss);

    ii = 1;
    do until ii > ss;
        theta_i = bt[theta_start:theta_end, ii];
        den_i = 1 - sumc(bt[phi_start:phi_end, ii]);

        trans_i = zeros(k0, K);
        trans_i[., theta_start:theta_end] = eye(k0) / den_i;
        trans_i[., phi_start:phi_end] = (theta_i/(den_i^2))*ones(1, ppp);

        jj = 1;
        do until jj > ss;
            theta_i = bt[theta_start:theta_end, jj];
            den_i = 1 - sumc(bt[phi_start:phi_end, jj]);

            trans_j = zeros(k0, K);
            trans_j[., theta_start:theta_end] = eye(k0) / den_i;
            trans_j[., phi_start:phi_end] = (theta_i/(den_i^2))*ones(1, ppp);

            row_i = (ii-1)*K + 1;
            row_j = (jj-1)*K + 1;
            block_ij = full_cov[row_i:row_i+K-1, row_j:row_j+K-1];

            cov_beta_ij = trans_i*block_ij*trans_j';

            bigbt_cov[(ii-1)*k0+1:ii*k0, (jj-1)*k0+1:jj*k0] = cov_beta_ij;
            gamma_cov[(ii-1)*k0+1:ii*k0, (jj-1)*k0+1:jj*k0] =
                block_ij[theta_start:theta_end, theta_start:theta_end];
            phi_cov[(ii-1)*ppp+1:ii*ppp, (jj-1)*ppp+1:jj*ppp] =
                block_ij[phi_start:phi_end, phi_start:phi_end];

            jj = jj + 1;
        endo;

        ii = ii + 1;
    endo;

    retp(bigbt_cov, phi_cov, gamma_cov);
endp;

proc (2) = _qardlECMCovSandwich(ONEX_ecm, Y_ecm, bt_ecm, tau, fh_ecm, D_inv_ecm, hac_lags);
    local N_ecm, K_ecm, ss, ii, jj, lag, w;
    local alpha_cov, rho_cov, resid_i, resid_j, psi_i, psi_j;
    local scores_i, scores_j, S_ij, cov_block, scale_i, scale_j;

    N_ecm = rows(ONEX_ecm);
    K_ecm = cols(ONEX_ecm);
    ss = rows(tau);

    alpha_cov = zeros(ss, ss);
    rho_cov = zeros(ss, ss);

    jj = 1;
    do until jj > ss;
        resid_j = Y_ecm - ONEX_ecm*bt_ecm[., jj];
        psi_j = tau[jj] - (resid_j .< 0);
        scores_j = ONEX_ecm .* (psi_j*ones(1, K_ecm));

        ii = 1;
        do until ii > ss;
            resid_i = Y_ecm - ONEX_ecm*bt_ecm[., ii];
            psi_i = tau[ii] - (resid_i .< 0);
            scores_i = ONEX_ecm .* (psi_i*ones(1, K_ecm));

            S_ij = scores_i'*scores_j / N_ecm;

            lag = 1;
            do until lag > hac_lags;
                w = 1 - lag/(hac_lags + 1);
                S_ij = S_ij
                     + w*(scores_i[(lag+1):N_ecm, .]'*scores_j[1:(N_ecm-lag), .] / N_ecm)
                     + w*(scores_i[1:(N_ecm-lag), .]'*scores_j[(lag+1):N_ecm, .] / N_ecm);
                lag = lag + 1;
            endo;

            scale_i = fh_ecm[ii];
            scale_j = fh_ecm[jj];
            cov_block = D_inv_ecm*S_ij*D_inv_ecm / (scale_i*scale_j*N_ecm);

            alpha_cov[ii, jj] = cov_block[1, 1];
            rho_cov[ii, jj] = cov_block[2, 2];

            ii = ii + 1;
        endo;

        jj = jj + 1;
    endo;

    retp(alpha_cov, rho_cov);
endp;

proc (1) = _qardlAutomaticHACLags(N_ecm);
    local hac_lags;

    hac_lags = trunc(4*(N_ecm/100)^(2/9));
    if hac_lags < 1;
        hac_lags = 1;
    endif;
    if hac_lags > N_ecm - 1;
        hac_lags = N_ecm - 1;
    endif;

    retp(hac_lags);
endp;

proc (0) = _qardlValidateECMCovType(cov_type, caller);
    if not (cov_type $== "iid" or cov_type $== "robust" or cov_type $== "hac");
        errorlog caller $+ ": cov_type must be \"iid\", \"robust\", or \"hac\"";
        end;
    endif;
endp;

proc (0) = _qardlValidateHACLags(hac_lags, caller);
    if rows(hac_lags) * cols(hac_lags) /= 1 or hac_lags < 0 or round(hac_lags) /= hac_lags;
        errorlog caller $+ ": hac_lags must be a non-negative integer";
        end;
    endif;
endp;

proc (1) = _qardlResolvedBlockLength(T, blk_len, caller);
    local used_blk_len;

    if rows(blk_len) * cols(blk_len) /= 1 or blk_len < 0 or round(blk_len) /= blk_len;
        errorlog caller $+ ": blk_len must be a non-negative integer";
        end;
    endif;

    if blk_len <= 0 or scalmiss(blk_len);
        used_blk_len = trunc(T^(1/3));
        if used_blk_len < 2;
            used_blk_len = 2;
        endif;
    else;
        used_blk_len = blk_len;
    endif;

    retp(used_blk_len);
endp;

proc (1) = _qardlBootstrapIndex(T, blk_len, method);
    local idx, n_blks, starts, jj, kk, idx_first, idx_last;
    local pos, new_start_prob;

    if method $== "stationary";
        idx = zeros(T, 1);
        new_start_prob = 1 / blk_len;
        pos = ceil(rndu(1, 1) * T);
        jj = 1;
        do until jj > T;
            idx[jj] = pos;
            if rndu(1, 1) < new_start_prob;
                pos = ceil(rndu(1, 1) * T);
            else;
                pos = pos + 1;
                if pos > T;
                    pos = 1;
                endif;
            endif;
            jj = jj + 1;
        endo;
        retp(idx);
    endif;

    n_blks = ceil(T / blk_len);
    idx = zeros(n_blks*blk_len, 1);

    if method $== "moving";
        starts = ceil(rndu(n_blks, 1) * (T - blk_len + 1));

        jj = 1;
        do until jj > n_blks;
            idx_first = (jj-1)*blk_len + 1;
            idx_last  = jj*blk_len;
            idx[idx_first:idx_last] = seqa(starts[jj], 1, blk_len);
            jj = jj + 1;
        endo;
    else;
        starts = ceil(rndu(n_blks, 1) * T);

        jj = 1;
        do until jj > n_blks;
            kk = 1;
            do until kk > blk_len;
                idx[(jj-1)*blk_len + kk] = starts[jj] + kk - 1;
                do while idx[(jj-1)*blk_len + kk] > T;
                    idx[(jj-1)*blk_len + kk] = idx[(jj-1)*blk_len + kk] - T;
                endo;
                kk = kk + 1;
            endo;
            jj = jj + 1;
        endo;
    endif;

    retp(idx[1:T, .]);
endp;

proc (0) = _qardlValidateBootstrapMethod(method, caller);
    if not (method $== "moving" or method $== "circular" or method $== "stationary");
        errorlog caller $+ ": method must be \"moving\", \"circular\", or \"stationary\"";
        end;
    endif;
endp;

proc (0) = _qardlValidateBootstrapSeed(seed, caller);
    if rows(seed) * cols(seed) /= 1 or seed < 0 or round(seed) /= seed;
        errorlog caller $+ ": seed must be a non-negative integer";
        end;
    endif;
endp;

proc (0) = _qardlValidateTau(tau, caller);
    local tau_sorted;

    if rows(tau) < 1 or cols(tau) /= 1;
        errorlog caller $+ ": tau must be a non-empty column vector";
        end;
    endif;

    if ismiss(tau);
        errorlog caller $+ ": tau contains missing values";
        end;
    endif;

    if minc(tau) <= 0 or maxc(tau) >= 1;
        errorlog caller $+ ": tau values must lie strictly between 0 and 1";
        end;
    endif;

    if rows(tau) > 1;
        tau_sorted = sortc(tau, 1);
        if minc(tau_sorted[2:rows(tau_sorted)] - tau_sorted[1:rows(tau_sorted)-1]) == 0;
            errorlog caller $+ ": tau values must be unique";
            end;
        endif;
    endif;
endp;

proc (0) = _qardlValidatePlotBandInputs(show_bands, alpha, caller);
    if rows(show_bands) * cols(show_bands) /= 1 or (show_bands /= 0 and show_bands /= 1);
        errorlog caller $+ ": show_bands must be 0 or 1";
        end;
    endif;

    if rows(alpha) * cols(alpha) /= 1 or alpha <= 0 or alpha >= 1;
        errorlog caller $+ ": alpha must be a scalar in (0, 1)";
        end;
    endif;
endp;

/*
**> qardlFull
**
**  Purpose:    Integrated QARDL workflow: lag selection, ARDL bounds test,
**              QARDL levels estimation, and QARDL-ECM estimation in one call.
**              Prints a complete results summary to the screen.
**
**  Format:     qfOut = qardlFull(data);
**              qfOut = qardlFull(data, pend, qend);
**              qfOut = qardlFull(data, pend, qend, tau = { 0.25, 0.5, 0.75 },
**                                formula = "", verbose = 1, criterion = "bic",
**                                cov_type = "iid", hac_lags = 0,
**                                ecm_type = "two-step");
**
**  Input:      data    (T x (1+k)) matrix (or dataframe with formula).
**              pend    scalar, maximum AR lag to search. Default is 8.
**              qend    scalar, maximum DL lag to search. Default is 8.
**              tau     (ss x 1) quantile vector.
**              formula string, Wilkinson formula for column selection.
**
**              verbose scalar, 1 = print summaries, 0 = compute silently.
**
**              criterion string, lag-selection information criterion:
**                       "bic" (default), "aic", "hq", or "hqc".
**
**              cov_type string, covariance estimator passed to qardl() and
**                       qardlECM(): "iid" (default), "robust", or "hac".
**
**              hac_lags scalar, non-negative HAC lag truncation. If cov_type
**                       is "hac" and hac_lags = 0, the automatic bandwidth is
**                       used.
**
**  Output:     qfOut   struct qardlFullOut:
**                  .pst        Selected AR lag order.
**                  .qst        Selected DL lag order.
**                  .ardl_fstat Bounds test F-statistic.
**                  .ardl_cv    (3 x 2) I(0)/I(1) critical values.
**                  .qa         qardlOut (levels estimates).
**                  .ecm        qardlECMOut (ECM two-step estimates).
**
**  Developed:  April 2026
*/
proc (struct qardlFullOut) = qardlFull(data, pend = 8, qend = 8,
                                       tau = { 0.25, 0.5, 0.75 },
                                       formula = "", verbose = 1,
                                       criterion = "bic", cov_type = "iid",
                                       hac_lags = 0, ecm_type = "two-step",
                                       gets_pval = 0.1,
                                       print_diagnostics = -1);
    local pst, qst, fstat, cv, depvar, xvars, print_diag;

    struct qardlFullOut qfOut;
    struct qardlOut qa;
    struct qardlECMOut ecm;

    if rows(verbose) * cols(verbose) /= 1 or (verbose /= 0 and verbose /= 1);
        errorlog "qardlFull: verbose must be 0 or 1";
        end;
    endif;
    if print_diagnostics == -1;
        print_diag = verbose;
    elseif print_diagnostics == 0 or print_diagnostics == 1;
        print_diag = print_diagnostics;
    else;
        errorlog "qardlFull: print_diagnostics must be -1, 0, or 1";
        end;
    endif;

    { depvar, xvars } = _qardlFormulaNames(formula, cols(data) - 1);
    data = _applyFormula(data, formula);
    call _qardlValidateSearchInputs(data, pend, qend, tau, "qardlFull");
    criterion = lower(criterion);
    call _qardlValidateSelectionCriterion(criterion, "qardlFull");
    call _qardlValidateGETSPValue(gets_pval, "qardlFull");
    cov_type = lower(cov_type);
    call _qardlValidateECMCovType(cov_type, "qardlFull");
    call _qardlValidateHACLags(hac_lags, "qardlFull");
    ecm_type = _ardlNormalizeECMType(ecm_type, "qardlFull", 0);

    // Step 1: Lag order selection
    if verbose;
        print "qardlFull: selecting lag orders (" $+ upper(criterion) $+ ") ...";
    endif;
    { pst, qst } = pqorder(data, pend, qend, criterion, gets_pval);
    if verbose;
        sprintf("  %s-selected: p = %d, q = %d", upper(criterion), pst, qst);
    endif;

    // Step 2: ARDL bounds test
    if verbose;
        print "qardlFull: running ARDL bounds test ...";
    endif;
    { fstat, cv } = ardlbounds(data, pst, qst);
    if verbose;
        ardlbounds_print(fstat, cv, cols(data) - 1);
    endif;

    // Step 3: QARDL levels estimation
    if verbose;
        if cov_type $== "iid";
            print "qardlFull: estimating QARDL (levels form) ...";
        else;
            print "qardlFull: estimating QARDL (levels form, " $+ upper(cov_type) $+ " covariance) ...";
        endif;
    endif;
    qa = qardl(data, pst, qst, tau, cov_type, hac_lags, 0);
    qa.formula = formula;
    qa.depvar = depvar;
    qa.xvars = xvars;
    qa.selection_criterion = criterion;
    if verbose;
        printQARDL(qa, tau);
    endif;

    // Step 4: QARDL-ECM estimation
    if verbose;
        if cov_type $== "iid";
            print "qardlFull: estimating QARDL-ECM (" $+ ecm_type $+ ") ...";
        else;
            print "qardlFull: estimating QARDL-ECM (" $+ ecm_type $+ ", " $+ upper(cov_type) $+ " covariance) ...";
        endif;
    endif;
    ecm = qardlECM(data, pst, qst, tau, cov_type, hac_lags, 0, ecm_type);
    ecm.formula = formula;
    ecm.depvar = depvar;
    ecm.xvars = xvars;
    ecm.selection_criterion = criterion;
    if verbose;
        printQARDLECM(ecm, tau);
    endif;

    qfOut.model_family = "QARDL";
    qfOut.formula = formula;
    qfOut.depvar = depvar;
    qfOut.xvars = xvars;
    qfOut.deterministic = "constant";
    qfOut.covariance_type = cov_type;
    qfOut.selection_criterion = criterion;
    qfOut.pmax = pend;
    qfOut.qmax = qend;
    qfOut.sample_start = 1;
    qfOut.sample_end = rows(data);
    qfOut.pst        = pst;
    qfOut.qst        = qst;
    qfOut.tau        = tau;
    qfOut.nobs       = rows(data);
    qfOut.ardl_fstat = fstat;
    qfOut.ardl_cv    = cv;
    qfOut.qa         = qa;
    qfOut.ecm        = ecm;
    qfOut.levels_diag = ardlResidualDiagnostics(qa, 0);
    qfOut.ecm_diag    = ardlResidualDiagnostics(ecm, 0);
    if print_diag;
        call printARDLResidualDiagnostics(qfOut.levels_diag);
        call printARDLResidualDiagnostics(qfOut.ecm_diag);
    endif;

    retp(qfOut);
endp;

/*
**> qardlWald
**
**  Purpose:    Run QARDL Wald tests from user-friendly string restrictions.
**              Restrictions are parsed into R and r matrices and evaluated
**              with the existing QARDL Wald scaling and chi-square p-values.
**
**  Format:     { wt, pv, R, r } = qardlWald(qaOut, family, restrictions, data);
**              { wt, pv, R, r } = qardlWald(qaOut, family, restrictions, data,
**                                           rhs, formula);
**
**  Examples:   { wt, pv, R, r } = qardlWald(qaOut, "beta",
**                      "beta[x1,0.25] = beta[x1,0.50]", data);
**
**              { wt, pv, R, r } = qardlWald(qaOut, "gamma",
**                      "2*gamma[x1,0.25] - gamma[x2,0.25]", data, 0);
*/
proc (4) = qardlWald(struct qardlOut qaOut, family, restrictions, data,
                     rhs = error(0), formula = "");
    local bigR, smr, fam, wt, pv;

    fam = _qardlNormalizeWaldFamily(family);
    { bigR, smr } = qardlRestriction(qaOut, fam, restrictions, rhs, formula);

    if fam $== "beta";
        { wt, pv } = wtestlrb(qaOut.bigbt, qaOut.bigbt_cov, bigR, smr, data);
    elseif fam $== "gamma";
        { wt, pv } = wtestsrg(qaOut.gamma, qaOut.gamma_cov, bigR, smr, data);
    else;
        { wt, pv } = wtestsrp(qaOut.phi, qaOut.phi_cov, bigR, smr, data);
    endif;

    retp(wt, pv, bigR, smr);
endp;

/*
**> qardlRestriction
**
**  Purpose:    Convert QARDL string restrictions into numeric R and r
**              matrices for beta, gamma, or phi Wald tests.
*/
proc (2) = qardlRestriction(struct qardlOut qaOut, family, restrictions,
                            rhs = error(0), formula = "");
    local fam, ss, k0, p, xvars, nparam, nrestr, bigR, smr, ii;
    local restr_i, eq_pos, lhs, rhs_expr, row_l, row_r, const_l, const_r;
    local row_i, const_i, rhs_supplied;

    fam = _qardlNormalizeWaldFamily(family);
    ss = rows(qaOut.tau);
    k0 = qaOut.k;
    p = qaOut.p;
    xvars = _qardlWaldXVars(qaOut, formula, k0);

    if fam $== "beta" or fam $== "gamma";
        nparam = k0 * ss;
    else;
        nparam = p * ss;
    endif;

    nrestr = rows(restrictions);
    if nrestr < 1;
        errorlog "qardlRestriction: restrictions must contain at least one restriction";
        end;
    endif;

    rhs_supplied = not (rows(rhs) == 1 and cols(rhs) == 1 and scalmiss(rhs));
    if rhs_supplied;
        if rows(rhs) == 1 and cols(rhs) == 1 and nrestr > 1;
            rhs = rhs*ones(nrestr, 1);
        elseif rows(rhs) == 1 and cols(rhs) == nrestr;
            rhs = rhs';
        endif;
        if rows(rhs) /= nrestr or cols(rhs) /= 1;
            errorlog "qardlRestriction: rhs must be a scalar, a column vector, or omitted";
            end;
        endif;
    else;
        rhs = zeros(nrestr, 1);
    endif;

    bigR = zeros(nrestr, nparam);
    smr = zeros(nrestr, 1);

    ii = 1;
    do until ii > nrestr;
        restr_i = strtrim(restrictions[ii]);
        eq_pos = strindx(restr_i, "=", 1);

        if eq_pos > 0;
            lhs = strtrim(strsect(restr_i, 1, eq_pos - 1));
            rhs_expr = strtrim(strsect(restr_i, eq_pos + 1, strlen(restr_i)));
            { row_l, const_l } = _qardlParseRestrictionExpr(lhs, fam, qaOut.tau, xvars, k0, p);
            { row_r, const_r } = _qardlParseRestrictionExpr(rhs_expr, fam, qaOut.tau, xvars, k0, p);
            bigR[ii, .] = row_l - row_r;
            smr[ii] = const_r - const_l;
        else;
            { row_i, const_i } = _qardlParseRestrictionExpr(restr_i, fam, qaOut.tau, xvars, k0, p);
            bigR[ii, .] = row_i;
            smr[ii] = rhs[ii] - const_i;
        endif;

        ii = ii + 1;
    endo;

    call _qardlValidateRestrictionShape(bigR, smr, nparam, "qardlRestriction");

    retp(bigR, smr);
endp;

proc (1) = _qardlNormalizeWaldFamily(family);
    family = lower(strtrim(family));

    if family $== "beta" or family $== "longrun" or
       family $== "long-run" or family $== "lr";
        retp("beta");
    elseif family $== "gamma" or family $== "short-run-x" or
           family $== "srx";
        retp("gamma");
    elseif family $== "phi" or family $== "ar" or family $== "short-run-y";
        retp("phi");
    endif;

    errorlog "qardlWald: family must be 'beta', 'gamma', or 'phi'";
    end;
endp;

proc (1) = _qardlWaldXVars(struct qardlOut qaOut, formula, k0);
    local depvar, xvars;

    if strlen(formula) > 0;
        { depvar, xvars } = _qardlFormulaNames(formula, k0);
        retp(xvars);
    endif;

    if rows(qaOut.xvars) == k0;
        retp(qaOut.xvars);
    endif;

    retp(_qardlDefaultXVars(k0));
endp;

proc (2) = _qardlParseRestrictionExpr(expr_txt, fam, tau, xvars, k0, p);
    local cleaned, terms, row, constant, ii, term, sign, star_pos;
    local coeff, ref, parts;

    if fam $== "beta" or fam $== "gamma";
        row = zeros(1, k0 * rows(tau));
    else;
        row = zeros(1, p * rows(tau));
    endif;
    constant = 0;

    cleaned = strtrim(expr_txt);
    if strlen(cleaned) == 0;
        retp(row, constant);
    endif;

    cleaned = strreplace(cleaned, "-", "+-");
    terms = strtrim(strsplit(cleaned, "+"))';

    ii = 1;
    do until ii > rows(terms);
        term = strtrim(terms[ii]);
        if strlen(term) > 0;
            sign = 1;
            if strsect(term, 1, 1) $== "-";
                sign = -1;
                term = strtrim(strsect(term, 2, strlen(term) - 1));
            endif;

            star_pos = strindx(term, "*", 1);
            if star_pos > 0;
                parts = strtrim(strsplit(term, "*"));
                coeff = sign * strtof(parts[1]);
                ref = parts[2];
            else;
                coeff = sign;
                ref = term;
            endif;

            if strindx(ref, "[", 1) > 0;
                row[1, _qardlParamRefIndex(ref, fam, tau, xvars, k0, p)] =
                    row[1, _qardlParamRefIndex(ref, fam, tau, xvars, k0, p)] + coeff;
            else;
                constant = constant + sign * strtof(ref);
            endif;
        endif;
        ii = ii + 1;
    endo;

    retp(row, constant);
endp;

proc (1) = _qardlParamRefIndex(ref, fam, tau, xvars, k0, p);
    local open_pos, close_pos, prefix, args, first_arg, tau_arg;
    local tau_idx, var_idx, lag_idx;

    ref = strtrim(ref);
    open_pos = strindx(ref, "[", 1);
    close_pos = strindx(ref, "]", 1);

    if open_pos == 0 or close_pos == 0 or close_pos <= open_pos;
        errorlog "qardlRestriction: invalid parameter reference: " $+ ref;
        end;
    endif;

    prefix = lower(strtrim(strsect(ref, 1, open_pos - 1)));
    if not (prefix $== fam);
        errorlog "qardlRestriction: parameter reference '" $+ ref $+
                 "' does not match requested family '" $+ fam $+ "'";
        end;
    endif;

    args = strtrim(strsplit(strsect(ref, open_pos + 1, close_pos - open_pos - 1), ","));
    if rows(args) == 1 and cols(args) == 2;
        args = args';
    endif;
    if rows(args) /= 2;
        errorlog "qardlRestriction: parameter references must use [name_or_lag,tau]";
        end;
    endif;

    first_arg = strtrim(args[1]);
    tau_arg = strtrim(args[2]);
    tau_idx = _qardlTauIndex(tau_arg, tau);

    if fam $== "phi";
        lag_idx = round(strtof(first_arg));
        if lag_idx < 1 or lag_idx > p;
            errorlog "qardlRestriction: phi lag index is out of range";
            end;
        endif;
        retp((tau_idx - 1)*p + lag_idx);
    endif;

    var_idx = _qardlXVarIndex(first_arg, xvars, k0);
    retp((tau_idx - 1)*k0 + var_idx);
endp;

proc (1) = _qardlTauIndex(tau_arg, tau);
    local tau_val, idx, best_dist, dist, ii;

    tau_val = strtof(tau_arg);
    if scalmiss(tau_val);
        errorlog "qardlRestriction: tau must be numeric";
        end;
    endif;

    idx = 0;
    best_dist = 1e256;
    ii = 1;
    do until ii > rows(tau);
        dist = abs(tau[ii] - tau_val);
        if dist < best_dist;
            best_dist = dist;
            idx = ii;
        endif;
        ii = ii + 1;
    endo;

    if best_dist > 1e-8;
        errorlog "qardlRestriction: tau " $+ tau_arg $+ " was not estimated in qaOut";
        end;
    endif;

    retp(idx);
endp;

proc (1) = _qardlXVarIndex(var_arg, xvars, k0);
    local idx_num, idx;

    idx_num = strtof(var_arg);
    if not scalmiss(idx_num);
        idx = round(idx_num);
        if idx >= 1 and idx <= k0;
            retp(idx);
        endif;
    endif;

    idx = indsav(lower(strtrim(var_arg)), lower(xvars));
    if rows(idx) == 1;
        retp(idx[1]);
    endif;

    errorlog "qardlRestriction: regressor not found: " $+ var_arg;
    end;
endp;

proc (1) = _qardlDefaultXVars(k0);
    local ii, xvars;

    if k0 <= 0;
        retp("");
    endif;

    xvars = "x1";
    ii = 2;
    do until ii > k0;
        xvars = xvars $| ("x" $+ ftos(ii, "%g", 1, 0));
        ii = ii + 1;
    endo;

    retp(xvars);
endp;

proc (2) = _qardlFormulaNames(formula, k0);
    local tilde_pos, lhs, remaining, xvars, n_x, pos, part;

    if strlen(formula) == 0;
        retp("y", _qardlDefaultXVars(k0));
    endif;

    tilde_pos = strindx(formula, "~", 1);
    if tilde_pos == 0;
        retp("y", _qardlDefaultXVars(k0));
    endif;

    lhs = _qardlCleanFormulaName(strsect(formula, 1, tilde_pos - 1));
    remaining = strtrim(strsect(formula, tilde_pos + 1, strlen(formula)));
    xvars = "";
    n_x = 0;

    do while strlen(remaining) > 0;
        pos = strindx(remaining, "+", 1);
        if pos == 0;
            part = _qardlCleanFormulaName(remaining);
            remaining = "";
        else;
            part = _qardlCleanFormulaName(strsect(remaining, 1, pos - 1));
            remaining = strtrim(strsect(remaining, pos + 1, strlen(remaining)));
        endif;

        if strlen(part) > 0;
            if n_x == 0;
                xvars = part;
            else;
                xvars = xvars $| part;
            endif;
            n_x = n_x + 1;
        endif;
    endo;

    if strlen(lhs) == 0;
        lhs = "y";
    endif;

    if n_x == 0;
        xvars = _qardlDefaultXVars(k0);
    endif;

    retp(lhs, xvars);
endp;

/*
**> applyQARDLFormula
**
**  Purpose:    Preprocess a named-column GAUSS dataframe using a Wilkinson
**              formula string.  Selects and reorders columns so that the
**              dependent variable is in column 1 and the regressors follow.
**              Use this before calling qardl(), qardlECM(), rollingQardl(),
**              or any other procedure that expects data in [y, x1, x2, ...]
**              column order.
**
**  Format:     data = applyQARDLFormula(data, formula);
**
**  Input:      data      GAUSS dataframe with named columns.
**              formula   Wilkinson formula string, e.g. "y ~ x1 + x2".
**
**  Output:     data      Reordered data matrix with y in column 1.
**
**  Example:
**              data = loadd("macro.csv");
**              data = applyQARDLFormula(data, "consumption ~ income + wealth");
**              qaOut = qardl(data, pst, qst);
**
**  Developed:  April 2026
*/
proc (1) = applyQARDLFormula(data, formula);
    retp(_applyFormula(data, formula));
endp;

// Internal helper: apply Wilkinson formula "y ~ x1 + x2" to reorder data as [y, x1, x2, ...]
// Uses native GAUSS string functions — no external library required.
// If formula is empty or data has no column names, returns data unchanged.
proc (1) = _applyFormula(data, formula);
    local tilde_pos, lhs, rhs, xvars, n_x, ii;
    local colnames, y_idx, x_idx, pos, part, remaining;

    if strlen(formula) == 0;
        retp(data);
    endif;

    tilde_pos = strindx(formula, "~", 1);
    if tilde_pos == 0;
        retp(data);
    endif;

    // LHS: y variable name
    lhs = _qardlCleanFormulaName(strsect(formula, 1, tilde_pos - 1));

    // RHS: parse "x1 + x2 + ..." into a string array
    remaining = strtrim(strsect(formula, tilde_pos + 1, strlen(formula)));
    xvars = "";
    n_x   = 0;

    do while strlen(remaining) > 0;
        pos = strindx(remaining, "+", 1);
        if pos == 0;
            part      = _qardlCleanFormulaName(remaining);
            remaining = "";
        else;
            part      = _qardlCleanFormulaName(strsect(remaining, 1, pos - 1));
            remaining = strtrim(strsect(remaining, pos + 1, strlen(remaining)));
        endif;
        if strlen(part) > 0;
            if n_x == 0;
                xvars = part;
            else;
                xvars = xvars $| part;
            endif;
            n_x = n_x + 1;
        endif;
    endo;

    // Case-insensitive column index lookup
    colnames = lower(getcolnames(data));
    y_idx    = indsav(lower(lhs),   colnames);
    x_idx    = indsav(lower(xvars), colnames);

    if rows(y_idx) == 0;
        errorlog "applyQARDLFormula: dependent variable not found: " $+ lhs;
        end;
    endif;

    if rows(x_idx) /= n_x;
        errorlog "applyQARDLFormula: one or more RHS variables were not found";
        end;
    endif;

    data = data[., y_idx | x_idx];

    retp(data);
endp;

proc (1) = _qardlCleanFormulaName(name);
    local cleaned, first_char, last_char, nchar;

    cleaned = strtrim(name);
    nchar = strlen(cleaned);
    if nchar >= 2;
        first_char = strsect(cleaned, 1, 1);
        last_char = strsect(cleaned, nchar, 1);
        if (first_char $== "'" and last_char $== "'") or
           (first_char $== "`" and last_char $== "`");
            cleaned = strsect(cleaned, 2, nchar - 2);
        endif;
    endif;

    retp(strtrim(cleaned));
endp;
